<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | IV Store</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        *{box-sizing:border-box;margin:0;padding:0}
        body{background:#f8fafc;color:#0f172a;font-family:Inter,Arial,sans-serif;overflow-x:hidden}
        .main-content{margin-left:260px;padding:96px 30px 35px;min-height:100vh}
        .page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px}
        .page-head h1{font-size:31px;margin-bottom:6px}.page-head p{color:#64748b;font-size:14px}
        .month-badge{background:#eff6ff;color:#1d4ed8;border:1px solid #dbeafe;border-radius:10px;padding:10px 14px;font-size:13px;font-weight:800;white-space:nowrap}
        .stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px;margin-bottom:24px}
        .stat{background:#fff;border:1px solid #e2e8f0;border-radius:15px;padding:21px;box-shadow:0 5px 18px rgba(15,23,42,.05)}
        .stat-label{color:#64748b;font-size:13px;font-weight:700;margin-bottom:10px}.stat-value{font-size:30px;font-weight:800}.stat small{display:block;margin-top:7px;color:#94a3b8}
        .quick,.panel{background:#fff;border:1px solid #e2e8f0;border-radius:15px;padding:21px;box-shadow:0 5px 18px rgba(15,23,42,.04)}
        .quick{margin-bottom:24px}.section-title{font-size:18px;margin-bottom:15px}.quick-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:11px}
        .quick a{display:flex;align-items:center;justify-content:center;min-height:48px;border-radius:10px;background:#eff6ff;color:#1d4ed8;text-decoration:none;font-size:13px;font-weight:800;border:1px solid #dbeafe}.quick a:hover{background:#dbeafe}
        .history{margin-bottom:24px}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:16px}.panel-head a{color:#2563eb;text-decoration:none;font-size:13px;font-weight:800}
        .history-table{overflow-x:auto}.history-table table{width:100%;min-width:720px;border-collapse:collapse}.history-table th,.history-table td{padding:13px 10px;border-bottom:1px solid #eef2f7;text-align:left;font-size:13px}.history-table th{color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:.04em}.history-table tr.current{background:#eff6ff;font-weight:700}
        .revenue{font-weight:800}.muted{color:#64748b}.empty{text-align:center;color:#64748b;padding:25px 5px}.status{display:inline-flex;padding:5px 9px;border-radius:999px;background:#f1f5f9;font-weight:700;font-size:11px}
        .bar{height:7px;background:#e2e8f0;border-radius:999px;overflow:hidden;min-width:80px}.bar span{display:block;height:100%;background:#2563eb;border-radius:999px}
        @media(max-width:1100px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.quick-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
        @media(max-width:900px){.main-content{margin-left:0;padding:88px 20px 25px}}
        @media(max-width:600px){.main-content{padding:82px 14px 20px}.page-head{flex-direction:column}.page-head h1{font-size:25px}.stats{grid-template-columns:1fr 1fr;gap:10px}.stat{padding:16px}.stat-value{font-size:23px}.quick-grid{grid-template-columns:1fr 1fr}.quick,.panel{padding:15px}.month-badge{width:100%;text-align:center}}
        @media(max-width:390px){.stats,.quick-grid{grid-template-columns:1fr}}
    </style>
</head>
<body>
    <%- include("../../partials/admin/navbar") %>
    <%- include("../../partials/admin/sidebar") %>

    <main class="main-content">
        <div class="page-head">
            <div><h1>Dashboard</h1><p>Monthly store performance. The four top figures automatically reset on the 1st of every month.</p></div>
            <div class="month-badge"><i class="fa-regular fa-calendar"></i> <%= currentMonthLabel %></div>
        </div>

        <section class="stats">
            <div class="stat"><div class="stat-label">Orders This Month</div><div class="stat-value"><%= totalOrders %></div><small><%= pendingOrders %> pending · <%= cancelledOrders %> cancelled</small></div>
            <div class="stat"><div class="stat-label">Products Added</div><div class="stat-value"><%= totalProducts %></div><small>Products created this month</small></div>
            <div class="stat"><div class="stat-label">Categories Added</div><div class="stat-value"><%= totalCategories %></div><small>Categories created this month</small></div>
            <div class="stat"><div class="stat-label">Revenue This Month</div><div class="stat-value">₹<%= Number(totalRevenue).toLocaleString("en-IN") %></div><small>Delivered orders this month</small></div>
        </section>

        <section class="quick">
            <h2 class="section-title">Quick Management</h2>
            <div class="quick-grid">
                <a href="/admin/product">📦 Products</a><a href="/admin/product/add">＋ Add Product</a><a href="/admin/category">🗂 Categories</a><a href="/admin/order">🛒 Orders</a><a href="/admin/user">👥 Users</a>
            </div>
        </section>

        <section class="panel history">
            <div class="panel-head"><div><h2 class="section-title" style="margin-bottom:3px">Monthly History</h2><div class="muted" style="font-size:13px">Previous months stay saved; only the current-month cards reset automatically.</div></div></div>
            <div class="history-table">
                <table>
                    <thead><tr><th>Month</th><th>Orders</th><th>Products</th><th>Categories</th><th>Revenue</th></tr></thead>
                    <tbody>
                        <% monthlyHistory.forEach(item => { %>
                            <tr class="<%= item.key === monthlyHistory[monthlyHistory.length - 1].key ? 'current' : '' %>">
                                <td><%= item.label %></td><td><%= item.orders %></td><td><%= item.products %></td><td><%= item.categories %></td><td class="revenue">₹<%= Number(item.revenue).toLocaleString("en-IN") %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel">
            <div class="panel-head"><h2 class="section-title">Recent Orders</h2><a href="/admin/order">View all orders →</a></div>
            <% if (!recentOrders.length) { %><div class="empty">No orders found.</div><% } else { %>
                <div class="history-table"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Action</th></tr></thead><tbody>
                <% recentOrders.forEach(order => { %><tr><td>#<%= String(order._id).slice(-6).toUpperCase() %></td><td><%= order.userName || order.name || order.email || "Customer" %></td><td>₹<%= Number(order.total || 0).toLocaleString("en-IN") %></td><td><span class="status"><%= order.status || "Pending" %></span></td><td><a href="/admin/order/view/<%= order._id %>" style="color:#2563eb;font-weight:700">View / Update</a></td></tr><% }) %>
                </tbody></table></div>
            <% } %>
        </section>
    </main>
</body>
</html>
