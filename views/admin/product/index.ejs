<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f5f7fb;
            overflow-x: hidden;
        }

        /*==========================
            MAIN CONTENT
        ==========================*/

        .main-content {
            margin-left: 260px;
            margin-top: 70px;
            min-height: 100vh;
            padding: 30px;
        }

        /*==========================
            PAGE HEADER
        ==========================*/

        .page-header {
            background: #fff;
            border-radius: 15px;
            padding: 25px 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .08);
            margin-bottom: 25px;
        }

        .page-header h1 {
            font-size: 32px;
            color: #111827;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #6b7280;
        }

        /*==========================
            TOP BAR
        ==========================*/

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .search-box {
            flex: 1;
            min-width: 260px;
            position: relative;
        }

        .search-box input {
            width: 100%;
            padding: 14px 18px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            outline: none;
            font-size: 15px;
        }

        .search-box input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 6px rgba(37, 99, 235, .2);
        }

        .add-btn {
            background: #2563eb;
            color: #fff;
            text-decoration: none;
            padding: 14px 22px;
            border-radius: 10px;
            font-weight: 600;
            transition: .3s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .add-btn:hover {
            background: #1d4ed8;
        }

        /*==========================
            TABLE
        ==========================*/

        .table-wrapper {
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .08);
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 1200px;
            border-collapse: collapse;
        }

        thead {
            background: #0f172a;
        }

        th {
            color: #fff;
            padding: 18px;
            text-align: center;
        }

        td {
            padding: 16px;
            text-align: center;
            border-bottom: 1px solid #e5e7eb;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        .product-img {
            width: 75px;
            height: 75px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid #ddd;
        }

        .price {
            color: #16a34a;
            font-weight: 700;
        }

        .stock {
            font-weight: 600;
            color: #2563eb;
        }

        .status {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .status.in {
            background: #dcfce7;
            color: #15803d;
        }

        .status.out {
            background: #fee2e2;
            color: #dc2626;
        }

        .edit-btn,
        .delete-btn {
            display: inline-block;
            padding: 9px 16px;
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            transition: .3s;
        }

        .edit-btn {
            background: #10b981;
        }

        .edit-btn:hover {
            background: #059669;
        }

        .delete-btn {
            background: #ef4444;
        }

        .delete-btn:hover {
            background: #dc2626;
        }

        @media(max-width:768px) {

            .main-content {
                margin-left: 0;
                padding: 20px;
            }

            .page-header h1 {
                font-size: 28px;
            }

            .top-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .add-btn {
                justify-content: center;
            }

        }
    </style>

</head>

<body>
    <%- include("../../partials/admin/navbar") %>
        <%- include("../../partials/admin/sidebar") %>
            <div class="main-content">
                <div class="page-header">
                    <h1>Product Management</h1>
                    <p>Manage all products from here.</p>
                </div>
                <div class="top-bar">
                    <a href="/admin/product/add" class="add-btn">
                        <i class="fa-solid fa-plus"></i>
                        Add Product
                    </a>
                </div>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Description</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Edit</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% product.forEach((item,index)=>{ %>
                                <tr>
                                    <td>
                                        <%= index+1 %>
                                    </td>
                                    <td>
                                        <% if(item.images && item.images.length>0){ %>
                                            <img src="<%= item.images[0] %>" class="product-img">
                                            <% }else{ %>
                                                <img src="https://via.placeholder.com/75" class="product-img">
                                                <% } %>
                                    </td>
                                    <td>
                                        <%= item.name %>
                                    </td>
                                    <td class="price">
                                        ₹ <%= item.price %>
                                    </td>
                                    <td>
                                        <%= item.description %>
                                    </td>
                                    <td class="stock">
                                        <%= item.stock %>
                                    </td>
                                    <td>
                                        <% if(item.stock> 0){ %>
                                            <span class="status in">
                                                In Stock
                                            </span>
                                            <% }else{ %>
                                                <span class="status out">
                                                    Out of Stock
                                                </span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <a href="/admin/product/edit/<%= item._id %>" class="edit-btn">
                                            <i class="fa-solid fa-pen"></i>
                                            Edit
                                        </a>
                                    </td>
                                    <td>
                                        <a href="/admin/product/delete/<%= item._id %>" class="delete-btn"
                                            onclick="return confirm('Are you sure you want to delete this product?')">
                                            <i class="fa-solid fa-trash"></i>
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <%- include("../../partials/admin/footer") %>
</body>

</html>