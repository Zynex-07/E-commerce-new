<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>All Products | AAK Clothing</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"><style>
*{box-sizing:border-box;margin:0;padding:0}body{font-family:Inter,Poppins,Arial,sans-serif;background:#f4f6f8;color:#0f172a;overflow-x:hidden}.main-content{margin-left:260px;margin-top:70px;min-height:calc(100vh - 70px);padding:30px}.page-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:20px}.page-head h1{font-size:32px;font-weight:800}.page-head p{color:#64748b;font-size:14px;margin-top:5px}.add-btn{display:inline-flex;align-items:center;gap:8px;background:#ff7a00;color:#fff;text-decoration:none;padding:13px 20px;border-radius:10px;font-size:14px;font-weight:800}.toolbar{background:#fff;border:1px solid #e6e9ee;border-radius:15px;padding:16px;display:flex;gap:12px;align-items:center;margin-bottom:18px;box-shadow:0 5px 20px rgba(15,23,42,.04)}.search{flex:1;position:relative}.search i{position:absolute;left:14px;top:13px;color:#94a3b8}.search input,.sort{width:100%;height:44px;border:1px solid #e2e8f0;border-radius:10px;padding:0 14px 0 40px;background:#f8fafc;outline:none;font-size:14px}.sort{width:160px;padding-left:12px}.content-grid{display:grid;grid-template-columns:220px 1fr;gap:18px}.filters,.products-wrap{background:#fff;border:1px solid #e6e9ee;border-radius:15px;box-shadow:0 5px 20px rgba(15,23,42,.04)}.filters{padding:18px;height:max-content}.filters h3{font-size:16px;margin-bottom:15px}.filter-title{font-size:11px;text-transform:uppercase;color:#64748b;font-weight:800;margin:18px 0 9px}.check{display:flex;gap:8px;align-items:center;font-size:13px;color:#475569;margin:10px 0}.check input{accent-color:#ff7a00}.rating{color:#f59e0b;letter-spacing:1px}.price-fields{display:grid;grid-template-columns:1fr 1fr;gap:6px}.price-fields input{width:100%;height:34px;border:1px solid #e2e8f0;border-radius:7px;padding:0 7px;font-size:11px}.reset{width:100%;height:36px;margin-top:12px;border:1px solid #fdba74;background:#fff7ed;color:#c2410c;border-radius:8px;font-weight:800;cursor:pointer}.products-wrap{padding:18px}.grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;align-items:stretch}.card{position:relative;display:flex;flex-direction:column;min-width:0;border:1px solid #e8ebef;border-radius:14px;overflow:hidden;background:#fff;transition:.2s}.card.is-hidden{display:none!important}.card:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(15,23,42,.08)}.heart{position:absolute;right:10px;top:10px;width:34px;height:34px;border:1px solid #e2e8f0;border-radius:50%;background:#fff;display:grid;place-items:center;color:#64748b;z-index:3;box-shadow:0 2px 8px rgba(0,0,0,.08);cursor:pointer;font-size:15px}.pic{height:190px;background:#f5f6f8;display:grid;place-items:center;overflow:hidden}.pic img{width:100%;height:100%;object-fit:cover}.info{padding:12px;display:flex;flex-direction:column;flex:1}.name{font-size:14px;font-weight:800;line-height:1.3;min-height:36px;display:flex;align-items:flex-start}.price{font-size:16px;font-weight:900;margin:5px 0}.stars{color:#f59e0b;font-size:12px;white-space:nowrap}.stars span{color:#94a3b8!important}.stock{display:inline-flex;width:max-content;margin-top:8px;padding:5px 9px;border-radius:7px;font-size:10px;font-weight:800}.in{background:#dcfce7;color:#15803d}.out{background:#fee2e2;color:#b91c1c}.low{background:#ffedd5;color:#c2410c}.actions{display:flex;gap:7px;margin-top:auto;padding-top:10px}.actions a{flex:1;text-align:center;padding:9px 6px;border-radius:8px;text-decoration:none;font-size:11px;font-weight:800}.edit{background:#fff7ed;color:#c2410c;border:1px solid #fdba74}.delete{background:#fff;color:#dc2626;border:1px solid #fca5a5}.badge{position:absolute;left:10px;top:10px;background:#ff7a00;color:#fff;padding:5px 8px;border-radius:6px;font-size:9px;font-weight:900;z-index:2}.description-btn{margin-top:8px;border:0;background:none;color:#ff7a00;font-size:11px;font-weight:800;cursor:pointer;text-align:left;padding:0}.empty{text-align:center;padding:40px;color:#64748b}.result-line{font-size:12px;color:#64748b;margin-bottom:12px}.description-modal{display:none;position:fixed;inset:0;z-index:9999;background:rgba(15,23,42,.62);align-items:center;justify-content:center;padding:20px}.description-modal.show{display:flex}.description-modal-card{width:min(680px,100%);max-height:80vh;overflow:auto;background:#fff;border-radius:16px;padding:25px;position:relative}.description-modal-close{position:absolute;right:14px;top:12px;border:0;border-radius:50%;width:34px;height:34px;background:#f1f5f9;font-size:20px}.description-modal-text{margin-top:12px;color:#475569;line-height:1.7;white-space:pre-wrap}@media(max-width:1350px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:1150px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:950px){.main-content{margin-left:0;padding:88px 20px 25px}.content-grid{grid-template-columns:1fr}.filters{display:block}.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:700px){.main-content{padding:82px 14px 20px}.page-head{align-items:flex-start;flex-direction:column}.toolbar{flex-direction:column}.search,.sort{width:100%}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.pic{height:170px}.products-wrap{padding:12px}.filters{padding:14px}}@media(max-width:430px){.grid{grid-template-columns:1fr}.pic{height:230px}}
</style></head><body><%- include("../../partials/admin/navbar") %><%- include("../../partials/admin/sidebar") %><main class="main-content">
<div class="page-head"><div><h1>All Products</h1><p>Manage your products, inventory and Best Seller selection.</p></div><a class="add-btn" href="/admin/product/add"><i class="fa-solid fa-plus"></i> Add Product</a></div>
<div class="toolbar"><div class="search"><i class="fa-solid fa-magnifying-glass"></i><input id="productSearch" type="search" placeholder="Search products..."></div><select class="sort" id="productSort"><option value="newest">Newest</option><option value="name">Name A-Z</option><option value="priceLow">Price Low</option><option value="priceHigh">Price High</option><option value="stockLow">Stock Low</option><option value="rating">Top Rated</option></select></div>
<div class="content-grid"><aside class="filters"><h3>Filters</h3><div class="filter-title">Categories</div>
<% category.forEach(function(cat){ %><label class="check"><input class="category-filter" type="checkbox" value="<%= String(cat.name||'').toLowerCase() %>"> <%= cat.name %></label><% }) %>
<div class="filter-title">Stock Status</div><label class="check"><input class="stock-filter" type="checkbox" value="in"> In Stock</label><label class="check"><input class="stock-filter" type="checkbox" value="low"> Low Stock</label><label class="check"><input class="stock-filter" type="checkbox" value="out"> Out of Stock</label>
<div class="filter-title">Product</div><label class="check"><input id="bestSellerFilter" type="checkbox"> Best Seller</label><label class="check"><input id="newStockFilter" type="checkbox"> New Stock</label>
<div class="filter-title">Rating</div><label class="check"><input class="rating-filter" type="checkbox" value="4"> <span class="rating">★★★★☆</span> & Up</label><label class="check"><input class="rating-filter" type="checkbox" value="3"> <span class="rating">★★★☆☆</span> & Up</label>
<div class="filter-title">Price Range</div><div class="price-fields"><input id="minPrice" type="number" min="0" placeholder="Min"><input id="maxPrice" type="number" min="0" placeholder="Max"></div><button id="resetFilters" class="reset" type="button">Reset Filters</button></aside>
<section class="products-wrap"><div id="resultLine" class="result-line"></div><div class="grid" id="productGrid">
<% if(!product.length){ %><div class="empty">No products found.</div><% } %>
<% product.forEach((item,index)=>{ const cat=category.find(c=>String(c._id)===String(item.categoryId)); const rating=Number(item.ratingAverage||0); const stock=Number(item.stock||0); const isNew=item.newUntil&&new Date(item.newUntil)>new Date(); %>
<article class="card product-card" data-name="<%= String(item.name||'').toLowerCase() %>" data-category="<%= String(cat?.name||'').toLowerCase() %>" data-price="<%= Number(item.price||0) %>" data-stock="<%= stock %>" data-stock-status="<%= stock<=0?'out':stock<=5?'low':'in' %>" data-rating="<%= rating %>" data-bestseller="<%= item.bestSeller?'true':'false' %>" data-new="<%= isNew?'true':'false' %>" data-created="<%= item.createdAt?new Date(item.createdAt).getTime():0 %>">
<% if(item.bestSeller){ %><span class="badge">BEST SELLER</span><% } %><button class="heart" type="button"><i class="fa-regular fa-heart"></i></button><div class="pic"><% if(item.images&&item.images.length){ %><img src="<%= item.images[0] %>" alt="<%= item.name %>" loading="lazy"><% }else{ %><img src="/images/whiteimg.jpg" alt="Product"><% } %></div><div class="info"><div class="name"><%= item.name %></div><div class="price">₹<%= Number(item.price||0).toLocaleString('en-IN') %></div><div class="stars"><%= rating ? '★'.repeat(Math.round(rating)) + '☆'.repeat(5-Math.round(rating)) : '☆☆☆☆☆' %> <span>(<%= Number(item.ratingCount||0) %>)</span></div><% if(stock<=0){ %><span class="stock out">Out of Stock</span><% }else if(stock<=5){ %><span class="stock low">Low Stock</span><% }else{ %><span class="stock in">In Stock</span><% } %><% if((item.description||'').length>110){ %><button type="button" class="description-btn" onclick='showDescription(<%- JSON.stringify(item.name||"Product") %>,<%- JSON.stringify(item.description||"") %>)'>See description</button><% } %><div class="actions"><a class="edit" href="/admin/product/edit/<%= item._id %>"><i class="fa-solid fa-pen"></i> Edit</a><a class="delete" href="/admin/product/delete/<%= item._id %>" onclick="return confirm('Are you sure you want to delete this product?')"><i class="fa-solid fa-trash"></i> Delete</a></div></div></article>
<% }) %></div></section></div></main>
<div id="descriptionModal" class="description-modal" onclick="closeDescription(event)"><div class="description-modal-card" onclick="event.stopPropagation()"><button class="description-modal-close" onclick="closeDescription()">&times;</button><h3 id="descriptionModalTitle"></h3><div id="descriptionModalText" class="description-modal-text"></div></div></div>
<script>
(function(){
const search=document.getElementById('productSearch'),sort=document.getElementById('productSort'),grid=document.getElementById('productGrid'),cards=[...grid.querySelectorAll('.product-card')],line=document.getElementById('resultLine');
const cats=[...document.querySelectorAll('.category-filter')],stocks=[...document.querySelectorAll('.stock-filter')],ratings=[...document.querySelectorAll('.rating-filter')],best=document.getElementById('bestSellerFilter'),fresh=document.getElementById('newStockFilter'),min=document.getElementById('minPrice'),max=document.getElementById('maxPrice');
function apply(){
 const q=search.value.trim().toLowerCase();
 const selectedCats=cats.filter(x=>x.checked).map(x=>x.value);
 const selectedStocks=stocks.filter(x=>x.checked).map(x=>x.value);
 const selectedRatings=ratings.filter(x=>x.checked).map(x=>Number(x.value));
 const minV=min.value===''?0:Number(min.value);
 const maxV=max.value===''?Infinity:Number(max.value);
 let visible=0;
 cards.forEach(c=>{
   const stockStatus=c.dataset.stockStatus;
   const match=(c.dataset.name.includes(q)||c.dataset.category.includes(q))
     &&(!selectedCats.length||selectedCats.includes(c.dataset.category))
     &&(!selectedStocks.length||selectedStocks.includes(stockStatus))
     &&(!selectedRatings.length||selectedRatings.some(r=>Number(c.dataset.rating)>=r))
     &&(!best.checked||c.dataset.bestseller==='true')
     &&(!fresh.checked||c.dataset.new==='true')
     &&Number(c.dataset.price)>=minV&&Number(c.dataset.price)<=maxV;
   c.classList.toggle('is-hidden',!match); if(match)visible++;
 });
 const mode=sort.value;
 const sorted=[...cards].sort((a,b)=>mode==='name'?a.dataset.name.localeCompare(b.dataset.name):mode==='priceLow'?Number(a.dataset.price)-Number(b.dataset.price):mode==='priceHigh'?Number(b.dataset.price)-Number(a.dataset.price):mode==='stockLow'?Number(a.dataset.stock)-Number(b.dataset.stock):mode==='rating'?Number(b.dataset.rating)-Number(a.dataset.rating):Number(b.dataset.created)-Number(a.dataset.created));
 sorted.forEach(c=>grid.appendChild(c));
 line.textContent=visible+' product'+(visible===1?'':'s')+' shown';
}
[search,min,max].forEach(x=>x.addEventListener('input',apply));
[sort,best,fresh,...cats,...stocks,...ratings].forEach(x=>x.addEventListener('change',apply));
document.getElementById('resetFilters').addEventListener('click',()=>{[...cats,...stocks,...ratings].forEach(x=>x.checked=false);best.checked=false;fresh.checked=false;min.value='';max.value='';search.value='';sort.value='newest';apply()});
apply();
})();function showDescription(n,d){document.getElementById('descriptionModalTitle').textContent=n;document.getElementById('descriptionModalText').textContent=d;document.getElementById('descriptionModal').classList.add('show');document.body.style.overflow='hidden'}function closeDescription(e){if(e&&e.target&&e.target.id!=='descriptionModal')return;document.getElementById('descriptionModal').classList.remove('show');document.body.style.overflow=''}document.addEventListener('keydown',e=>{if(e.key==='Escape')closeDescription()});
</script></body></html>
