<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Product Management</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
        }

        body {
            background: #f5f7fb;
            color: #111827;
        }


        /* =====================================================
           MAIN CONTENT
        ===================================================== */

        .main-content {
            width: calc(100% - 260px);

            margin-left: 260px;
            margin-top: 70px;

            min-height: calc(100vh - 70px);

            padding: 30px;

            overflow-x: hidden;
        }


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .page-header {
            width: 100%;

            background: #ffffff;

            border-radius: 15px;

            padding: 25px 30px;

            margin-bottom: 25px;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, .08);
        }

        .page-header h1 {
            color: #111827;

            font-size: clamp(25px, 3vw, 32px);

            font-weight: 700;

            line-height: 1.3;

            margin-bottom: 8px;

            overflow-wrap: anywhere;
        }

        .page-header p {
            color: #6b7280;

            font-size: 15px;

            line-height: 1.6;
        }


        /* =====================================================
           TOP BAR
        ===================================================== */

        .top-bar {
            width: 100%;

            display: flex;

            justify-content: flex-end;

            align-items: center;

            gap: 20px;

            margin-bottom: 25px;

            flex-wrap: wrap;
        }


        /* =====================================================
           ADD BUTTON
        ===================================================== */

        .add-btn {
            min-height: 48px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 10px;

            padding: 13px 22px;

            background: #2563eb;

            color: #ffffff;

            text-decoration: none;

            border-radius: 10px;

            font-size: 15px;

            font-weight: 600;

            line-height: 1.3;

            box-shadow:
                0 4px 10px rgba(37, 99, 235, .18);

            transition:
                background .25s ease,
                transform .2s ease,
                box-shadow .25s ease;
        }

        .add-btn:hover {
            background: #1d4ed8;

            transform: translateY(-2px);

            box-shadow:
                0 7px 15px rgba(37, 99, 235, .25);
        }


        /* =====================================================
           TABLE WRAPPER
        ===================================================== */

        .table-wrapper {
            width: 100%;

            background: #ffffff;

            border-radius: 15px;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, .08);

            overflow-x: auto;

            overflow-y: hidden;

            -webkit-overflow-scrolling: touch;
        }


        /* =====================================================
           TABLE
        ===================================================== */

        table {
            width: 100%;

            min-width: 1100px;

            border-collapse: collapse;

            white-space: nowrap;
        }


        /* =====================================================
           TABLE HEADER
        ===================================================== */

        thead {
            background: #0f172a;
        }

        th {
            color: #ffffff;

            padding: 17px 16px;

            text-align: center;

            font-size: 14px;

            font-weight: 600;

            line-height: 1.4;
        }


        /* =====================================================
           TABLE BODY
        ===================================================== */

        td {
            padding: 16px;

            text-align: center;

            vertical-align: middle;

            color: #374151;

            font-size: 14px;

            line-height: 1.5;

            border-bottom:
                1px solid #e5e7eb;
        }

        tbody tr {
            transition:
                background .2s ease;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }


        /* =====================================================
           PRODUCT IMAGE
        ===================================================== */

        .product-img {
            width: 75px;

            height: 75px;

            display: block;

            margin: 0 auto;

            border-radius: 10px;

            object-fit: cover;

            border:
                1px solid #e5e7eb;

            background: #f8fafc;
        }


        /* =====================================================
           PRICE
        ===================================================== */

        .price {
            color: #16a34a;

            font-weight: 700;

            font-size: 15px;
        }


        /* =====================================================
           STOCK
        ===================================================== */

        .stock {
            color: #2563eb;

            font-weight: 600;
        }


        /* =====================================================
           STATUS
        ===================================================== */

        .status {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-width: 95px;

            padding: 7px 13px;

            border-radius: 20px;

            font-size: 13px;

            font-weight: 600;

            line-height: 1.3;
        }

        .status.in {
            background: #dcfce7;

            color: #15803d;
        }

        .status.out {
            background: #fee2e2;

            color: #dc2626;
        }


        /* =====================================================
           ACTION BUTTONS
        ===================================================== */

        .edit-btn,
        .delete-btn {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            min-height: 40px;

            padding: 9px 15px;

            color: #ffffff;

            text-decoration: none;

            border-radius: 8px;

            font-size: 13px;

            font-weight: 600;

            line-height: 1.2;

            transition:
                background .25s ease,
                transform .2s ease,
                box-shadow .25s ease;
        }


        /* EDIT */

        .edit-btn {
            background: #10b981;

            box-shadow:
                0 3px 8px rgba(16, 185, 129, .15);
        }

        .edit-btn:hover {
            background: #059669;

            transform: translateY(-2px);

            box-shadow:
                0 6px 12px rgba(16, 185, 129, .22);
        }


        /* DELETE */

        .delete-btn {
            background: #ef4444;

            box-shadow:
                0 3px 8px rgba(239, 68, 68, .15);
        }

        .delete-btn:hover {
            background: #dc2626;

            transform: translateY(-2px);

            box-shadow:
                0 6px 12px rgba(239, 68, 68, .22);
        }


        /* =====================================================
           SCROLLBAR
        ===================================================== */

        .table-wrapper::-webkit-scrollbar {
            height: 8px;
        }

        .table-wrapper::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .table-wrapper::-webkit-scrollbar-thumb {
            background: #94a3b8;

            border-radius: 20px;
        }

        .table-wrapper::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 900px) {

            .main-content {
                width: 100%;

                margin-left: 0;

                margin-top: 68px;

                min-height:
                    calc(100vh - 68px);

                padding: 25px 20px;
            }

            .page-header {
                padding: 22px 24px;

                border-radius: 13px;

                margin-bottom: 22px;
            }

            .top-bar {
                justify-content: flex-end;

                margin-bottom: 20px;
            }

            .add-btn {
                min-height: 46px;

                padding:
                    12px 19px;
            }

            .table-wrapper {
                border-radius: 13px;
            }

            th {
                padding: 15px 14px;
            }

            td {
                padding: 14px;
            }
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            .main-content {
                margin-top: 65px;

                min-height:
                    calc(100vh - 65px);

                padding:
                    20px 12px;
            }

            .page-header {
                padding:
                    20px 17px;

                margin-bottom: 18px;

                border-radius: 12px;
            }

            .page-header h1 {
                font-size: 24px;

                margin-bottom: 7px;
            }

            .page-header p {
                font-size: 13px;
            }

            .top-bar {
                width: 100%;

                margin-bottom: 18px;
            }

            .add-btn {
                width: 100%;

                min-height: 47px;

                padding:
                    12px 15px;

                font-size: 14px;
            }

            .table-wrapper {
                border-radius: 12px;
            }

            table {
                min-width: 1050px;
            }

            th {
                padding:
                    14px 12px;

                font-size: 13px;
            }

            td {
                padding:
                    13px 12px;

                font-size: 13px;
            }

            .product-img {
                width: 65px;

                height: 65px;
            }

            .status {
                min-width: 88px;

                padding:
                    6px 11px;

                font-size: 12px;
            }

            .edit-btn,
            .delete-btn {
                min-height: 38px;

                padding:
                    8px 12px;

                font-size: 12px;
            }

        }


        /* =====================================================
           SMALL MOBILE
        ===================================================== */

        @media (max-width: 400px) {

            .main-content {
                padding:
                    17px 9px;
            }

            .page-header {
                padding:
                    17px 14px;

                border-radius: 10px;
            }

            .page-header h1 {
                font-size: 21px;
            }

            .page-header p {
                font-size: 12px;
            }

            .add-btn {
                min-height: 44px;

                font-size: 13px;

                border-radius: 8px;
            }

            .table-wrapper {
                border-radius: 10px;
            }

            table {
                min-width: 1000px;
            }

            th {
                padding:
                    12px 10px;

                font-size: 12px;
            }

            td {
                padding:
                    11px 10px;

                font-size: 12px;
            }

            .product-img {
                width: 58px;

                height: 58px;

                border-radius: 8px;
            }

            .price {
                font-size: 13px;
            }

            .status {
                min-width: 82px;

                font-size: 11px;
            }

            .edit-btn,
            .delete-btn {
                min-height: 36px;

                padding:
                    7px 10px;

                font-size: 11px;
            }

        }


        /* =====================================================
           VERY SMALL MOBILE
        ===================================================== */

        @media (max-width: 330px) {

            .main-content {
                padding:
                    15px 7px;
            }

            .page-header {
                padding:
                    15px 12px;
            }

            .page-header h1 {
                font-size: 19px;
            }

            .page-header p {
                font-size: 11px;
            }

            .add-btn {
                min-height: 42px;

                font-size: 12px;
            }

            table {
                min-width: 960px;
            }

            th {
                font-size: 11px;

                padding:
                    11px 9px;
            }

            td {
                font-size: 11px;

                padding:
                    10px 9px;
            }

            .product-img {
                width: 52px;

                height: 52px;
            }

            .status {
                min-width: 76px;

                padding:
                    5px 8px;

                font-size: 10px;
            }

            .edit-btn,
            .delete-btn {
                min-height: 34px;

                padding:
                    6px 9px;

                font-size: 10px;
            }

        }


        /* =====================================================
           TOUCH DEVICES
        ===================================================== */

        @media (hover: none) {

            .add-btn:hover,
            .edit-btn:hover,
            .delete-btn:hover {
                transform: none;
            }

        }


        /* =====================================================
           REDUCED MOTION
        ===================================================== */

        @media (prefers-reduced-motion: reduce) {

            .add-btn,
            .edit-btn,
            .delete-btn,
            tbody tr {
                transition: none;
            }

        }
    </style>

</head>


<body>


    <!-- =====================================================
         ADMIN NAVBAR
    ===================================================== -->

    <%- include("../../partials/admin/navbar") %>


        <!-- =====================================================
         ADMIN SIDEBAR
    ===================================================== -->

        <%- include("../../partials/admin/sidebar") %>


            <!-- =====================================================
         MAIN CONTENT
    ===================================================== -->

            <main class="main-content">


                <!-- PAGE HEADER -->

                <section class="page-header">

                    <h1>
                        Product Management
                    </h1>

                    <p>
                        Manage all products from here.
                    </p>

                </section>


                <!-- TOP BAR -->

                <div class="top-bar">

                    <a href="/admin/product/add" class="add-btn">

                        <i class="fa-solid fa-plus"></i>

                        Add Product

                    </a>

                </div>


                <!-- PRODUCT TABLE -->

                <div class="table-wrapper">

                    <table>

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Image</th>

                                <th>Name</th>

                                <th>Price</th>

                                <th>Description</th>

                                <th>Stock</th>

                                <th>Status</th>

                                <th>Edit</th>

                                <th>Delete</th>

                            </tr>

                        </thead>


                        <tbody>

                            <% product.forEach((item,index)=>{ %>

                                <tr>

                                    <!-- NUMBER -->

                                    <td>
                                        <%= index + 1 %>
                                    </td>


                                    <!-- IMAGE -->

                                    <td>

                                        <% if(item.images && item.images.length> 0){ %>

                                            <img src="<%= item.images[0] %>" class="product-img" alt="<%= item.name %>">

                                            <% }else{ %>

                                                <img src="https://via.placeholder.com/75" class="product-img"
                                                    alt="Product">

                                                <% } %>

                                    </td>


                                    <!-- NAME -->

                                    <td>
                                        <%= item.name %>
                                    </td>


                                    <!-- PRICE -->

                                    <td class="price">

                                        ₹ <%= item.price %>

                                    </td>


                                    <!-- DESCRIPTION -->

                                    <td>

                                        <%= item.description %>

                                    </td>


                                    <!-- STOCK -->

                                    <td class="stock">

                                        <%= item.stock %>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% if(item.stock> 0){ %>

                                            <span class="status in">

                                                In Stock

                                            </span>

                                            <% }else{ %>

                                                <span class="status out">

                                                    Out of Stock

                                                </span>

                                                <% } %>

                                    </td>


                                    <!-- EDIT -->

                                    <td>

                                        <a href="/admin/product/edit/<%= item._id %>" class="edit-btn">

                                            <i class="fa-solid fa-pen"></i>

                                            Edit

                                        </a>

                                    </td>


                                    <!-- DELETE -->

                                    <td>

                                        <a href="/admin/product/delete/<%= item._id %>" class="delete-btn"
                                            onclick="return confirm('Are you sure you want to delete this product?')">

                                            <i class="fa-solid fa-trash"></i>

                                            Delete

                                        </a>

                                    </td>

                                </tr>

                                <% }) %>

                        </tbody>

                    </table>

                </div>


            </main>


            <!-- =====================================================
         ADMIN FOOTER
    ===================================================== -->

            <%- include("../../partials/admin/footer") %>


</body>

</html>