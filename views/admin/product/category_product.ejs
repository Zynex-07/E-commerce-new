<!DOCTYPE html>
<html>

<head>

    <title>Category Product</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {

            background:
                linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);

            min-height: 100vh;
        }


        /* =========================
   NAVBAR
========================= */

        .navbar {

            width: 100%;

            background:
                linear-gradient(90deg,
                    #0f172a,
                    #1e293b);

            padding: 18px 8%;

            display: flex;
            justify-content: space-between;
            align-items: center;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.15);
        }


        /* LOGO */

        .logo {
            display: flex;
            align-items: center;
        }

        .logo img {

            width: 145px;
            height: 60px;

            object-fit: contain;

            cursor: pointer;

            transition: 0.3s;
        }

        .logo img:hover {

            transform: scale(1.08);
        }


        /* BUTTON */

        .btn {

            background:
                linear-gradient(90deg,
                    #f59e0b,
                    #ef4444);

            color: white;

            text-decoration: none;

            padding: 12px 22px;

            border-radius: 10px;

            font-weight: 600;

            transition: 0.3s;

            box-shadow:
                0 5px 15px rgba(239, 68, 68, 0.3);
        }

        .btn:hover {

            transform: translateY(-4px);

            box-shadow:
                0 10px 20px rgba(239, 68, 68, 0.5);
        }


        /* =========================
   HERO
========================= */

        .hero {

            width: 100%;
            height: 280px;

            background:
                linear-gradient(rgba(0, 0, 0, 0.6),
                    rgba(0, 0, 0, 0.6)),

                url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=1600');

            background-size: cover;
            background-position: center;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero h1 {

            color: white;

            font-size: 56px;

            letter-spacing: 2px;

            font-weight: 700;
        }


        /* =========================
   CONTAINER
========================= */

        .container {

            width: 92%;
            max-width: 1250px;

            margin: 50px auto;
        }


        /* TOP BAR */

        .top-bar {

            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-bottom: 35px;
        }

        .top-bar h2 {

            font-size: 38px;

            color: #111827;

            font-weight: 700;
        }


        /* =========================
   PRODUCTS
========================= */

        .product {

            display: flex;
            flex-wrap: wrap;

            gap: 25px;

            justify-content: center;
        }


        /* CARD */

        .card {

            width: 285px;

            background: white;

            border-radius: 18px;

            overflow: hidden;

            box-shadow:
                0 10px 25px rgba(0, 0, 0, 0.1);

            transition: 0.3s;
        }

        .card:hover {

            transform: translateY(-8px);

            box-shadow:
                0 15px 35px rgba(0, 0, 0, 0.18);
        }


        /* IMAGE */

        .card img {

            width: 100%;
            height: 260px;

            object-fit: cover;
        }


        /* CONTENT */

        .content {

            padding: 18px;
        }

        .content h2 {

            font-size: 24px;

            margin-bottom: 12px;

            color: #111827;
        }


        /* PRICE */

        .price {

            color: #16a34a;

            font-size: 24px;

            font-weight: bold;

            margin-bottom: 10px;
        }


        /* STOCK */

        .stock {

            color: #2563eb;

            font-size: 17px;

            font-weight: 600;

            margin-bottom: 12px;
        }


        /* DESCRIPTION */

        .desc {

            color: #4b5563;

            line-height: 25px;

            margin-bottom: 18px;
        }


        /* ACTIONS */

        .actions {

            display: flex;
            justify-content: space-between;

            gap: 10px;
        }


        /* EDIT BUTTON */

        .edit {

            flex: 1;

            background:
                linear-gradient(90deg,
                    #f59e0b,
                    #f97316);

            color: white;

            text-align: center;

            padding: 10px;

            text-decoration: none;

            border-radius: 8px;

            transition: 0.3s;
        }

        .edit:hover {

            transform: translateY(-3px);
        }


        /* DELETE BUTTON */

        .delete {

            flex: 1;

            background:
                linear-gradient(90deg,
                    #dc2626,
                    #ef4444);

            color: white;

            text-align: center;

            padding: 10px;

            text-decoration: none;

            border-radius: 8px;

            transition: 0.3s;
        }

        .delete:hover {

            transform: translateY(-3px);
        }


        /* =========================
   FOOTER
========================= */

        footer {

            margin-top: 80px;

            background:
                linear-gradient(90deg,
                    #0f172a,
                    #1e293b);

            color: white;

            text-align: center;

            padding: 25px;

            font-size: 16px;

            letter-spacing: 1px;

            box-shadow:
                0 -5px 15px rgba(0, 0, 0, 0.15);
        }


        /* =========================
   RESPONSIVE
========================= */

        @media(max-width:900px) {

            .hero h1 {

                font-size: 38px;
            }

            .top-bar {

                flex-direction: column;

                gap: 15px;
            }

        }
    </style>
</head>

<body>
    <%- include("../../partials/admin/navbar") %>

        <%- include("../../partials/admin/sidebar") %>

            <div class="main-content">
                <div class="navbar">
                    <div class="logo"><img src="/images/logo.png" alt="error">
                    </div>
                    <a href="/admin/product/add" class="btn">
                        + ADD PRODUCT
                    </a>
                </div>
                <div class="hero">
                    <h1>
                        <%= category.name %> PRODUCTS
                    </h1>
                </div>
                <div class="container">
                    <div class="top-bar">
                        <h2>
                            All Products
                        </h2>
                    </div>
                    <div class="product">
                        <% product.forEach(function(product) { %>
                            <div class="card">
                                <img src="<%= product.images %>" alt="Product">
                                <div class="content">
                                    <h2>
                                        <%= product.name %>
                                    </h2>
                                    <div class="price">
                                        ₹ <%= product.price %>
                                    </div>

                                    <div class="desc">
                                        <%= product.description %>
                                    </div>
                                    <div class="stock">
                                        Stock : <%= product.stock %>
                                    </div>
                                    <br>
                                    <div class="actions">
                                        <a href="/admin/product/edit/<%= product._id %>" class="edit">
                                            Edit
                                        </a>
                                        <a href="/admin/product/delete/<%= product._id %>" class="delete">
                                            Delete
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
            </div>

            <%- include("../../partials/admin/footer") %>
</body>

</html>