<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users | Admin Panel</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: #f8fafc; color: #0f172a; font-family: Inter, Arial, sans-serif; overflow-x: hidden; }
        .main-content { margin-left: 260px; padding: 96px 30px 30px; min-height: 100vh; }
        .page-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:24px; }
        .page-head h1 { font-size:31px; margin-bottom:6px; }
        .page-head p { color:#64748b; font-size:14px; }
        .count-card { background:#fff; border:1px solid #e2e8f0; border-radius:15px; padding:18px 22px; box-shadow:0 5px 18px rgba(15,23,42,.05); min-width:150px; }
        .count-card span { display:block; color:#64748b; font-size:12px; font-weight:700; margin-bottom:5px; }
        .count-card strong { font-size:28px; }
        .panel { background:#fff; border:1px solid #e2e8f0; border-radius:15px; padding:21px; box-shadow:0 5px 18px rgba(15,23,42,.04); overflow:hidden; }
        .panel-head { display:flex; align-items:center; justify-content:space-between; gap:15px; margin-bottom:16px; }
        .panel-head h2 { font-size:18px; }
        .panel-head a { color:#2563eb; text-decoration:none; font-size:13px; font-weight:800; }
        .table-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
        table { width:100%; min-width:680px; border-collapse:collapse; }
        th, td { padding:14px 12px; text-align:left; border-bottom:1px solid #eef2f7; font-size:13px; }
        th { color:#64748b; font-size:11px; text-transform:uppercase; letter-spacing:.05em; background:#f8fafc; }
        tbody tr:hover { background:#f8fafc; }
        .user-name { font-weight:700; color:#0f172a; }
        .email { color:#475569; }
        .cart-count { display:inline-flex; min-width:32px; justify-content:center; padding:5px 9px; border-radius:999px; background:#ecfdf5; color:#15803d; font-weight:800; }
        .empty { text-align:center; color:#64748b; padding:35px 10px; }
        @media(max-width:900px){ .main-content{margin-left:0;padding:88px 20px 25px;} }
        @media(max-width:600px){ .main-content{padding:82px 14px 20px;} .page-head{flex-direction:column;} .page-head h1{font-size:25px;} .count-card{width:100%;} .panel{padding:15px;} }
    </style>
</head>
<body>
    <%- include("../../partials/admin/navbar") %>
    <%- include("../../partials/admin/sidebar") %>

    <main class="main-content">
        <div class="page-head">
            <div>
                <h1>Users</h1>
                <p>View all registered customers and their current cart activity.</p>
            </div>
            <div class="count-card">
                <span>Total Customers</span>
                <strong><%= users.length %></strong>
            </div>
        </div>

        <section class="panel">
            <div class="panel-head">
                <h2>All Customers</h2>
                <a href="/admin/dashboard">← Dashboard</a>
            </div>

            <% if (!users.length) { %>
                <div class="empty">No registered users found.</div>
            <% } else { %>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Cart Items</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td class="user-name"><%= user.name || "—" %></td>
                                    <td class="email"><%= user.email || "—" %></td>
                                    <td><span class="cart-count"><%= Array.isArray(user.cartItems) ? user.cartItems.reduce((sum, item) => sum + Number(item.qty || 0), 0) : 0 %></span></td>
                                    <td><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-IN") : "—" %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>
