<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* =========================
           MAIN CONTENT
        ========================= */

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            width: 100%;
            background: #111827;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .15);
        }

        .logo {
            color: #fff;
            font-size: 28px;
            font-weight: bold;
            white-space: nowrap;
        }

        .nav {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        .nav .btn {
            text-decoration: none;
            color: #fff;
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            transition: .3s;
            white-space: nowrap;
        }

        .nav .btn:hover {
            background: #fff;
            color: #111827;
            transform: translateY(-3px);
        }

        .logout:hover {
            background: #dc2626 !important;
            color: #fff !important;
        }

        /* =========================
           CONTAINER
        ========================= */

        .container {
            width: 95%;
            max-width: 1300px;
            margin: 40px auto;
        }

        .title {
            text-align: center;
            font-size: clamp(28px, 4vw, 42px);
            color: #111827;
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .count {
            width: fit-content;
            max-width: 100%;
            margin: 0 auto 30px;
            background: #2563eb;
            color: #fff;
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 18px;
            font-weight: 600;
            text-align: center;
        }

        /* =========================
           TABLE
        ========================= */

        .table-box {
            width: 100%;
            background: #fff;
            border-radius: 18px;
            overflow-x: auto;
            box-shadow: 0 12px 30px rgba(0, 0, 0, .12);
            -webkit-overflow-scrolling: touch;
        }

        table {
            width: 100%;
            min-width: 720px;
            border-collapse: collapse;
        }

        thead {
            background: linear-gradient(90deg, #f59e0b, #ef4444);
        }

        th {
            color: #fff;
            padding: 18px;
            text-align: center;
            font-size: 16px;
            white-space: nowrap;
        }

        td {
            padding: 18px;
            text-align: center;
            border-bottom: 1px solid #eee;
            transition: .3s;
            color: #374151;
            overflow-wrap: anywhere;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .cart-count {
            color: #16a34a;
            font-weight: bold;
            font-size: 18px;
        }

        /* =========================
           TABLET
        ========================= */

        @media (max-width: 1024px) {
            .main-content {
                margin-left: 220px;
                width: calc(100% - 220px);
            }

            .navbar {
                padding: 15px 25px;
            }

            .nav .btn {
                padding: 9px 12px;
                font-size: 13px;
            }

            .container {
                width: 94%;
                margin: 35px auto;
            }

            th,
            td {
                padding: 15px;
            }
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 768px) {
            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .navbar {
                justify-content: center;
                padding: 20px 15px;
                gap: 18px;
            }

            .logo {
                width: 100%;
                text-align: center;
                font-size: 26px;
            }

            .nav {
                width: 100%;
                justify-content: center;
                gap: 8px;
            }

            .nav .btn {
                padding: 10px 12px;
                font-size: 13px;
            }

            .container {
                width: 94%;
                margin: 30px auto;
            }

            .title {
                font-size: 30px;
            }

            .count {
                font-size: 16px;
                padding: 9px 18px;
                margin-bottom: 25px;
            }

            .table-box {
                border-radius: 14px;
            }

            table {
                min-width: 700px;
            }

            th,
            td {
                padding: 14px;
                font-size: 14px;
            }
        }

        /* =========================
           SMALL MOBILE
        ========================= */

        @media (max-width: 480px) {
            .navbar {
                padding: 18px 12px;
                gap: 15px;
            }

            .logo {
                font-size: 23px;
            }

            .nav {
                flex-direction: column;
                width: 100%;
                gap: 8px;
            }

            .nav .btn {
                width: 100%;
                text-align: center;
                font-size: 14px;
                padding: 11px;
            }

            .container {
                width: 94%;
                margin: 25px auto;
            }

            .title {
                font-size: 25px;
                margin-bottom: 16px;
            }

            .count {
                font-size: 15px;
                padding: 9px 15px;
                margin-bottom: 22px;
            }

            table {
                min-width: 650px;
            }

            th,
            td {
                padding: 12px;
                font-size: 13px;
            }

            .cart-count {
                font-size: 16px;
            }
        }

        /* =========================
           VERY SMALL MOBILE
        ========================= */

        @media (max-width: 360px) {
            .logo {
                font-size: 21px;
            }

            .title {
                font-size: 23px;
            }

            .count {
                font-size: 14px;
            }

            table {
                min-width: 620px;
            }

            th,
            td {
                padding: 10px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <div class="main-content">

        <nav class="navbar">

            <h1 class="logo">
                User Page
            </h1>

            <div class="nav">
                <a href="/admin/category" class="btn">📂 Category</a>
                <a href="/admin/product" class="btn">📦 Product</a>
                <a href="/admin/order" class="btn">🛒 Orders</a>
                <a href="/admin/user" class="btn">👥 Users</a>
                <a href="/admin/dashboard" class="btn">🏠 Dashboard</a>
            </div>

        </nav>

        <div class="container">

            <h1 class="title">
                All Users
            </h1>

            <div class="count">
                Total Users: <%= users.length %>
            </div>

            <div class="table-box">

                <table>

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Cart Items</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% users.forEach(user=> { %>

                            <tr>
                                <td>
                                    <%= user.name %>
                                </td>

                                <td>
                                    <%= user.email %>
                                </td>

                                <td class="cart-count">
                                    <%= user.cartItems ? user.cartItems.length : 0 %>
                                </td>
                            </tr>

                            <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</body>

</html>