<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Category</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
        }

        body {
            background: #f5f7fb;
            color: #111827;
        }


        /* =====================================================
           MAIN CONTENT
        ===================================================== */

        .main-content {
            width: calc(100% - 260px);

            margin-left: 260px;
            margin-top: 70px;

            min-height: calc(100vh - 70px);

            padding: 30px;

            overflow-x: hidden;
        }


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .page-header {
            width: 100%;

            background: #ffffff;

            border-radius: 15px;

            padding: 25px 30px;

            margin-bottom: 30px;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, .08);
        }

        .page-header h1 {
            color: #111827;

            font-size: clamp(25px, 3vw, 32px);

            font-weight: 700;

            line-height: 1.3;

            margin-bottom: 8px;

            overflow-wrap: anywhere;
        }

        .page-header p {
            color: #6b7280;

            font-size: 15px;

            line-height: 1.6;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           CARD
        ===================================================== */

        .card {
            width: 100%;

            max-width: 650px;

            margin: 0 auto;

            background: #ffffff;

            border-radius: 15px;

            padding: 35px;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, .08);
        }


        /* =====================================================
           CARD HEADING
        ===================================================== */

        .card h2 {
            display: flex;

            align-items: center;

            justify-content: center;

            gap: 10px;

            color: #111827;

            margin-bottom: 25px;

            font-size: clamp(22px, 3vw, 28px);

            font-weight: 700;

            line-height: 1.3;

            text-align: center;
        }

        .card h2 i {
            color: #10b981;

            flex-shrink: 0;
        }


        /* =====================================================
           FORM
        ===================================================== */

        .form-group {
            width: 100%;

            margin-bottom: 20px;
        }

        .form-group label {
            display: block;

            margin-bottom: 8px;

            color: #374151;

            font-size: 15px;

            font-weight: 600;

            line-height: 1.4;
        }


        /* =====================================================
           INPUT
        ===================================================== */

        .form-control {
            display: block;

            width: 100%;

            min-height: 50px;

            padding: 13px 14px;

            border: 1px solid #d1d5db;

            border-radius: 8px;

            background: #ffffff;

            color: #111827;

            font-size: 15px;

            line-height: 1.4;

            outline: none;

            appearance: none;

            transition:
                border-color .25s ease,
                box-shadow .25s ease;
        }

        .form-control::placeholder {
            color: #9ca3af;
        }

        .form-control:focus {
            border-color: #10b981;

            box-shadow:
                0 0 0 3px rgba(16, 185, 129, .12);
        }


        /* =====================================================
           BUTTON GROUP
        ===================================================== */

        .btn-group {
            width: 100%;

            display: flex;

            gap: 15px;

            margin-top: 25px;
        }


        /* =====================================================
           BUTTON
        ===================================================== */

        .btn {
            flex: 1;

            min-height: 48px;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            padding: 13px 16px;

            border: none;

            border-radius: 8px;

            text-decoration: none;

            text-align: center;

            font-size: 15px;

            font-weight: 600;

            line-height: 1.3;

            cursor: pointer;

            transition:
                background .25s ease,
                transform .2s ease,
                box-shadow .25s ease;
        }


        /* =====================================================
           UPDATE BUTTON
        ===================================================== */

        .btn-save {
            background: #10b981;

            color: #ffffff;

            box-shadow:
                0 4px 10px rgba(16, 185, 129, .18);
        }

        .btn-save:hover {
            background: #059669;

            transform: translateY(-2px);

            box-shadow:
                0 7px 15px rgba(16, 185, 129, .25);
        }


        /* =====================================================
           BACK BUTTON
        ===================================================== */

        .btn-back {
            background: #6b7280;

            color: #ffffff;

            box-shadow:
                0 4px 10px rgba(107, 114, 128, .15);
        }

        .btn-back:hover {
            background: #4b5563;

            transform: translateY(-2px);

            box-shadow:
                0 7px 15px rgba(75, 85, 99, .22);
        }


        /* =====================================================
           ACTIVE
        ===================================================== */

        .btn:active {
            transform: scale(.97);
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 900px) {

            .main-content {
                width: 100%;

                margin-left: 0;

                margin-top: 68px;

                min-height: calc(100vh - 68px);

                padding: 25px 20px;
            }

            .page-header {
                padding: 22px 24px;

                margin-bottom: 25px;

                border-radius: 13px;
            }

            .card {
                max-width: 620px;

                padding: 30px;
            }
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            .main-content {
                margin-top: 65px;

                min-height: calc(100vh - 65px);

                padding: 20px 12px;
            }

            .page-header {
                padding: 20px 17px;

                margin-bottom: 20px;

                border-radius: 12px;
            }

            .page-header h1 {
                font-size: 24px;

                margin-bottom: 7px;
            }

            .page-header p {
                font-size: 13px;

                line-height: 1.6;
            }

            .card {
                max-width: 100%;

                padding: 24px 18px;

                border-radius: 12px;
            }

            .card h2 {
                font-size: 21px;

                margin-bottom: 22px;
            }

            .form-group {
                margin-bottom: 18px;
            }

            .form-group label {
                font-size: 14px;

                margin-bottom: 7px;
            }

            .form-control {
                min-height: 48px;

                padding: 12px;

                font-size: 14px;
            }

            .btn-group {
                flex-direction: column;

                gap: 10px;

                margin-top: 22px;
            }

            .btn {
                width: 100%;

                flex: none;

                min-height: 46px;

                padding: 12px 14px;

                font-size: 14px;
            }
        }


        /* =====================================================
           SMALL MOBILE
        ===================================================== */

        @media (max-width: 400px) {

            .main-content {
                padding: 17px 9px;
            }

            .page-header {
                padding: 17px 14px;

                border-radius: 10px;
            }

            .page-header h1 {
                font-size: 21px;
            }

            .page-header p {
                font-size: 12px;
            }

            .card {
                padding: 21px 14px;

                border-radius: 10px;
            }

            .card h2 {
                font-size: 19px;

                gap: 8px;

                margin-bottom: 20px;
            }

            .form-group label {
                font-size: 13px;
            }

            .form-control {
                min-height: 46px;

                padding: 11px;

                font-size: 13px;

                border-radius: 7px;
            }

            .btn {
                min-height: 44px;

                font-size: 13px;

                border-radius: 7px;
            }
        }


        /* =====================================================
           VERY SMALL MOBILE
        ===================================================== */

        @media (max-width: 330px) {

            .main-content {
                padding: 15px 7px;
            }

            .page-header {
                padding: 15px 12px;
            }

            .page-header h1 {
                font-size: 19px;
            }

            .page-header p {
                font-size: 11px;
            }

            .card {
                padding: 19px 12px;
            }

            .card h2 {
                font-size: 17px;
            }

            .form-group label {
                font-size: 12px;
            }

            .form-control {
                min-height: 44px;

                font-size: 12px;

                padding: 10px;
            }

            .btn {
                min-height: 42px;

                font-size: 12px;
            }
        }


        /* =====================================================
           TOUCH DEVICES
        ===================================================== */

        @media (hover: none) {

            .btn-save:hover,
            .btn-back:hover {
                transform: none;

                box-shadow:
                    0 4px 10px rgba(0, 0, 0, .12);
            }
        }


        /* =====================================================
           REDUCED MOTION
        ===================================================== */

        @media (prefers-reduced-motion: reduce) {

            .btn,
            .form-control {
                transition: none;
            }
        }
    </style>

</head>


<body>


    <!-- =====================================================
         ADMIN NAVBAR
    ===================================================== -->

    <%- include("../../partials/admin/navbar") %>


        <!-- =====================================================
         ADMIN SIDEBAR
    ===================================================== -->

        <%- include("../../partials/admin/sidebar") %>


            <!-- =====================================================
         MAIN CONTENT
    ===================================================== -->

            <main class="main-content">


                <!-- PAGE HEADER -->

                <section class="page-header">

                    <h1>
                        Edit Category
                    </h1>

                    <p>
                        Update category information from here.
                    </p>

                </section>


                <!-- CATEGORY FORM -->

                <section class="card">

                    <h2>

                        <i class="fa-solid fa-pen-to-square"></i>

                        Edit Category

                    </h2>


                    <form action="/admin/category/update/<%= category._id %>" method="POST">


                        <div class="form-group">

                            <label for="categoryName">
                                Category Name
                            </label>


                            <input type="text" id="categoryName" name="name" class="form-control"
                                value="<%= category.name %>" placeholder="Enter Category Name" autocomplete="off"
                                required>

                        </div>


                        <!-- BUTTONS -->

                        <div class="btn-group">


                            <button type="submit" class="btn btn-save">

                                <i class="fa-solid fa-floppy-disk"></i>

                                Update Category

                            </button>


                            <a href="/admin/category" class="btn btn-back">

                                <i class="fa-solid fa-arrow-left"></i>

                                Back

                            </a>

                        </div>

                    </form>

                </section>


            </main>


            <!-- =====================================================
         ADMIN FOOTER
    ===================================================== -->

            <%- include("../../partials/admin/footer") %>


</body>

</html>