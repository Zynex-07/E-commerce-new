<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Categories</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">


    <style>
        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
        }


        body {
            background: #f5f7fb;
            color: #111827;
        }


        /* =====================================================
           MAIN CONTENT
        ===================================================== */

        .main-content {

            margin-left: 260px;
            margin-top: 70px;

            padding: 30px;

            min-height:
                calc(100vh - 70px);

            width:
                calc(100% - 260px);

            overflow-x: hidden;
        }


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .page-header {

            width: 100%;

            background: #ffffff;

            border-radius: 15px;

            padding:
                25px 30px;

            margin-bottom: 30px;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, .08);
        }


        .page-header h1 {

            color: #111827;

            font-size:
                clamp(25px, 3vw, 32px);

            font-weight: 700;

            line-height: 1.3;

            overflow-wrap: anywhere;
        }


        .page-header p {

            margin-top: 8px;

            color: #6b7280;

            font-size: 15px;

            line-height: 1.6;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           TOP BAR
        ===================================================== */

        .top-bar {

            width: 100%;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 20px;
        }


        .top-bar h2 {

            color: #111827;

            font-size:
                clamp(20px, 2.5vw, 26px);

            font-weight: 600;

            line-height: 1.3;
        }


        /* =====================================================
           ADD BUTTON
        ===================================================== */

        .btn {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            min-height: 44px;

            padding:
                12px 20px;

            background: #2563eb;

            color: #ffffff;

            text-decoration: none;

            border-radius: 8px;

            font-size: 14px;

            font-weight: 600;

            line-height: 1.3;

            white-space: nowrap;

            box-shadow:
                0 4px 10px rgba(37, 99, 235, .20);

            transition:
                background .25s ease,
                transform .2s ease,
                box-shadow .25s ease;
        }


        .btn:hover {

            background: #1d4ed8;

            transform:
                translateY(-2px);

            box-shadow:
                0 7px 15px rgba(37, 99, 235, .28);
        }


        .btn:active {

            transform:
                scale(.97);
        }


        /* =====================================================
           TABLE WRAPPER
        ===================================================== */

        .table-wrapper {

            width: 100%;

            background: #ffffff;

            border-radius: 15px;

            overflow-x: auto;

            overflow-y: hidden;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, .08);

            -webkit-overflow-scrolling: touch;

            scrollbar-width: thin;
        }


        /* =====================================================
           TABLE
        ===================================================== */

        table {

            width: 100%;

            min-width: 650px;

            border-collapse: collapse;

            table-layout: fixed;
        }


        th {

            background: #0f172a;

            color: #ffffff;

            padding:
                16px;

            font-size: 14px;

            font-weight: 600;

            line-height: 1.4;

            text-align: center;

            white-space: nowrap;
        }


        td {

            padding:
                16px;

            border-bottom:
                1px solid #e5e7eb;

            text-align: center;

            color: #374151;

            font-size: 14px;

            line-height: 1.5;

            vertical-align: middle;

            overflow-wrap: anywhere;
        }


        tbody tr {

            transition:
                background .2s ease;
        }


        tbody tr:hover {

            background: #f8fafc;
        }


        tbody tr:last-child td {

            border-bottom: none;
        }


        /* =====================================================
           CATEGORY LINK
        ===================================================== */

        .table-wrapper td a:not(.edit-btn):not(.delete-btn) {

            color: #111827;

            text-decoration: none;

            font-weight: 600;

            overflow-wrap: anywhere;

            word-break: break-word;

            transition:
                color .2s ease;
        }


        .table-wrapper td a:not(.edit-btn):not(.delete-btn):hover {

            color: #2563eb;
        }


        /* =====================================================
           ACTION BUTTONS
        ===================================================== */

        .edit-btn,
        .delete-btn {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-width: 70px;

            min-height: 38px;

            padding:
                8px 14px;

            border-radius: 6px;

            color: #ffffff !important;

            text-decoration: none;

            font-size: 13px;

            font-weight: 600;

            line-height: 1.2;

            white-space: nowrap;

            transition:
                background .25s ease,
                transform .2s ease,
                box-shadow .25s ease;
        }


        .edit-btn {

            background: #16a34a;
        }


        .delete-btn {

            background: #dc2626;
        }


        .edit-btn:hover {

            background: #15803d;

            transform:
                translateY(-2px);

            box-shadow:
                0 5px 10px rgba(22, 163, 74, .25);
        }


        .delete-btn:hover {

            background: #b91c1c;

            transform:
                translateY(-2px);

            box-shadow:
                0 5px 10px rgba(220, 38, 38, .25);
        }


        .edit-btn:active,
        .delete-btn:active {

            transform:
                scale(.96);
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 900px) {

            .main-content {

                margin-left: 0;

                margin-top: 68px;

                width: 100%;

                min-height:
                    calc(100vh - 68px);

                padding:
                    25px 20px;
            }


            .page-header {

                padding:
                    22px 24px;

                margin-bottom: 25px;

                border-radius: 13px;
            }


            .top-bar {

                gap: 15px;
            }


            table {

                min-width: 620px;
            }


            th,
            td {

                padding:
                    14px;
            }

        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            .main-content {

                margin-top: 65px;

                min-height:
                    calc(100vh - 65px);

                padding:
                    20px 12px;
            }


            .page-header {

                padding:
                    20px 17px;

                margin-bottom: 20px;

                border-radius: 12px;
            }


            .page-header h1 {

                font-size: 24px;

                line-height: 1.3;
            }


            .page-header p {

                font-size: 13px;

                line-height: 1.6;

                margin-top: 7px;
            }


            .top-bar {

                flex-direction: column;

                align-items: stretch;

                gap: 12px;

                margin-bottom: 16px;
            }


            .top-bar h2 {

                font-size: 20px;
            }


            .btn {

                width: 100%;

                min-height: 44px;

                padding:
                    11px 15px;

                font-size: 13px;
            }


            .table-wrapper {

                border-radius: 11px;
            }


            table {

                min-width: 580px;
            }


            th {

                padding:
                    13px 10px;

                font-size: 12px;
            }


            td {

                padding:
                    13px 10px;

                font-size: 12px;
            }


            .edit-btn,
            .delete-btn {

                min-width: 65px;

                min-height: 36px;

                padding:
                    8px 10px;

                font-size: 11px;
            }

        }


        /* =====================================================
           SMALL MOBILE
        ===================================================== */

        @media (max-width: 400px) {

            .main-content {

                padding:
                    17px 9px;
            }


            .page-header {

                padding:
                    17px 14px;

                border-radius: 10px;
            }


            .page-header h1 {

                font-size: 21px;
            }


            .page-header p {

                font-size: 12px;
            }


            .top-bar h2 {

                font-size: 18px;
            }


            .btn {

                min-height: 42px;

                padding:
                    10px;

                font-size: 12px;
            }


            table {

                min-width: 540px;
            }


            th {

                padding:
                    11px 8px;

                font-size: 11px;
            }


            td {

                padding:
                    11px 8px;

                font-size: 11px;
            }


            .edit-btn,
            .delete-btn {

                min-width: 60px;

                min-height: 34px;

                padding:
                    7px 8px;

                font-size: 10px;
            }

        }


        /* =====================================================
           VERY SMALL PHONE
        ===================================================== */

        @media (max-width: 330px) {

            .main-content {

                padding:
                    15px 7px;
            }


            .page-header {

                padding:
                    15px 12px;
            }


            .page-header h1 {

                font-size: 19px;
            }


            .page-header p {

                font-size: 11px;
            }


            .top-bar h2 {

                font-size: 17px;
            }


            table {

                min-width: 520px;
            }


            th,
            td {

                padding:
                    10px 7px;
            }


            .btn {

                font-size: 11px;
            }

        }


        /* =====================================================
           TOUCH DEVICES
        ===================================================== */

        @media (hover: none) {

            .btn:hover {

                transform: none;

                box-shadow:
                    0 4px 10px rgba(37, 99, 235, .20);
            }


            .edit-btn:hover,
            .delete-btn:hover {

                transform: none;

                box-shadow: none;
            }


            tbody tr:hover {

                background:
                    transparent;
            }

        }


        /* =====================================================
           REDUCED MOTION
        ===================================================== */

        @media (prefers-reduced-motion: reduce) {

            .btn,
            .edit-btn,
            .delete-btn,
            tbody tr {

                transition: none;
            }

        }
    </style>

</head>


<body>


    <!-- =====================================================
         ADMIN NAVBAR
    ===================================================== -->

    <%- include("../../partials/admin/navbar") %>


        <!-- =====================================================
         ADMIN SIDEBAR
    ===================================================== -->

        <%- include("../../partials/admin/sidebar") %>


            <!-- =====================================================
         MAIN CONTENT
    ===================================================== -->

            <main class="main-content">


                <!-- PAGE HEADER -->

                <section class="page-header">

                    <h1>
                        Category Management
                    </h1>

                    <p>
                        Manage all product categories from here.
                    </p>

                </section>


                <!-- TOP BAR -->

                <div class="top-bar">

                    <h2>
                        All Categories
                    </h2>


                    <a href="/admin/category/add" class="btn">

                        <i class="fa-solid fa-plus"></i>

                        Add Category

                    </a>

                </div>


                <!-- =================================================
             CATEGORY TABLE
        ================================================= -->

                <div class="table-wrapper">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Category Name
                                </th>

                                <th>
                                    Edit
                                </th>

                                <th>
                                    Delete
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% category.forEach(function(cat){ %>

                                <tr>

                                    <td>

                                        <a href="/admin/product/category/<%= cat._id %>">

                                            <%= cat.name %>

                                        </a>

                                    </td>


                                    <td>

                                        <a href="/admin/category/edit/<%= cat._id %>" class="edit-btn">

                                            Edit

                                        </a>

                                    </td>


                                    <td>

                                        <a href="/admin/category/delete/<%= cat._id %>" class="delete-btn">

                                            Delete

                                        </a>

                                    </td>

                                </tr>

                                <% }) %>

                        </tbody>

                    </table>

                </div>


            </main>


            <!-- =====================================================
         ADMIN FOOTER
    ===================================================== -->

            <%- include("../../partials/admin/footer") %>


</body>

</html>