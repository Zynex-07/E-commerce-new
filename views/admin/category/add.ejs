<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Category</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f5f7fb;
            overflow-x: hidden;
        }

        /* ==========================
           Main Content
        ========================== */

        .main-content {
            margin-left: 260px;
            margin-top: 70px;
            min-height: 100vh;
            padding: 30px;
        }

        /* ==========================
           Page Header
        ========================== */

        .page-header {
            background: #fff;
            border-radius: 15px;
            padding: 25px 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .08);
            margin-bottom: 30px;
        }

        .page-header h1 {
            font-size: 32px;
            color: #111827;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #6b7280;
            font-size: 15px;
        }

        /* ==========================
           Card
        ========================== */

        .card {
            max-width: 650px;
            margin: auto;
            background: #fff;
            border-radius: 15px;
            padding: 35px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .08);
        }

        .card h2 {
            text-align: center;
            color: #111827;
            margin-bottom: 25px;
            font-size: 28px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #374151;
        }

        .form-control {
            width: 100%;
            padding: 14px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 15px;
            outline: none;
            transition: .3s;
        }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 6px rgba(37, 99, 235, .2);
        }

        .btn-group {
            display: flex;
            gap: 15px;
            margin-top: 25px;
        }

        .btn {
            flex: 1;
            padding: 14px;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            text-align: center;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: .3s;
        }

        .btn-save {
            background: #2563eb;
            color: #fff;
        }

        .btn-save:hover {
            background: #1d4ed8;
        }

        .btn-back {
            background: #6b7280;
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

        .btn-back:hover {
            background: #4b5563;
        }

        @media(max-width:768px) {

            .main-content {
                margin-left: 0;
                padding: 20px;
            }

            .card {
                padding: 25px;
            }

            .btn-group {
                flex-direction: column;
            }

            .page-header h1 {
                font-size: 28px;
            }
        }

        @media(max-width:480px) {

            .page-header {
                padding: 20px;
            }

            .card {
                padding: 20px;
            }

            .page-header h1 {
                font-size: 24px;
            }
        }
    </style>

</head>

<body>

    <%- include("../../partials/admin/navbar") %>
        <%- include("../../partials/admin/sidebar") %>

            <div class="main-content">

                <div class="page-header">
                    <h1>Add Category</h1>
                    <p>Create a new category for your products.</p>
                </div>

                <div class="card">

                    <h2>
                        <i class="fa-solid fa-folder-plus"></i>
                        Add Category
                    </h2>

                    <form action="/admin/category/add" method="POST">

                        <div class="form-group">

                            <label>Category Name</label>

                            <input type="text" name="name" class="form-control" placeholder="Enter Category Name"
                                required>

                        </div>

                        <div class="btn-group">

                            <button type="submit" class="btn btn-save">
                                <i class="fa-solid fa-plus"></i>
                                Add Category
                            </button>

                            <a href="/admin/category" class="btn btn-back">
                                <i class="fa-solid fa-arrow-left"></i>
                                Back
                            </a>

                        </div>

                    </form>

                </div>

            </div>

            <%- include("../../partials/admin/footer") %>

</body>

</html>