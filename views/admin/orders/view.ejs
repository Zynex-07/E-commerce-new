<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Details</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: #f4f6f9;
            padding: 40px;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        /* =========================
           BACK BUTTON
        ========================= */

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            text-decoration: none;
            background: #111827;
            color: white;
            padding: 10px 15px;
            border-radius: 8px;
            transition: .3s;
        }

        .back-btn:hover {
            background: #374151;
        }

        /* =========================
           TITLE
        ========================= */

        .title {
            text-align: center;
            margin-bottom: 30px;
            color: #111827;
            font-size: 35px;
        }

        /* =========================
           CARD
        ========================= */

        .card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .1);
            margin-bottom: 25px;
        }

        .card h2 {
            margin-bottom: 20px;
            color: #111827;
            font-size: 24px;
        }

        /* =========================
           ORDER INFO
        ========================= */

        .info {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .info-box {
            background: #f8fafc;
            padding: 15px;
            border-radius: 10px;
            min-width: 0;
        }

        .label {
            font-weight: bold;
            color: #374151;
            margin-bottom: 6px;
        }

        .info-box>div:last-child {
            color: #4b5563;
            word-break: break-word;
        }

        /* =========================
           PRODUCTS
        ========================= */

        .product {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px 0;
            border-bottom: 1px solid #e5e7eb;
        }

        .product:last-of-type {
            border-bottom: none;
        }

        .product img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
            flex-shrink: 0;
        }

        .product-details {
            flex: 1;
            min-width: 0;
        }

        .product-name {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #111827;
            word-break: break-word;
        }

        .price {
            color: #16a34a;
            font-weight: 600;
            margin-bottom: 8px;
            word-break: break-word;
        }

        .qty {
            color: #64748b;
            margin-bottom: 5px;
            word-break: break-word;
        }

        /* =========================
           TOTAL
        ========================= */

        .total-box {
            margin-top: 20px;
            text-align: right;
            font-size: 24px;
            font-weight: bold;
            color: #16a34a;
            word-break: break-word;
        }

        /* =========================
           STATUS FORM
        ========================= */

        .status-form {
            margin-top: 25px;
        }

        .status-form form {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        select {
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            width: 250px;
            max-width: 100%;
            outline: none;
            background: #fff;
            color: #111827;
        }

        select:focus {
            border-color: #2563eb;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            cursor: pointer;
            transition: .3s;
            font-weight: 600;
        }

        button:hover {
            background: #1d4ed8;
        }

        /* =========================
           LARGE TABLETS
        ========================= */

        @media (max-width: 1024px) {
            body {
                padding: 30px;
            }

            .title {
                font-size: 32px;
            }

            .card {
                padding: 22px;
            }
        }

        /* =========================
           TABLETS
        ========================= */

        @media (max-width: 768px) {
            body {
                padding: 20px;
            }

            .title {
                font-size: 28px;
                margin-bottom: 25px;
            }

            .card {
                padding: 20px;
                border-radius: 12px;
            }

            .info {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .product {
                gap: 15px;
            }

            .product img {
                width: 100px;
                height: 100px;
            }

            .product-name {
                font-size: 18px;
            }

            .total-box {
                font-size: 22px;
            }

            .status-form form {
                flex-direction: column;
                align-items: stretch;
            }

            select,
            button {
                width: 100%;
            }
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 480px) {
            body {
                padding: 15px;
            }

            .back-btn {
                padding: 9px 13px;
                font-size: 14px;
                margin-bottom: 18px;
            }

            .title {
                font-size: 24px;
                margin-bottom: 20px;
            }

            .card {
                padding: 16px;
                margin-bottom: 18px;
            }

            .card h2 {
                font-size: 21px;
                margin-bottom: 15px;
            }

            .info {
                gap: 12px;
            }

            .info-box {
                padding: 13px;
                font-size: 14px;
            }

            .label {
                font-size: 14px;
            }

            .product {
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 12px;
                padding: 18px 0;
            }

            .product img {
                width: 100px;
                height: 100px;
            }

            .product-details {
                width: 100%;
            }

            .product-name {
                font-size: 17px;
                margin-bottom: 8px;
            }

            .price,
            .qty {
                font-size: 14px;
            }

            .total-box {
                text-align: center;
                font-size: 20px;
                margin-top: 18px;
            }

            .status-form {
                margin-top: 20px;
            }

            select,
            button {
                padding: 12px;
                font-size: 14px;
            }
        }

        /* =========================
           SMALL MOBILE
        ========================= */

        @media (max-width: 360px) {
            body {
                padding: 12px;
            }

            .title {
                font-size: 22px;
            }

            .card {
                padding: 13px;
            }

            .card h2 {
                font-size: 19px;
            }

            .product img {
                width: 90px;
                height: 90px;
            }

            .product-name {
                font-size: 16px;
            }

            .total-box {
                font-size: 18px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <a href="/admin/order" class="back-btn">
            Back To Orders
        </a>

        <h1 class="title">Order Details</h1>

        <!-- Order Information -->
        <div class="card">

            <div class="info">

                <div class="info-box">
                    <div class="label">Customer Name</div>
                    <div>
                        <%= order.userName %>
                    </div>
                </div>

                <div class="info-box">
                    <div class="label">Customer Email</div>
                    <div>
                        <%= order.userEmail %>
                    </div>
                </div>

                <div class="info-box">
                    <div class="label">Order Status</div>
                    <div>
                        <%= order.status %>
                    </div>
                </div>

                <div class="info-box">
                    <div class="label">Order Date</div>
                    <div>
                        <%= new Date(order.createdAt).toDateString() %>
                    </div>
                </div>

                <div class="info-box">
                    <div class="label">Payment Method</div>
                    <div>
                        <%= order.paymentMethod || 'N/A' %>
                    </div>
                </div>

                <div class="info-box">
                    <div class="label">Payment ID</div>
                    <div style="font-family:monospace;word-break:break-all">
                        <%= order.paymentId || 'N/A' %>
                    </div>
                </div>

            </div>

        </div>

        <% if(order.cancellationStatus === 'Pending Approval'){ %>
        <!-- Cancellation Request Alert Card -->
        <div class="card" style="border-left:5px solid #eab308;background:#fefce8">
            <h2 style="color:#854d0e;display:flex;align-items:center;gap:10px">
                ⏳ Customer Cancellation Request (Pending Approval)
            </h2>
            <div style="margin:12px 0 18px;font-size:14px;color:#713f12;line-height:1.6">
                <div><strong>Requested At:</strong> <%= order.cancellationRequest?.requestedAt ? new Date(order.cancellationRequest.requestedAt).toLocaleString() : 'N/A' %></div>
                <div style="margin-top:6px"><strong>Customer Reason:</strong> <%= order.cancellationRequest?.reason || 'No specific reason provided' %></div>
                <div style="margin-top:6px"><strong>Order Total:</strong> ₹<%= order.total %> (Full refund will be initiated to <%= order.paymentId || 'original payment method' %>)</div>
            </div>
            <div style="display:flex;gap:12px;flex-wrap:wrap">
                <form method="POST" action="/admin/order/approve-cancellation/<%= order._id %>" onsubmit="return confirm('Approve cancellation and initiate FULL refund of ₹<%= order.total %> via Razorpay?')">
                    <button type="submit" style="background:#16a34a;padding:12px 20px;border-radius:8px;border:none;color:#fff;font-weight:700;cursor:pointer">
                        ✓ Approve & Issue Full Refund (₹<%= order.total %>)
                    </button>
                </form>
                <form method="POST" action="/admin/order/reject-cancellation/<%= order._id %>" style="display:flex;gap:8px;flex-wrap:wrap" onsubmit="return confirm('Reject this cancellation request?')">
                    <input type="text" name="reason" placeholder="Reason for rejection..." style="padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;min-width:240px">
                    <button type="submit" style="background:#dc2626;padding:12px 20px;border-radius:8px;border:none;color:#fff;font-weight:700;cursor:pointer">
                        ✕ Reject Request
                    </button>
                </form>
            </div>
        </div>
        <% } else if(order.cancellationStatus === 'Rejected'){ %>
        <!-- Rejected Request Card -->
        <div class="card" style="border-left:5px solid #ef4444;background:#fef2f2">
            <h2 style="color:#991b1b">❌ Cancellation Request Rejected</h2>
            <p style="margin:8px 0;font-size:14px;color:#7f1d1d">
                <strong>Reviewed:</strong> <%= order.cancellationRequest?.reviewedAt ? new Date(order.cancellationRequest.reviewedAt).toLocaleString() : 'N/A' %> by <%= order.cancellationRequest?.reviewedBy || 'Admin' %><br>
                <strong>Reason:</strong> <%= order.cancellationRequest?.rejectionReason || 'N/A' %>
            </p>
        </div>
        <% } %>

        <% if(order.refundStatus === 'Requires Reconciliation'){ %>
        <!-- Requires Reconciliation Warning Card -->
        <div class="card" style="border-left:5px solid #f59e0b;background:#fffbeb">
            <h2 style="color:#b45309">⚠️ Refund State Uncertain (Reconciliation Required)</h2>
            <p style="margin:8px 0;font-size:14px;color:#92400e;line-height:1.6">
                A previous refund attempt encountered an uncertain network outcome or timeout.<br>
                <strong>Reason:</strong> <%= order.refundError || order.reconciliationReason || 'Gateway timeout' %><br>
                <strong>Internal Reference:</strong> <code style="background:#fef3c7;padding:2px 6px;border-radius:4px"><%= order.internalRefundRef || 'N/A' %></code>
            </p>
            <form method="POST" action="/admin/order/reconcile-refund/<%= order._id %>" style="margin-top:12px">
                <button type="submit" style="background:#d97706;padding:10px 20px;border-radius:8px;border:none;color:#fff;font-weight:700;cursor:pointer">
                    🔍 Reconcile with Razorpay Now
                </button>
            </form>
        </div>
        <% } %>

        <% if(order.refund && order.refund.refundId){ %>
        <!-- Refund Information Card -->
        <div class="card" style="border-left:5px solid #22c55e;background:#f0fdf4">
            <h2 style="color:#166534">✓ Razorpay Full Refund Processed</h2>
            <div class="info" style="margin-top:14px">
                <div class="info-box">
                    <div class="label">Refund ID</div>
                    <div style="font-family:monospace;font-weight:600;color:#166534"><%= order.refund.refundId %></div>
                </div>
                <div class="info-box">
                    <div class="label">Refund Amount</div>
                    <div style="font-weight:700;color:#166534">₹<%= order.refund.amount %> (Paise: <%= order.refund.amountPaise %>)</div>
                </div>
                <div class="info-box">
                    <div class="label">Refund Status</div>
                    <div><span style="background:#dcfce7;color:#166534;padding:4px 8px;border-radius:6px;font-weight:700"><%= order.refund.status %></span></div>
                </div>
                <div class="info-box">
                    <div class="label">Initiated Date</div>
                    <div><%= order.refund.initiatedAt ? new Date(order.refund.initiatedAt).toLocaleString() : 'N/A' %></div>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Products -->
        <div class="card">

            <h2>Products</h2>

            <% order.products.forEach(product=> { %>

                <div class="product">

                    <% if(product.images){ %>

                        <img src="<%= product.images %>" alt="Product image">

                        <% } %>

                            <div class="product-details">

                                <div class="product-name">
                                    <%= product.name %>
                                </div>

                                <div class="price">
                                    Price : ₹ <%= product.price %>
                                </div>

                                <div class="qty">
                                    Quantity : <%= product.qty %>
                                </div>

                                <div class="qty">
                                    Product Total : ₹ <%= product.total %>
                                </div>

                            </div>

                </div>

                <% }) %>

                    <!-- Grand Total -->
                    <div class="total-box">
                        Grand Total : ₹ <%= order.total %>
                    </div>

                    <!-- Status Update -->
                    <div class="status-form">

                        <form method="POST" action="/admin/order/status/<%= order._id %>">

                            <select name="status">

                                <option value="Pending" <%=order.status==="Pending" ? "selected" : "" %>>
                                    Pending
                                </option>

                                <option value="Processing" <%=order.status==="Processing" ? "selected" : "" %>>
                                    Processing
                                </option>

                                <option value="Shipped" <%=order.status==="Shipped" ? "selected" : "" %>>
                                    Shipped
                                </option>

                                <option value="Delivered" <%=order.status==="Delivered" ? "selected" : "" %>>
                                    Delivered
                                </option>

                                <option value="Cancelled" <%=order.status==="Cancelled" ? "selected" : "" %>>
                                    Cancelled
                                </option>

                            </select>

                            <button type="submit">
                                Update Status
                            </button>

                        </form>

                    </div>

        </div>

    </div>

</body>

</html>