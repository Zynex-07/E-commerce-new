<div class="sidebar" id="sidebar">

    <div class="sidebar-logo">
        <h2>Admin Panel</h2>
    </div>

    <ul>

        <li>
            <a href="/admin/dashboard">
                <i class="fa-solid fa-house"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li>
            <a href="/admin/category">
                <i class="fa-solid fa-folder"></i>
                <span>Categories</span>
            </a>
        </li>

        <li>
            <a href="/admin/product">
                <i class="fa-solid fa-box"></i>
                <span>Products</span>
            </a>
        </li>

        <li>
            <a href="/admin/order">
                <i class="fa-solid fa-cart-shopping"></i>
                <span>Orders</span>
            </a>
        </li>

        <li>
            <a href="/admin/user">
                <i class="fa-solid fa-users"></i>
                <span>Users</span>
            </a>
        </li>

    </ul>

</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<style>
    .sidebar {
        position: fixed;
        top: 70px;
        left: 0;
        width: 260px;
        height: calc(100vh - 70px);
        background: #0f172a;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        transition: .35s;
        z-index: 999;
    }

    .sidebar-logo {
        padding: 28px 25px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, .08);
    }

    .sidebar-logo h2 {
        color: #fff;
        font-size: 24px;
        font-weight: 700;
        margin: 0;
        letter-spacing: .5px;
    }

    .sidebar ul {
        list-style: none;
        padding: 20px 15px;
    }

    .sidebar li {
        margin-bottom: 8px;
    }

    .sidebar a {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 18px;
        color: #cbd5e1;
        text-decoration: none;
        border-radius: 12px;
        transition: .3s;
        font-size: 17px;
        font-weight: 500;
    }

    .sidebar a i {
        width: 22px;
        text-align: center;
        font-size: 18px;
    }

    .sidebar a:hover {
        background: #2563eb;
        color: #fff;
        transform: translateX(5px);
    }

    .sidebar a.active {
        background: #2563eb;
        color: #fff;
        box-shadow: 0 10px 20px rgba(37, 99, 235, .35);
    }

    .sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 20px;
    }

    /* Overlay */
    .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .45);
        z-index: 998;
    }

    /* Mobile */

    @media (max-width:768px) {

        .sidebar {
            left: -260px;
        }

        .sidebar.active {
            left: 0;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .45);
            z-index: 998;
        }

        .sidebar-overlay.active {
            display: block;
        }
    }
</style>