<div class="admin-navbar">

    <!-- Menu Button -->
    <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu" aria-expanded="false">

        <i class="fa-solid fa-bars"></i>

    </button>


    <!-- Logo -->
    <div class="navbar-logo">

        <img src="/images/logo1.png" alt="Logo">

        <h2>
            Admin Panel
        </h2>

    </div>


    <!-- Right Side -->
    <div class="navbar-right">

        <span class="admin-name">
            Welcome, Admin
        </span>

    </div>

</div>


<style>
    /* =====================================================
       RESET
    ===================================================== */

    .admin-navbar,
    .admin-navbar * {
        box-sizing: border-box;
    }


    /* =====================================================
       NAVBAR
    ===================================================== */

    .admin-navbar {

        position: fixed;

        top: 0;
        left: 0;

        width: 100%;
        height: 70px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        padding: 0 25px;

        background: #ffffff;

        border-bottom:
            1px solid #e5e7eb;

        box-shadow:
            0 2px 10px rgba(0, 0, 0, .08);

        z-index: 1000;

        overflow: hidden;
    }


    /* =====================================================
       MENU BUTTON
    ===================================================== */

    .menu-btn {

        display: none;

        width: 44px;
        height: 44px;

        flex-shrink: 0;

        align-items: center;
        justify-content: center;

        border: none;

        outline: none;

        background: transparent;

        color: #111827;

        font-size: 23px;

        border-radius: 8px;

        cursor: pointer;

        transition:
            background .25s ease,
            transform .2s ease;
    }


    .menu-btn:hover {

        background:
            #f1f5f9;
    }


    .menu-btn:active {

        transform:
            scale(.94);
    }


    /* =====================================================
       LOGO
    ===================================================== */

    .navbar-logo {

        min-width: 0;

        display: flex;

        align-items: center;

        gap: 12px;
    }


    .navbar-logo img {

        width: 42px;
        height: 42px;

        flex-shrink: 0;

        display: block;

        object-fit: cover;

        border-radius: 50%;
    }


    .navbar-logo h2 {

        margin: 0;

        color: #111827;

        font-size: 24px;

        font-weight: 700;

        line-height: 1.2;

        white-space: nowrap;

        overflow: hidden;

        text-overflow: ellipsis;
    }


    /* =====================================================
       RIGHT SIDE
    ===================================================== */

    .navbar-right {

        min-width: 0;

        display: flex;

        align-items: center;

        justify-content: flex-end;
    }


    .admin-name {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        min-height: 40px;

        padding:
            9px 18px;

        background:
            #2563eb;

        color: #ffffff;

        border-radius: 30px;

        font-size: 14px;

        font-weight: 500;

        line-height: 1.3;

        white-space: nowrap;
    }


    /* =====================================================
       TABLET
    ===================================================== */

    @media (max-width: 900px) {

        .admin-navbar {

            height: 68px;

            padding:
                0 18px;
        }


        .menu-btn {

            display: inline-flex;
        }


        .navbar-logo {

            flex: 1;

            justify-content: center;

            gap: 9px;
        }


        .navbar-logo img {

            width: 40px;
            height: 40px;
        }


        .navbar-logo h2 {

            font-size: 21px;
        }


        .admin-name {

            font-size: 13px;

            padding:
                8px 14px;
        }

    }


    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 600px) {

        .admin-navbar {

            height: 65px;

            padding:
                0 12px;
        }


        .menu-btn {

            width: 42px;
            height: 42px;

            font-size: 22px;
        }


        .navbar-logo {

            gap: 8px;

            justify-content: center;
        }


        .navbar-logo img {

            width: 37px;
            height: 37px;
        }


        .navbar-logo h2 {

            font-size: 18px;
        }


        .navbar-right {

            width: 42px;

            flex-shrink: 0;
        }


        .admin-name {

            display: none;
        }

    }


    /* =====================================================
       SMALL MOBILE
    ===================================================== */

    @media (max-width: 400px) {

        .admin-navbar {

            height: 62px;

            padding:
                0 9px;
        }


        .menu-btn {

            width: 40px;
            height: 40px;

            font-size: 21px;
        }


        .navbar-logo {

            gap: 7px;
        }


        .navbar-logo img {

            width: 34px;
            height: 34px;
        }


        .navbar-logo h2 {

            font-size: 16px;
        }


        .navbar-right {

            width: 40px;
        }

    }


    /* =====================================================
       VERY SMALL MOBILE
    ===================================================== */

    @media (max-width: 330px) {

        .admin-navbar {

            padding:
                0 7px;
        }


        .menu-btn {

            width: 38px;
            height: 38px;

            font-size: 20px;
        }


        .navbar-logo {

            gap: 5px;
        }


        .navbar-logo img {

            width: 31px;
            height: 31px;
        }


        .navbar-logo h2 {

            font-size: 14px;
        }


        .navbar-right {

            width: 38px;
        }

    }


    /* =====================================================
       TOUCH DEVICES
    ===================================================== */

    @media (hover: none) {

        .menu-btn:hover {

            background: transparent;
        }

    }


    /* =====================================================
       REDUCED MOTION
    ===================================================== */

    @media (prefers-reduced-motion: reduce) {

        .menu-btn {

            transition: none;
        }

    }
</style>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const menuBtn =
                document.getElementById("menuBtn");

            const sidebar =
                document.getElementById("sidebar");

            const overlay =
                document.getElementById("sidebarOverlay");


            /* =============================================
               MENU BUTTON
            ============================================= */

            if (menuBtn && sidebar) {

                menuBtn.addEventListener(
                    "click",
                    function () {

                        const isOpen =
                            sidebar.classList.toggle(
                                "active"
                            );


                        if (overlay) {

                            overlay.classList.toggle(
                                "active"
                            );

                        }


                        menuBtn.setAttribute(
                            "aria-expanded",
                            isOpen
                                ? "true"
                                : "false"
                        );

                    }
                );

            }


            /* =============================================
               OVERLAY CLOSE
            ============================================= */

            if (overlay) {

                overlay.addEventListener(
                    "click",
                    function () {

                        sidebar.classList.remove(
                            "active"
                        );


                        overlay.classList.remove(
                            "active"
                        );


                        if (menuBtn) {

                            menuBtn.setAttribute(
                                "aria-expanded",
                                "false"
                            );

                        }

                    }
                );

            }


            /* =============================================
               SIDEBAR LINK CLICK
            ============================================= */

            if (sidebar) {

                sidebar
                    .querySelectorAll("a")
                    .forEach(function (link) {

                        link.addEventListener(
                            "click",
                            function () {

                                if (
                                    window.innerWidth <= 900
                                ) {

                                    sidebar.classList.remove(
                                        "active"
                                    );


                                    if (overlay) {

                                        overlay.classList.remove(
                                            "active"
                                        );

                                    }


                                    if (menuBtn) {

                                        menuBtn.setAttribute(
                                            "aria-expanded",
                                            "false"
                                        );

                                    }

                                }

                            }
                        );

                    });

            }


            /* =============================================
               DESKTOP RESET
            ============================================= */

            window.addEventListener(
                "resize",
                function () {

                    if (
                        window.innerWidth > 900
                    ) {

                        if (sidebar) {

                            sidebar.classList.remove(
                                "active"
                            );

                        }


                        if (overlay) {

                            overlay.classList.remove(
                                "active"
                            );

                        }


                        if (menuBtn) {

                            menuBtn.setAttribute(
                                "aria-expanded",
                                "false"
                            );

                        }

                    }

                }
            );

        }
    );

</script>