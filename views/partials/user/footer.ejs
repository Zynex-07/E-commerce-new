<div class="toast" id="globalToast"></div>
<script>
async function addToCart(id,qty=1){try{const r=await fetch('/cart/add/'+id+'?qty='+qty+'&ajax=1',{headers:{'X-Requested-With':'XMLHttpRequest'}});const d=await r.json();if(!d.ok){if(r.status===401){window.location.href='/auth/login';return}throw new Error(d.message||'Unable to add to cart')}document.querySelectorAll('.cart-count').forEach(x=>x.textContent=d.cartCount);const t=document.getElementById('globalToast');if(t){t.textContent='✓ Added to cart';t.style.display='block';clearTimeout(window.gToast);window.gToast=setTimeout(()=>t.style.display='none',2200)}}catch(e){const t=document.getElementById('globalToast');if(t){t.textContent=e.message;t.style.display='block';clearTimeout(window.gToast);window.gToast=setTimeout(()=>t.style.display='none',2500)}}}
async function buyNow(){const qtyEl=document.getElementById('qty');const id='<%= typeof product !== "undefined" ? product._id : "" %>';const qty=Number(qtyEl?.value||1);if(id){const r=await fetch('/cart/add/'+id+'?qty='+qty+'&ajax=1',{headers:{'X-Requested-With':'XMLHttpRequest'}});const d=await r.json();if(d.ok){window.location.href='/cart'}else if(r.status===401){window.location.href='/auth/login'}else{alert(d.message||'Unable to add to cart')}}}
</script>
