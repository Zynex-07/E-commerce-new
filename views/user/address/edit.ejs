<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Add or edit your delivery address"><title><%= user && user.address ? 'Edit Address' : 'Add Address' %> — AAK Clothing</title>
  <link rel="stylesheet" href="/style/storefront.css">
  <style>
    .edit-address-page{min-height:calc(100vh - 130px);background:#f8fafc;padding:38px 0 70px}.edit-head{margin-bottom:22px}.edit-head h1{font-size:34px;margin:5px 0}.edit-head p{color:#667085}.address-form-card{background:#fff;border:1px solid #e4e7ec;border-radius:18px;padding:26px;box-shadow:0 8px 25px rgba(16,24,40,.06)}.form-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:28px}.form-title{font-size:18px;margin-bottom:18px}.form-group{margin-bottom:16px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-group label{display:block;font-size:12px;font-weight:800;color:#344054;margin-bottom:7px}.form-group input,.form-group textarea{width:100%;border:1px solid #d0d5dd;border-radius:10px;padding:12px 13px;background:#fff;color:#101828;font:inherit;font-size:13px;outline:none}.form-group textarea{min-height:115px;resize:vertical}.form-group input:focus,.form-group textarea:focus{border-color:#175cd3;box-shadow:0 0 0 3px rgba(23,92,211,.1)}.error-box{background:#fef3f2;color:#b42318;border:1px solid #fecdca;padding:11px 13px;border-radius:10px;font-size:12px;margin-bottom:17px}.location-panel{border:1px solid #eaecf0;border-radius:14px;padding:18px;background:#fcfcfd}.location-panel h2{font-size:17px;margin-bottom:7px}.location-panel p{font-size:12px;color:#667085;line-height:1.6;margin-bottom:14px}.location-btn{width:100%;min-height:45px;border:1px solid #d0d5dd;border-radius:10px;background:#fff;color:#344054;font-weight:800;cursor:pointer}.location-btn:hover{background:#f9fafb}.coords{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:12px}.coords input{background:#f2f4f7}.form-actions{display:flex;gap:10px;margin-top:22px}.btn{min-height:45px;padding:11px 18px;border-radius:10px;border:1px solid #d0d5dd;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;cursor:pointer;background:#fff;color:#344054}.btn.primary{background:#101828;color:#fff;border-color:#101828}.btn.green{background:#12b76a;color:#fff;border-color:#12b76a}.hint{font-size:11px;color:#667085;margin-top:8px;line-height:1.5}
    @media(max-width:850px){.form-layout{grid-template-columns:1fr}}
    @media(max-width:600px){.edit-address-page{padding:25px 0 55px}.edit-head h1{font-size:28px}.address-form-card{padding:17px;border-radius:14px}.form-row{grid-template-columns:1fr}.form-actions{display:grid;grid-template-columns:1fr}.btn{width:100%}.coords{grid-template-columns:1fr}}
  </style>
</head>
<body>
<%- include('../../partials/user/navbar') %>
<main class="edit-address-page"><div class="shell">
  <div class="edit-head"><div class="eyebrow">Delivery details</div><h1><%= user && user.address ? 'Edit Address' : 'Add Address' %></h1><p>Enter the address where you want your order delivered.</p></div>
  <section class="address-form-card">
    <% if(error){ %><div class="error-box"><%= error %></div><% } %>
    <div class="form-layout">
      <div>
        <h2 class="form-title">Address Information</h2>
        <form action="/address/save" method="POST" id="addressForm">
          <div class="form-row"><div class="form-group"><label for="mobile">Mobile Number</label><input id="mobile" name="mobile" type="tel" inputmode="numeric" maxlength="10" pattern="[0-9]{10}" value="<%= user?.address?.mobile || '' %>" placeholder="10-digit mobile" required></div><div class="form-group"><label for="pincode">Pincode</label><input id="pincode" name="pincode" type="tel" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" value="<%= user?.address?.pincode || '' %>" placeholder="6-digit pincode" required></div></div>
          <div class="form-group"><label for="address">Full Address</label><textarea id="address" name="address" placeholder="House / Flat, street, area, landmark" required><%= user?.address?.address || '' %></textarea></div>
          <div class="form-row"><div class="form-group"><label for="city">City</label><input id="city" name="city" value="<%= user?.address?.city || '' %>" placeholder="City" required></div><div class="form-group"><label for="state">State</label><input id="state" name="state" value="<%= user?.address?.state || '' %>" placeholder="State" required></div></div>
          <input type="hidden" id="latitude" name="latitude" value="<%= user?.address?.latitude ?? '' %>"><input type="hidden" id="longitude" name="longitude" value="<%= user?.address?.longitude ?? '' %>">
          <div class="form-actions"><button class="btn primary" type="submit">Save Address</button><a class="btn" href="/address">Cancel</a></div>
        </form>
      </div>
      <div class="location-panel"><h2>📍 Save Your Location</h2><p>Allow browser location access to save your current latitude and longitude. This is optional and helps show the saved point on the address page.</p><button class="location-btn" type="button" onclick="useMyLocation()">Use My Current Location</button><div class="coords"><input id="latPreview" value="<%= user?.address?.latitude ?? '' %>" placeholder="Latitude" readonly><input id="lngPreview" value="<%= user?.address?.longitude ?? '' %>" placeholder="Longitude" readonly></div><div class="hint" id="locationMessage">Location is optional. Your written delivery address is required.</div></div>
    </div>
  </section>
</div></main>
<%- include('../../partials/user/footer') %>
<script>
function useMyLocation(){const msg=document.getElementById('locationMessage');if(!navigator.geolocation){msg.textContent='Geolocation is not supported by this browser.';return}msg.textContent='Requesting your location…';navigator.geolocation.getCurrentPosition(pos=>{const lat=pos.coords.latitude.toFixed(6),lng=pos.coords.longitude.toFixed(6);document.getElementById('latitude').value=lat;document.getElementById('longitude').value=lng;document.getElementById('latPreview').value=lat;document.getElementById('lngPreview').value=lng;msg.textContent='Location captured. Click Save Address to store it.'},err=>{const messages={1:'Location permission was denied.',2:'Location is currently unavailable.',3:'Location request timed out.'};msg.textContent=messages[err.code]||'Unable to get your location.'},{enableHighAccuracy:true,timeout:10000,maximumAge:60000})}
</script>
</body></html>
