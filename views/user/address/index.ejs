<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Manage your delivery address"><title>My Address — IV Store</title>
  <link rel="stylesheet" href="/style/storefront.css">
  <style>
    .address-page{min-height:calc(100vh - 130px);background:#f8fafc;padding:38px 0 70px}.address-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px}.address-head h1{font-size:34px;margin:5px 0}.address-head p{color:#667085;margin:0}.address-card{background:#fff;border:1px solid #e4e7ec;border-radius:18px;padding:25px;box-shadow:0 8px 25px rgba(16,24,40,.06)}.address-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px}.details h2,.map-card h2{font-size:18px;margin-bottom:18px}.detail-row{display:grid;grid-template-columns:110px minmax(0,1fr);gap:15px;padding:13px 0;border-bottom:1px solid #eaecf0}.detail-row:last-child{border-bottom:0}.detail-label{font-size:12px;color:#667085;font-weight:700}.detail-value{font-size:14px;color:#101828;line-height:1.6;overflow-wrap:anywhere}.map-box{width:100%;height:330px;border-radius:14px;overflow:hidden;border:1px solid #d0d5dd;background:#f2f4f7}.map-box iframe{width:100%;height:100%;border:0}.no-map{height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:25px;color:#667085;font-size:13px}.address-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.btn{min-height:44px;padding:11px 17px;border-radius:10px;text-decoration:none;border:1px solid #d0d5dd;background:#fff;color:#344054;font-weight:800;font-size:12px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}.btn.primary{background:#101828;color:#fff;border-color:#101828}.btn.danger{color:#b42318;border-color:#fecdca;background:#fff}.empty-address{background:#fff;border:1px solid #e4e7ec;border-radius:18px;text-align:center;padding:70px 20px}.empty-address .emoji{font-size:48px}.empty-address h2{margin:12px 0 6px}.empty-address p{color:#667085}.empty-address .btn{margin-top:18px}.location-note{margin-top:12px;color:#667085;font-size:11px;line-height:1.5}
    @media(max-width:800px){.address-grid{grid-template-columns:1fr}.address-head{align-items:flex-start;flex-direction:column}}
    @media(max-width:600px){.address-page{padding:25px 0 55px}.address-head h1{font-size:28px}.address-card{padding:17px;border-radius:14px}.detail-row{grid-template-columns:1fr;gap:4px}.map-box{height:260px}.address-actions{display:grid;grid-template-columns:1fr}.btn{width:100%}}
  </style>
</head>
<body>
<%- include('../../partials/user/navbar') %>
<main class="address-page"><div class="shell">
  <div class="address-head"><div><div class="eyebrow">Delivery</div><h1>My Address</h1><p>Keep your delivery details ready for a faster checkout.</p></div><a class="text-link" href="/cart">← Back to cart</a></div>
  <% if(user && user.address && user.address.address){ %>
    <section class="address-card">
      <div class="address-grid">
        <div><h2>Saved Address</h2>
          <div class="detail-row"><span class="detail-label">Mobile</span><span class="detail-value"><%= user.address.mobile || '—' %></span></div>
          <div class="detail-row"><span class="detail-label">Address</span><span class="detail-value"><%= user.address.address || '—' %></span></div>
          <div class="detail-row"><span class="detail-label">City</span><span class="detail-value"><%= user.address.city || '—' %></span></div>
          <div class="detail-row"><span class="detail-label">State</span><span class="detail-value"><%= user.address.state || '—' %></span></div>
          <div class="detail-row"><span class="detail-label">Pincode</span><span class="detail-value"><%= user.address.pincode || '—' %></span></div>
          <div class="address-actions"><a class="btn primary" href="/address/edit">Edit Address</a><form action="/address/delete" method="POST" onsubmit="return confirm('Delete your saved address?')"><button class="btn danger" type="submit">Delete Address</button></form></div>
        </div>
        <div class="map-card"><h2>Saved Location</h2><div class="map-box">
          <% if(Number.isFinite(Number(user.address.latitude)) && Number.isFinite(Number(user.address.longitude))){ const lat=Number(user.address.latitude); const lng=Number(user.address.longitude); %>
            <iframe loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=<%= lng-0.01 %>%2C<%= lat-0.01 %>%2C<%= lng+0.01 %>%2C<%= lat+0.01 %>&layer=mapnik&marker=<%= lat %>%2C<%= lng %>" title="Saved delivery location"></iframe>
          <% }else{ %><div class="no-map">No map location was saved.<br>Edit your address and use “Use my location”.</div><% } %>
        </div><p class="location-note">Map is shown only when latitude and longitude were saved. Your address text remains the source for delivery.</p></div>
      </div>
    </section>
  <% }else{ %>
    <section class="empty-address"><div class="emoji">📍</div><h2>No Address Saved</h2><p>Add a delivery address before placing a payment.</p><a class="btn primary" href="/address/edit">Add Address</a></section>
  <% } %>
</div></main>
<%- include('../../partials/user/footer') %>
</body></html>
