<!DOCTYPE html>
<html>

<head>
    <title>My Address</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            min-height: 100vh;
            padding-bottom: 80px;
            /* Space for fixed footer */
        }

        /* ===========================
           NAVBAR
        =========================== */
        .navbar {
            width: 100%;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo img {
            width: 130px;
            height: 55px;
            object-fit: contain;
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, .4);
            color: #fff;
            width: 45px;
            height: 40px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 26px;
            justify-content: center;
            align-items: center;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 15px;
            padding: 10px 15px;
            border-radius: 8px;
            transition: .3s;
        }

        .nav-links a:hover {
            color: #fbbf24;
        }

        .search-form {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .search-form input {
            width: 220px;
            padding: 10px;
            border: none;
            outline: none;
            border-radius: 8px;
        }

        .search-form button {
            padding: 10px 18px;
            border: none;
            border-radius: 8px;
            background: #f59e0b;
            color: #fff;
            cursor: pointer;
            font-weight: 600;
        }

        .cart-btn {
            background: linear-gradient(90deg, #10b981, #059669);
            padding: 10px 18px;
            border-radius: 8px;
            color: #fff !important;
            font-weight: 600;
        }

        /* ===========================
           ADDRESS CONTAINER
        =========================== */
        .container {
            width: 92%;
            max-width: 900px;
            margin: 40px auto;
        }

        .card {
            background: #fff;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);
        }

        h1 {
            text-align: center;
            color: #0f172a;
            margin-bottom: 30px;
            font-size: 38px;
        }

        .info {
            margin-bottom: 20px;
            font-size: 18px;
            color: #4b5563;
            line-height: 1.6;
        }

        .label {
            font-weight: 600;
            color: #111827;
            display: inline-block;
            width: 100px;
            /* Aligns text properly */
        }

        /* ===========================
           BUTTONS
        =========================== */
        .btn-group {
            margin-top: 30px;
            display: flex;
            gap: 15px;
        }

        .btn {
            flex: 1;
            /* Equal width buttons */
            padding: 14px 22px;
            text-decoration: none;
            border-radius: 8px;
            color: #fff;
            font-weight: 600;
            text-align: center;
            transition: .3s;
            border: none;
            font-size: 16px;
        }

        .edit-btn {
            background: linear-gradient(90deg, #2563eb, #1d4ed8);
        }

        .edit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.4);
        }

        .cart-btn-address {
            background: linear-gradient(90deg, #f59e0b, #ef4444);
        }

        .cart-btn-address:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(239, 68, 68, 0.4);
        }

        .empty {
            text-align: center;
            font-size: 22px;
            color: #64748b;
            margin: 40px 0;
        }

        /* ===========================
           MAP
        =========================== */
        #map {
            width: 100%;
            height: 400px;
            border-radius: 12px;
            margin-top: 20px;
            border: 2px solid #e2e8f0;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        .location-title {
            margin-top: 40px;
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            border-bottom: 2px dashed #e2e8f0;
            padding-bottom: 10px;
        }

        /* ===========================
           RESPONSIVE TABLET
        =========================== */
        @media(max-width:992px) {
            .menu-toggle {
                display: flex;
            }

            .navbar {
                flex-wrap: wrap;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: center;
                gap: 15px;
                margin-top: 20px;
                padding-top: 20px;
                border-top: 1px solid rgba(255, 255, 255, .15);
            }

            .nav-links.active {
                display: flex;
            }

            .search-form {
                width: 100%;
                flex-direction: column;
            }

            .search-form input,
            .search-form button {
                width: 100%;
            }
        }

        /* ===========================
           RESPONSIVE MOBILE
        =========================== */
        @media(max-width:768px) {
            .container {
                margin: 20px auto;
                width: 95%;
            }

            .card {
                padding: 25px 20px;
            }

            h1 {
                font-size: 30px;
            }

            .info {
                font-size: 16px;
            }

            .label {
                width: 80px;
            }

            .btn-group {
                flex-direction: column;
                gap: 12px;
            }

            .btn {
                width: 100%;
            }

            .location-title {
                font-size: 20px;
                margin-top: 30px;
            }

            #map {
                height: 300px;
            }
        }
    </style>
</head>

<body>
    <%- include("../../partials/user/navbar") %>

        <div class="container">
            <div class="card">
                <h1>My Address</h1>

                <% if(user && user.address){ %>
                    <div class="info">
                        <span class="label">Mobile:</span>
                        <%= user.address.mobile %>
                    </div>
                    <div class="info">
                        <span class="label">Address:</span>
                        <%= user.address.address %>
                    </div>
                    <div class="info">
                        <span class="label">City:</span>
                        <%= user.address.city %>
                    </div>
                    <div class="info">
                        <span class="label">State:</span>
                        <%= user.address.state %>
                    </div>
                    <div class="info">
                        <span class="label">Pincode:</span>
                        <%= user.address.pincode %>
                    </div>

                    <h2 class="location-title">Saved Location</h2>
                    <div id="map"></div>

                    <div class="btn-group">
                        <a href="/address/edit" class="btn edit-btn">Edit Address</a>
                        <a href="/cart" class="btn cart-btn-address">Back To Cart</a>
                    </div>

                    <% } else { %>
                        <div class="empty">
                            No Address Found. Please add one to continue.
                        </div>
                        <div class="btn-group">
                            <a href="/address/edit" class="btn edit-btn">Add Address</a>
                            <a href="/cart" class="btn cart-btn-address">Back To Cart</a>
                        </div>
                        <% } %>
            </div>
        </div>

        <%- include("../../partials/user/footer") %>

            <% if(user && user.address){ %>
                <script>
                    function initMap() {
                        const lat = Number("<%= user.address.latitude || 21.1702 %>");
                        const lng = Number("<%= user.address.longitude || 72.8311 %>");

                        const location = { lat: lat, lng: lng };

                        const map = new google.maps.Map(document.getElementById("map"), {
                            zoom: 15,
                            center: location
                        });

                        new google.maps.Marker({
                            position: location,
                            map: map,
                        });
                    }
                </script>
                <script async defer
                    src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCvqqyj13jPKSK6Npx6Kko1q_OPJHkcDGg&libraries=places&callback=initMap">
                    </script>
                <% } %>
</body>

</html>