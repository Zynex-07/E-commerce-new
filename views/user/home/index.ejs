<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>AAK Clothing — Modern Shopping</title>
    <link rel="stylesheet" href="/style/storefront.css">
</head>

<body>
    <%- include('../../partials/user/navbar') %>
        <section class="hero-new">
            <div class="shell">
                <div class="hero-grid">
                    <div class="hero-copy">
                        <div class="eyebrow">Fresh picks • Better shopping</div>
                        <h1>Style that fits your <span>everyday.</span></h1>
                        <p>Discover our latest collection across fashion, essentials and more. A faster, cleaner
                            shopping experience built around the products you love.</p>
                        <div class="hero-actions"><a class="primary-btn" href="/product">Shop Collection →</a><a
                                class="outline-btn" href="#categories">Browse Categories</a></div>
                    </div>
                    <div class="hero-visual"><img
                            src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=1200&auto=format&fit=crop"
                            alt="Modern shopping collection">
                        <div class="hero-badge"><strong>New season</strong>Explore the latest arrivals</div>
                    </div>
                </div>
                <div class="trust-row">
                    <div class="trust-item">
                        <div class="trust-icon">🚚</div>
                        <div><strong>Fast Delivery</strong><small>Quick order dispatch</small></div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-icon">🔒</div>
                        <div><strong>Secure Checkout</strong><small>Protected shopping</small></div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-icon">↩</div>
                        <div><strong>Easy Returns</strong><small>Simple return process</small></div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-icon">💬</div>
                        <div><strong>Customer Support</strong><small>Here when you need us</small></div>
                    </div>
                </div>
            </div>
        </section>
        <section class="section" id="categories">
            <div class="shell">
                <div class="section-head">
                    <div>
                        <div class="eyebrow">Shop your way</div>
                        <h2>Popular Categories</h2>
                        <p>Jump straight into what you're looking for.</p>
                    </div><a class="text-link" href="/product">View all products →</a>
                </div>
                <div class="category-grid">
                    <% if(category && category.length){ category.slice(0,8).forEach(function(cat,index){ const
                        match=product.find(p=>String(p.categoryId)===String(cat._id)); const
                        fallback=['/images/women.jpg','/images/shoes_1.webp','/images/baby.1.png','/images/whiteimg.jpg'][index%4];
                        %><a class="category-card" href="/product/category/<%= cat._id %>"><img
                                src="<%= match && match.images && match.images[0] ? match.images[0] : fallback %>"
                                alt="<%= cat.name %>">
                            <div class="category-label"><strong>
                                    <%= cat.name %>
                                </strong><small>Explore collection →</small></div>
                        </a>
                        <% }) } %>
                </div>
            </div>
        </section>
        <section class="section section-soft" id="new-arrivals">
            <div class="shell">
                <div class="section-head">
                    <div>
                        <div class="eyebrow">
                            <%= search ? 'Search results' : 'New stock' %>
                        </div>
                        <h2>
                            <%= search ? 'Results for “' +search+'”' : 'New Stock' %>
                        </h2>
                        <p>
                            <%= search ? product.length+' product(s) found'
                                : 'Every newly added product stays here .' %>
                        </p>
                    </div><a class="text-link" href="/product">Shop all →</a>
                </div>
                <div class="product-grid">
                    <% const homeProducts=search ? product : (newStock || []); %>
                        <% if(homeProducts && homeProducts.length){ homeProducts.slice(0,8).forEach(function(item){ %>
                            <article class="product-card">
                                <div class="product-media"><img
                                        src="<%= item.images && item.images[0] ? item.images[0] : '/images/whiteimg.jpg' %>"
                                        alt="<%= item.name %>" loading="lazy"><span
                                        class="stock-tag <%= Number(item.stock)<=0?'out':'' %>">
                                        <%= Number(item.stock)>0?'In stock':'Sold out' %>
                                    </span>
                                    <% if(item.newUntil && new Date(item.newUntil)> new Date()){ %><span
                                            class="new-stock-tag">NEW</span>
                                        <% } %><a class="wish" href="/wishlist/add/<%= item._id %>"
                                                title="Add to wishlist">♡</a>
                                </div>
                                <div class="product-info">
                                    <h3>
                                        <%= item.name %>
                                    </h3>
                                    <div class="rating">★★★★★ <span>(New)</span></div>
                                    <div class="price-line"><span class="current-price">₹<%=
                                                Number(item.price).toLocaleString('en-IN') %></span></div>
                                    <div class="card-actions"><a class="card-btn" href="/product/<%= item._id %>">View
                                            Product</a><button class="cart-icon-btn" type="button"
                                            onclick="addToCart(\'<%= item._id %>\',1)" title="Add to cart">🛒</button>
                                    </div>
                                </div>
                            </article>
                            <% }) } else { %>
                                <div class="empty">No products found. Try another search.</div>
                                <% } %>
                </div>
            </div>
        </section>
        <section class="section" id="best-sellers">
            <div class="shell">
                <div class="section-head">
                    <div>
                        <div class="eyebrow">Most loved</div>
                        <h2>Best Sellers</h2>
                        <p>Popular products based on completed customer orders.</p>
                    </div><a class="text-link" href="/product">Shop all →</a>
                </div>
                <div class="product-grid">
                    <% if(bestSellers && bestSellers.length){ bestSellers.slice(0,8).forEach(function(item){ %>
                        <article class="product-card">
                            <div class="product-media"><img
                                    src="<%= item.images&&item.images[0]?item.images[0]:'/images/whiteimg.jpg' %>"
                                    alt="<%= item.name %>" loading="lazy"><span class="best-seller-tag">BEST
                                    SELLER</span><a class="wish" href="/wishlist/add/<%= item._id %>">♡</a></div>
                            <div class="product-info">
                                <h3>
                                    <%= item.name %>
                                </h3>
                                <div class="rating">★★★★★ <span>
                                        <%= item.soldQty ? item.soldQty+' sold' : 'Popular pick' %>
                                    </span></div>
                                <div class="price-line"><span class="current-price">₹<%=
                                            Number(item.price).toLocaleString('en-IN') %></span></div>
                                <div class="card-actions"><a class="card-btn" href="/product/<%= item._id %>">View
                                        Product</a><button class="cart-icon-btn" type="button"
                                        onclick="addToCart('<%= item._id %>',1)">🛒</button></div>
                            </div>
                        </article>
                        <% }) } else { %>
                            <div class="empty">Best sellers will appear after customers place orders.</div>
                            <% } %>
                </div>
            </div>
        </section>
        <section class="section section-soft" id="customer-reviews">
            <div class="shell">
                <div class="section-head">
                    <div>
                        <div class="eyebrow">Customer feedback</div>
                        <h2>Customer Ratings</h2>
                        <p>Real ratings and reviews shared by AAK Clothing shoppers.</p>
                    </div><a class="text-link" href="/product">Rate a product →</a>
                </div>
                <div class="review-grid">
                    <% if(reviews && reviews.length){ reviews.slice(0,3).forEach(function(review){ %>
                        <article class="review-card">
                            <div class="review-stars">
                                <%= '★' .repeat(Number(review.rating)) %>
                                    <%= '☆' .repeat(5-Number(review.rating)) %>
                            </div>
                            <p>“<%= review.comment %>”</p><strong>
                                <%= review.userName || 'Customer' %>
                            </strong><small>Customer review</small>
                        </article>
                        <% }) } else { %>
                            <div class="empty review-empty">No customer ratings yet. Be the first to share your
                                experience from a product page.</div>
                            <% } %>
                </div>
            </div>
        </section>
        <section class="section" id="blog">
            <div class="shell">
                <div class="section-head">
                    <div>
                        <div class="eyebrow">AAK Journal</div>
                        <h2>Style & Fashion Blog</h2>
                        <p>Quick inspiration, outfit ideas and useful style tips.</p>
                    </div><span class="text-link">Read & explore →</span>
                </div>
                <div class="blog-grid">
                    <% blogs.forEach(function(blog){ %>
                        <article class="blog-card"><img src="<%= blog.image %>" alt="<%= blog.title %>" loading="lazy">
                            <div class="blog-content"><span>
                                    <%= blog.tag %>
                                </span>
                                <h3>
                                    <%= blog.title %>
                                </h3>
                                <p>
                                    <%= blog.text %>
                                </p><a href="#blog">Read article →</a>
                            </div>
                        </article>
                        <% }) %>
                </div>
            </div>
        </section>
        <section class="section">
            <div class="shell">
                <div class="promo">
                    <div>
                        <div class="eyebrow">Made for easy shopping</div>
                        <h2>Find your next favourite.</h2>
                        <p>Browse the complete collection, save products to your wishlist and check out in just a few
                            steps.</p>
                    </div><a class="primary-btn" href="/product">Explore the Store →</a>
                </div>
            </div>
        </section>
        <%- include('../../partials/user/footer') %>
</body>

</html>