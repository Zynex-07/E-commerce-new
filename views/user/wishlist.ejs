<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="My Wishlist - AAK Clothing">
    <title>My Wishlist | AAK Clothing</title>
    <link rel="stylesheet" href="/style/storefront.css">
    <style>
        /* Wishlist page — styled to match the Shopping Cart page */
        .wishlist-page {
            padding: 45px 0 75px;
            background: #f7f8fa;
            min-height: calc(100vh - 120px);
        }

        .wishlist-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 24px;
        }

        .wishlist-title-wrap {
            min-width: 0;
        }

        .wishlist-eyebrow {
            color: #ff4f2f;
            font-size: 12px;
            line-height: 1;
            letter-spacing: 1.8px;
            font-weight: 900;
            margin-bottom: 9px;
        }

        .wishlist-title {
            margin: 0;
            color: #101828;
            font-size: 36px;
            line-height: 1.15;
            font-weight: 850;
        }

        .wishlist-summary {
            margin: 7px 0 0;
            color: #667085;
            font-size: 14px;
        }

        .continue-shopping {
            flex: 0 0 auto;
            color: #ff4f2f;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
            margin-bottom: 4px;
        }

        .continue-shopping:hover {
            color: #e63f20;
            text-decoration: underline;
        }

        .wishlist-box {
            width: 100%;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .wishlist-list {
            display: flex;
            flex-direction: column;
        }

        .wishlist-item {
            display: grid;
            grid-template-columns: 110px minmax(0, 1fr) auto;
            gap: 18px;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid var(--line);
        }

        .wishlist-item:last-child {
            border-bottom: 0;
        }

        .wishlist-image {
            width: 110px;
            height: 110px;
            object-fit: cover;
            border-radius: 14px;
            background: var(--soft);
            display: block;
        }

        .wishlist-info {
            min-width: 0;
        }

        .wishlist-name {
            color: #101828;
            font-size: 16px;
            line-height: 1.4;
            font-weight: 800;
            margin-bottom: 7px;
            overflow-wrap: anywhere;
        }

        .wishlist-price {
            color: #667085;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .wishlist-view {
            color: #ff4f2f;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
        }

        .wishlist-view:hover {
            text-decoration: underline;
        }

        .wishlist-actions {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
        }

        .wishlist-remove {
            border: 0;
            background: transparent;
            color: #b42318;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            text-decoration: none;
        }

        .wishlist-remove:hover {
            text-decoration: underline;
        }

        .empty-wishlist {
            padding: 70px 25px;
            text-align: center;
        }

        .empty-wishlist .wishlist-emoji {
            font-size: 48px;
            line-height: 1;
            margin-bottom: 14px;
        }

        .empty-wishlist h2 {
            margin: 0;
            color: #101828;
            font-size: 24px;
            line-height: 1.3;
            font-weight: 850;
        }

        .empty-wishlist p {
            margin: 12px 0 0;
            color: #667085;
            font-size: 15px;
            line-height: 1.6;
        }

        .start-shopping {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            margin-top: 18px;
            padding: 12px 18px;
            border-radius: 10px;
            background: #101828;
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
            transition: transform .2s ease, background .2s ease;
        }

        .start-shopping:hover {
            background: #1d2939;
            transform: translateY(-1px);
        }

        @media (max-width: 900px) {
            .wishlist-page {
                padding: 35px 0 60px;
            }

            .wishlist-title {
                font-size: 32px;
            }
        }

        @media (max-width: 650px) {
            .wishlist-page {
                padding: 28px 0 45px;
            }

            .wishlist-head {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 18px;
            }

            .wishlist-title {
                font-size: 28px;
            }

            .continue-shopping {
                margin-bottom: 0;
            }

            .wishlist-box {
                border-radius: 16px;
            }

            .wishlist-item {
                grid-template-columns: 80px minmax(0, 1fr);
                gap: 14px;
                padding: 15px;
            }

            .wishlist-image {
                width: 80px;
                height: 80px;
                border-radius: 11px;
            }

            .wishlist-actions {
                grid-column: 1 / -1;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
                width: 100%;
                padding-left: 94px;
            }

            .empty-wishlist {
                padding: 52px 18px;
            }
        }

        @media (max-width: 400px) {
            .wishlist-title {
                font-size: 25px;
            }

            .wishlist-item {
                grid-template-columns: 70px minmax(0, 1fr);
            }

            .wishlist-image {
                width: 70px;
                height: 70px;
            }

            .wishlist-actions {
                padding-left: 84px;
            }
        }
    </style>
</head>
<body>
    <%- include("../partials/user/navbar") %>

    <main class="wishlist-page">
        <div class="shell">
            <div class="wishlist-head">
                <div class="wishlist-title-wrap">
                    <div class="wishlist-eyebrow">YOUR WISHLIST</div>
                    <h1 class="wishlist-title">My Wishlist</h1>
                    <p class="wishlist-summary"><%= wishlist.length %> product type(s) • <%= wishlist.length %> item(s)</p>
                </div>
                <a href="/product" class="continue-shopping">← Continue shopping</a>
            </div>

            <section class="wishlist-box">
                <% if (wishlist.length === 0) { %>
                    <div class="empty-wishlist">
                        <div class="wishlist-emoji">♡</div>
                        <h2>Your wishlist is empty</h2>
                        <p>Save products you love from the shop and they will appear here.</p>
                        <a href="/product" class="start-shopping">Start Shopping</a>
                    </div>
                <% } else { %>
                    <div class="wishlist-list">
                        <% wishlist.forEach(function(product) { %>
                            <article class="wishlist-item">
                                <img
                                    class="wishlist-image"
                                    src="<%= product.images && product.images.length ? product.images[0] : '/images/whiteimg.jpg' %>"
                                    alt="<%= product.name %>"
                                    loading="lazy">

                                <div class="wishlist-info">
                                    <div class="wishlist-name"><%= product.name %></div>
                                    <div class="wishlist-price">₹<%= Number(product.price).toLocaleString('en-IN') %></div>
                                    <a class="wishlist-view" href="/product/<%= product._id %>">View product →</a>
                                </div>

                                <div class="wishlist-actions">
                                    <a href="/wishlist/remove/<%= product._id %>" class="wishlist-remove">Remove</a>
                                </div>
                            </article>
                        <% }); %>
                    </div>
                <% } %>
            </section>
        </div>
    </main>

    <%- include("../partials/user/footer") %>
</body>
</html>
