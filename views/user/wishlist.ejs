<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wishlist</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            min-height: 100vh;
        }

        /* ==========================
           NAVBAR
        ========================== */
        .navbar {
            width: 100%;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo img {
            width: 150px;
            height: 60px;
            object-fit: contain;
        }

        .menu-toggle {
            display: none;
            width: 45px;
            height: 40px;
            border: 1px solid rgba(255, 255, 255, .4);
            border-radius: 6px;
            background: transparent;
            color: #fff;
            font-size: 26px;
            cursor: pointer;
            justify-content: center;
            align-items: center;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-links a {
            text-decoration: none;
            color: #fff;
            font-size: 15px;
            font-weight: 500;
            transition: .3s;
        }

        .nav-links a:hover {
            color: #fbbf24;
        }

        .search-form {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-form input {
            width: 220px;
            padding: 10px;
            border: none;
            outline: none;
            border-radius: 8px;
        }

        .search-form button {
            padding: 10px 15px;
            border: none;
            border-radius: 8px;
            background: #f59e0b;
            color: #fff;
            cursor: pointer;
            font-weight: 600;
        }

        .search-form button:hover {
            background: #d97706;
        }

        .cart-btn {
            background: linear-gradient(90deg, #10b981, #059669);
            padding: 10px 18px;
            border-radius: 8px;
            color: #fff !important;
            font-weight: 600;
        }

        /* ==========================
           BACK BUTTON
        ========================== */
        .back-btn {
            display: inline-block;
            margin: 30px 0 20px 40px;
            padding: 12px 22px;
            background: linear-gradient(90deg, #2563eb, #1d4ed8);
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: .3s;
        }

        .back-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.4);
        }

        /* ==========================
           CONTAINER
        ========================== */
        .container {
            width: 92%;
            max-width: 1100px;
            margin: 0 auto 40px auto;
        }

        .container h1 {
            text-align: center;
            font-size: 42px;
            color: #0f172a;
            margin-bottom: 35px;
        }

        /* ==========================
           WISHLIST CARD
        ========================== */
        .card {
            background: #fff;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 25px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .06);
            transition: .3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, .12);
        }

        .product {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .product img {
            width: 160px;
            height: 160px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #f1f5f9;
        }

        .details {
            flex: 1;
        }

        .name {
            font-size: 26px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 8px;
        }

        .price {
            color: #16a34a;
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        /* ==========================
           ACTION BUTTONS
        ========================== */
        .action-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 12px 22px;
            border-radius: 8px;
            text-decoration: none;
            color: #fff;
            font-weight: 600;
            transition: .3s;
            text-align: center;
            border: none;
        }

        .view {
            background: linear-gradient(90deg, #2563eb, #1d4ed8);
        }

        .view:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, .35);
        }

        .remove {
            background: linear-gradient(90deg, #ef4444, #dc2626);
        }

        .remove:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(220, 38, 38, .35);
        }

        /* ==========================
           EMPTY WISHLIST
        ========================== */
        .empty {
            background: #fff;
            padding: 60px 30px;
            border-radius: 15px;
            text-align: center;
            font-size: 28px;
            font-weight: 600;
            color: #64748b;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .06);
        }

        /* ==========================
           FOOTER
        ========================== */
        footer {
            margin-top: 70px;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            color: #fff;
            text-align: center;
            padding: 25px;
            font-size: 15px;
            letter-spacing: .5px;
        }

        /* ==========================
           TABLET & MOBILE RESPONSIVE
        ========================== */
        @media (max-width:992px) {
            .navbar {
                flex-wrap: wrap;
                padding: 15px 20px;
            }

            .menu-toggle {
                display: flex;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: center;
                gap: 18px;
                margin-top: 20px;
                padding-top: 20px;
                border-top: 1px solid rgba(255, 255, 255, .15);
            }

            .nav-links.active {
                display: flex;
            }

            .search-form {
                width: 100%;
                flex-direction: column;
            }

            .search-form input,
            .search-form button {
                width: 100%;
            }

            .back-btn {
                margin: 20px 0 20px 20px;
            }
        }

        @media (max-width:600px) {
            .logo img {
                width: 120px;
                height: 50px;
            }

            .container {
                width: 95%;
            }

            .container h1 {
                font-size: 28px;
                margin-bottom: 25px;
            }

            .card {
                padding: 15px;
            }

            .product {
                flex-direction: column;
                text-align: center;
                gap: 15px;
            }

            .product img {
                width: 120px;
                height: 120px;
            }

            .details {
                width: 100%;
            }

            .name {
                font-size: 20px;
            }

            .price {
                font-size: 18px;
                margin-bottom: 15px;
            }

            .action-buttons {
                flex-direction: column;
                gap: 10px;
            }

            .btn {
                width: 100%;
                padding: 12px 15px;
                font-size: 15px;
            }

            .empty {
                font-size: 20px;
                padding: 40px 20px;
            }

            .back-btn {
                margin: 20px 0 10px 10px;
            }
        }
    </style>
</head>

<body>
    <%- include("../partials/user/navbar") %>

        <a href="/product" class="back-btn">
            ← Back To Products
        </a>

        <div class="container">
            <h1>My Wishlist</h1>

            <% if(wishlist.length===0){ %>
                <div class="empty">
                    Wishlist is empty
                </div>
                <% } else { %>
                    <% wishlist.forEach(function(product){ %>
                        <div class="card">
                            <div class="product">
                                <img
                                    src="<%= product.images && product.images.length ? product.images[0] : '/images/no-image.png' %>">
                                <div class="details">
                                    <div class="name">
                                        <%= product.name %>
                                    </div>
                                    <div class="price">
                                        Price: ₹ <%= product.price %>
                                    </div>

                                    <div class="action-buttons">
                                        <a href="/product/<%= product._id %>" class="btn view">
                                            View Product
                                        </a>
                                        <a href="/wishlist/remove/<%= product._id %>" class="btn remove">
                                            Remove
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
        </div>

        <%- include("../partials/user/footer") %>
</body>

</html>