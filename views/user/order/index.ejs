<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="View your IV Store orders"><title>My Orders — IV Store</title>
  <link rel="stylesheet" href="/style/storefront.css">
  <style>
    .orders-page{min-height:calc(100vh - 130px);background:#f8fafc;padding:38px 0 70px}.orders-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:25px}.orders-head h1{font-size:34px;margin:5px 0}.orders-head p{color:#667085;margin:0}.order-stats{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:22px}.stat{padding:10px 14px;background:#fff;border:1px solid #e4e7ec;border-radius:10px;font-size:13px}.stat strong{color:#101828}.orders-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.order-card{background:#fff;border:1px solid #e4e7ec;border-radius:16px;padding:20px;box-shadow:0 7px 22px rgba(16,24,40,.05);min-width:0}.order-top{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:16px}.status{padding:6px 10px;border-radius:999px;font-size:11px;font-weight:800}.status.pending{background:#fffaeb;color:#b54708}.status.paid{background:#eff8ff;color:#175cd3}.status.delivered{background:#ecfdf3;color:#027a48}.status.cancelled{background:#fef3f2;color:#b42318}.order-date{font-size:12px;color:#667085}.order-total{font-size:25px;font-weight:800;color:#101828;margin-bottom:8px}.items-count{font-size:13px;color:#667085}.thumbs{display:flex;gap:7px;margin:16px 0;overflow:hidden}.thumbs img{width:52px;height:52px;border-radius:9px;object-fit:cover;background:#f2f4f7;border:1px solid #eaecf0}.order-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px}.order-btn{display:flex;align-items:center;justify-content:center;min-height:42px;border-radius:9px;text-decoration:none;font-size:12px;font-weight:800;border:1px solid #d0d5dd;color:#344054;background:#fff}.order-btn.primary{background:#101828;border-color:#101828;color:#fff}.empty-orders{background:#fff;border:1px solid #e4e7ec;border-radius:16px;padding:70px 20px;text-align:center}.empty-orders .emoji{font-size:48px}.empty-orders a{display:inline-flex;margin-top:18px;padding:12px 18px;background:#101828;color:#fff;border-radius:10px;text-decoration:none;font-weight:700}
    @media(max-width:950px){.orders-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:620px){.orders-page{padding:25px 0 55px}.orders-head{align-items:flex-start;flex-direction:column}.orders-head h1{font-size:28px}.orders-grid{grid-template-columns:1fr}.order-card{padding:16px}.order-actions{grid-template-columns:1fr}.order-total{font-size:22px}}
  </style>
</head>
<body>
<%- include('../../partials/user/navbar') %>
<main class="orders-page"><div class="shell">
  <div class="orders-head"><div><div class="eyebrow">Account</div><h1>My Orders</h1><p>Track your purchases and open full order details.</p></div><a class="text-link" href="/product">← Continue shopping</a></div>
  <div class="order-stats"><div class="stat">Total orders: <strong><%= orders.length %></strong></div><div class="stat">Pending: <strong><%= orders.filter(o=>o.status==='Pending').length %></strong></div><div class="stat">Paid: <strong><%= orders.filter(o=>o.status==='Paid').length %></strong></div><div class="stat">Delivered: <strong><%= orders.filter(o=>o.status==='Delivered').length %></strong></div></div>
  <% if(orders.length){ %>
    <div class="orders-grid">
      <% orders.forEach(order=>{ const status=String(order.status||'Pending').toLowerCase(); const items=Array.isArray(order.products)?order.products:[]; %>
        <article class="order-card">
          <div class="order-top"><span class="status <%= status %>"><%= order.status || 'Pending' %></span><span class="order-date"><%= order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %></span></div>
          <div class="order-total">₹<%= Number(order.total||0).toLocaleString('en-IN') %></div>
          <div class="items-count"><%= items.length %> product type(s) • <%= items.reduce((s,i)=>s+Number(i.qty||0),0) %> item(s)</div>
          <div class="thumbs"><% items.slice(0,4).forEach(item=>{ %><img src="<%= item.images||'/images/whiteimg.jpg' %>" alt="<%= item.name %>" loading="lazy"><% }) %></div>
          <div class="order-actions"><a class="order-btn primary" href="/order/view/<%= order._id %>">View Details</a><a class="order-btn" href="/address">Delivery Address</a></div>
        </article>
      <% }) %>
    </div>
  <% }else{ %>
    <div class="empty-orders"><div class="emoji">📦</div><h2>No Orders Yet</h2><p style="color:#667085;margin-top:7px">Your completed and active orders will appear here.</p><a href="/product">Start Shopping</a></div>
  <% } %>
</div></main>
<%- include('../../partials/user/footer') %>
</body></html>
