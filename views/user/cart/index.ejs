<!DOCTYPE html>
<html>

<head>
    <title>Cart</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            min-height: 100vh;
            padding-bottom: 80px;
            /* IMPORTANT: Space for fixed footer */
        }

        /* ===========================
           NAVBAR
        =========================== */
        .navbar {
            width: 100%;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo img {
            width: 130px;
            height: 55px;
            object-fit: contain;
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, .4);
            color: #fff;
            width: 45px;
            height: 40px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 26px;
            justify-content: center;
            align-items: center;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 15px;
            padding: 10px 15px;
            border-radius: 8px;
            transition: .3s;
        }

        .nav-links a:hover {
            color: #fbbf24;
        }

        .search-form {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .search-form input {
            width: 220px;
            padding: 10px;
            border: none;
            outline: none;
            border-radius: 8px;
        }

        .search-form button {
            padding: 10px 18px;
            border: none;
            border-radius: 8px;
            background: #f59e0b;
            color: #fff;
            cursor: pointer;
            font-weight: 600;
        }

        .search-form button:hover {
            background: #d97706;
        }

        .cart-btn {
            background: linear-gradient(90deg, #10b981, #059669);
            padding: 10px 18px;
            border-radius: 8px;
            color: #fff !important;
            font-weight: 600;
        }

        /* ===========================
           CONTAINER & BACK BTN
        =========================== */
        .container {
            width: 92%;
            max-width: 1000px;
            /* Slightly reduced for better readability on desktop */
            margin: 20px auto 40px auto;
        }

        .title {
            text-align: center;
            font-size: 42px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 35px;
        }

        .back-btn {
            display: inline-block;
            margin: 30px 0 20px 40px;
            padding: 12px 22px;
            background: linear-gradient(90deg, #2563eb, #1d4ed8);
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: .3s;
        }

        .back-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.4);
        }

        /* ===========================
           CART ITEMS
        =========================== */
        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .card {
            background: #fff;
            border-radius: 15px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 25px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .06);
            transition: .3s;
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, .12);
        }

        .card img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #f1f5f9;
        }

        .details {
            flex: 1;
        }

        .details h3 {
            font-size: 24px;
            margin-bottom: 8px;
            color: #111827;
        }

        .details p {
            margin-bottom: 6px;
            color: #4b5563;
            font-size: 15px;
        }

        .price {
            color: #16a34a !important;
            font-weight: 700;
            font-size: 18px;
        }

        /* ===========================
           BUTTONS & SUMMARY
        =========================== */
        .remove-btn {
            display: inline-block;
            text-decoration: none;
            color: #fff;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            background: #ef4444;
            transition: .3s;
        }

        .remove-btn:hover {
            background: #dc2626;
            box-shadow: 0 5px 15px rgba(220, 38, 38, .3);
            transform: translateY(-2px);
        }

        .summary {
            margin-top: 35px;
            background: #fff;
            padding: 30px;
            border-radius: 15px;
            display: flex;
            justify-content: space-between;
            /* Side by side on desktop */
            align-items: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
        }

        .summary h2 {
            color: #16a34a;
            font-size: 28px;
        }

        .order-btn {
            display: inline-block;
            text-decoration: none;
            color: #fff;
            padding: 14px 28px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 16px;
            background: linear-gradient(90deg, #f59e0b, #ef4444);
            transition: .3s;
        }

        .order-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(239, 68, 68, .35);
        }

        .empty {
            text-align: center;
            background: #fff;
            padding: 60px 20px;
            border-radius: 15px;
            font-size: 26px;
            font-weight: 600;
            color: #64748b;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .06);
            margin-top: 20px;
        }

        /* ===========================
           RESPONSIVE (TABLET)
        =========================== */
        @media(max-width:992px) {
            .menu-toggle {
                display: flex;
            }

            .navbar {
                flex-wrap: wrap;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: center;
                gap: 15px;
                margin-top: 20px;
                padding-top: 20px;
                border-top: 1px solid rgba(255, 255, 255, .15);
            }

            .nav-links.active {
                display: flex;
            }

            .search-form {
                width: 100%;
                flex-direction: column;
            }

            .search-form input,
            .search-form button {
                width: 100%;
            }

            .back-btn {
                margin: 20px 0 20px 20px;
            }
        }

        /* ===========================
           RESPONSIVE (MOBILE)
        =========================== */
        @media(max-width:600px) {
            .logo img {
                width: 120px;
                height: 50px;
            }

            .title {
                font-size: 30px;
                margin-bottom: 20px;
            }

            .container {
                width: 95%;
                margin: 10px auto 30px auto;
            }

            .back-btn {
                margin: 15px 0 10px 10px;
                padding: 10px 18px;
                font-size: 14px;
            }

            .card {
                padding: 15px;
                gap: 15px;
                flex-wrap: wrap;
                /* Allows the button to drop below if needed */
            }

            .card img {
                width: 90px;
                /* Smaller image on mobile */
                height: 90px;
            }

            .details h3 {
                font-size: 18px;
                margin-bottom: 5px;
            }

            .details p {
                font-size: 13px;
                margin-bottom: 4px;
            }

            .price {
                font-size: 15px;
            }

            .remove-btn {
                width: 100%;
                text-align: center;
                margin-top: 5px;
            }

            .summary {
                flex-direction: column;
                gap: 20px;
                padding: 25px 20px;
                text-align: center;
            }

            .summary h2 {
                font-size: 22px;
            }

            .order-btn {
                width: 100%;
            }

            .empty {
                font-size: 20px;
                padding: 40px 15px;
            }
        }
    </style>
</head>

<body>
    <%- include("../../partials/user/navbar") %>

        <a href="/product" class="back-btn">
            ← Back To Products
        </a>

        <div class="container">
            <h1 class="title">My Cart</h1>

            <% if(cart.length> 0){ %>
                <div class="cart-items">
                    <% cart.forEach(item=> { %>
                        <div class="card">
                            <img src="<%= item.images || '/images/no-image.png' %>" alt="<%= item.name %>">
                            <div class="details">
                                <h3>
                                    <%= item.name %>
                                </h3>
                                <p>
                                    <strong>Qty:</strong>
                                    <%= item.qty %>
                                </p>
                                <p>
                                    <strong>Price:</strong> ₹ <%= item.price %>
                                </p>
                                <p class="price">
                                    Total: ₹ <%= item.total %>
                                </p>
                            </div>

                            <a href="/cart/clear" class="remove-btn">
                                Remove
                            </a>
                        </div>
                        <% }) %>
                </div>

                <div class="summary">
                    <h2>
                        Grand Total: ₹ <%= grandTotal %>
                    </h2>
                    <a href="/order/place" class="order-btn">
                        Place Order
                    </a>
                </div>
                <% } else { %>
                    <div class="empty">
                        🛒 Your Cart Is Empty
                    </div>
                    <% } %>
        </div>

        <%- include("../../partials/user/footer") %>
</body>

</html>