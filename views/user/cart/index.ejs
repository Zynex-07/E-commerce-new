<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Shopping Cart — IV Store</title><link rel="stylesheet" href="/style/storefront.css">
</head>
<body>
<%- include('../../partials/user/navbar') %>
<main class="cart-page"><div class="shell">
  <div class="section-head"><div><div class="eyebrow">Your bag</div><h2>Shopping Cart</h2><p><%= cart.length %> product type(s) in your cart.</p></div><a class="text-link" href="/product">Continue shopping →</a></div>
  <% if(cart.length){ %>
  <div class="cart-layout">
    <section class="cart-list">
      <% cart.forEach(function(item){ %>
      <article class="cart-item" data-id="<%= item.productID %>">
        <a href="/product/<%= item.productID %>"><img src="<%= item.images || '/images/whiteimg.jpg' %>" alt="<%= item.name %>"></a>
        <div>
          <div class="cart-name"><a href="/product/<%= item.productID %>"><%= item.name %></a></div>
          <div class="cart-unit">₹<%= Number(item.price).toLocaleString('en-IN') %> each</div>
          <div class="qty-control small" style="margin-top:10px"><button type="button" onclick="changeQty('<%= item.productID %>',-1)">−</button><input id="qty-<%= item.productID %>" value="<%= item.qty %>" readonly><button type="button" onclick="changeQty('<%= item.productID %>',1)">+</button></div>
          <button class="cart-remove" type="button" onclick="removeItem('<%= item.productID %>')">Remove</button>
        </div>
        <div class="cart-total">₹<span id="total-<%= item.productID %>"><%= Number(item.total).toLocaleString('en-IN') %></span></div>
      </article>
      <% }) %>
    </section>
    <aside class="cart-summary">
      <div class="eyebrow">Order summary</div>
      <div class="summary-row"><span>Subtotal</span><strong id="grand-total">₹<%= Number(grandTotal).toLocaleString('en-IN') %></strong></div>
      <div class="summary-row"><span>Delivery</span><strong>FREE</strong></div>
      <div class="summary-row total"><span>Total</span><span id="grand-total-2">₹<%= Number(grandTotal).toLocaleString('en-IN') %></span></div>
      <button class="checkout-btn" id="checkoutBtn" type="button" onclick="startCheckout()">Pay securely with Razorpay</button>
      <div class="secure-note">🔒 Secure payment • UPI • Cards • Net Banking • Wallets</div>
      <a class="text-link" style="display:block;text-align:center;margin-top:15px" href="/cart/clear">Clear cart</a>
    </aside>
  </div>
  <% } else { %>
  <div class="cart-list empty-cart"><div class="emoji">🛒</div><h2>Your cart is empty</h2><p style="color:#667085;margin-top:8px">Add something you love and it will appear here.</p><a class="continue-btn" href="/product">Start Shopping</a></div>
  <% } %>
</div></main>
<div class="toast" id="toast"></div>
<div class="payment-overlay" id="paymentOverlay"><div class="payment-box"><div class="spinner"></div><h3>Opening secure checkout…</h3><p style="color:#667085;font-size:13px;margin-top:8px">Please don't close this window.</p></div></div>
<%- include('../../partials/user/footer') %>
<script>
const money = n => '₹' + Number(n || 0).toLocaleString('en-IN');
function toast(message){const t=document.getElementById('toast');t.textContent=message;t.style.display='block';clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.style.display='none',2600)}
async function changeQty(id, delta){const input=document.getElementById('qty-'+id);const next=Math.max(1,Number(input.value)+delta);try{const r=await fetch('/cart/update/'+id,{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({qty:next})});const d=await r.json();if(!d.ok) return toast(d.message||'Unable to update cart');input.value=next;document.getElementById('total-'+id).textContent=Number(d.itemTotal).toLocaleString('en-IN');document.getElementById('grand-total').textContent=money(d.grandTotal);document.getElementById('grand-total-2').textContent=money(d.grandTotal);document.querySelectorAll('.cart-count').forEach(x=>x.textContent=d.cartCount)}catch(e){toast('Network error. Please try again.')}}
async function removeItem(id){try{const r=await fetch('/cart/remove/'+id,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}});const d=await r.json();if(!d.ok) throw new Error();document.querySelector('.cart-item[data-id="'+id+'"]').remove();document.querySelectorAll('.cart-count').forEach(x=>x.textContent=d.cartCount);toast('Item removed');location.reload()}catch(e){toast('Unable to remove item')}}
async function startCheckout(){
 const btn=document.getElementById('checkoutBtn');btn.disabled=true;document.getElementById('paymentOverlay').style.display='flex';
 try{
   const r=await fetch('/payment/create-order',{method:'POST',headers:{'Content-Type':'application/json'}});const d=await r.json();
   if(!d.ok) throw new Error(d.message||'Unable to create payment');
   if(!window.Razorpay){await loadRazorpay();}
   document.getElementById('paymentOverlay').style.display='none';
   const options={key:d.key,amount:d.order.amount,currency:d.order.currency,name:'IV Store',description:'Secure order payment',order_id:d.order.id,theme:{color:'#ff5a36'},handler:async function(response){
      document.getElementById('paymentOverlay').style.display='flex';
      const vr=await fetch('/payment/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(response)});const vd=await vr.json();
      if(vd.ok){window.location.href='/order/view/'+vd.orderId}else{throw new Error(vd.message||'Payment verification failed')}
   },modal:{ondismiss:function(){btn.disabled=false}}};
   const rp=new Razorpay(options);rp.on('payment.failed',function(){toast('Payment failed. Please try again.');btn.disabled=false});rp.open();
 }catch(e){document.getElementById('paymentOverlay').style.display='none';btn.disabled=false;toast(e.message||'Payment setup failed')}
}
function loadRazorpay(){return new Promise((resolve,reject)=>{const s=document.createElement('script');s.src='https://checkout.razorpay.com/v1/checkout.js';s.onload=resolve;s.onerror=()=>reject(new Error('Unable to load Razorpay checkout'));document.head.appendChild(s)})}
</script>
</body></html>
