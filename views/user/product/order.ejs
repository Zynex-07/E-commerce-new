<!DOCTYPE html>
<html>

<head>

    <title>Order Success</title>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            /* Mobile par screen edges se dur rakhne ke liye */
        }

        /* =========================
           ORDER BOX
        ========================= */

        .box {
            width: 500px;
            max-width: 100%;
            /* Mobile par bahar na nikalne de */
            background: white;
            padding: 50px 40px;
            border-radius: 18px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
            animation: fadeIn 0.8s ease;
        }


        /* =========================
           HEADING
        ========================= */

        .box h1 {
            color: #16a34a;
            margin-bottom: 20px;
            font-size: 42px;
            font-weight: 700;
        }


        /* =========================
           PARAGRAPH
        ========================= */

        .box p {
            margin-bottom: 35px;
            font-size: 18px;
            color: #4b5563;
            line-height: 28px;
        }


        /* =========================
           BUTTON
        ========================= */

        .btn {
            display: inline-block;
            background: linear-gradient(90deg, #f59e0b, #ef4444);
            color: white;
            padding: 14px 24px;
            text-decoration: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            transition: 0.3s;
            box-shadow: 0 5px 15px rgba(239, 68, 68, 0.3);
        }

        .btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.5);
        }


        /* =========================
           ANIMATION
        ========================= */

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0px);
            }
        }

        /* =========================
           RESPONSIVE (Mobile)
        ========================= */
        @media (max-width: 600px) {
            .box {
                padding: 40px 20px;
                /* Padding kam ki taaki chote phone me fit ho */
            }

            .box h1 {
                font-size: 32px;
                /* Text thoda chota kiya */
                margin-bottom: 15px;
            }

            .box p {
                font-size: 16px;
                margin-bottom: 25px;
            }

            .btn {
                padding: 12px 20px;
                font-size: 14px;
                width: 100%;
                /* Mobile me button full width accha lagta hai */
            }
        }
    </style>

</head>

<body>
    <div class="box">
        <h1>
            Order Successful
        </h1>
        <p>
            Thank You For Shopping
        </p>
        <a href="/" class="btn">
            Back To Home
        </a>
    </div>
</body>

</html>