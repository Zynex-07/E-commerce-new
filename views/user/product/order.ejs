<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Success</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        /* =========================
           RESET
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        /* =========================
           BODY
        ========================= */

        body {
            min-height: 100vh;
            background: linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);
        }

        /* =========================
           MAIN
        ========================= */

        .order-page {
            min-height: calc(100vh - 80px);

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 40px 20px;
        }

        /* =========================
           ORDER BOX
        ========================= */

        .box {
            width: 100%;
            max-width: 500px;

            background: #ffffff;

            padding: 50px 40px;

            border-radius: 18px;

            text-align: center;

            box-shadow:
                0 15px 35px rgba(0, 0, 0, 0.12);

            animation: fadeIn 0.8s ease;
        }

        /* =========================
           SUCCESS ICON
        ========================= */

        .success-icon {
            width: 75px;
            height: 75px;

            margin: 0 auto 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background: #dcfce7;

            border: 4px solid #bbf7d0;

            color: #16a34a;

            font-size: 42px;
            font-weight: 700;
        }

        /* =========================
           HEADING
        ========================= */

        .box h1 {
            color: #16a34a;

            font-size: 40px;
            line-height: 1.2;

            margin-bottom: 15px;

            font-weight: 700;
        }

        /* =========================
           MESSAGE
        ========================= */

        .box p {
            color: #4b5563;

            font-size: 18px;

            line-height: 1.7;

            margin-bottom: 30px;
        }

        /* =========================
           BUTTONS
        ========================= */

        .buttons {
            display: flex;

            justify-content: center;

            gap: 12px;

            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-height: 48px;

            padding: 13px 24px;

            border-radius: 10px;

            background: linear-gradient(90deg,
                    #f59e0b,
                    #ef4444);

            color: #ffffff;

            text-decoration: none;

            font-size: 15px;

            font-weight: 600;

            box-shadow:
                0 5px 15px rgba(239, 68, 68, 0.3);

            transition: 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-3px);

            box-shadow:
                0 10px 20px rgba(239, 68, 68, 0.4);
        }

        .btn:active {
            transform: scale(0.97);
        }

        /* =========================
           ANIMATION
        ========================= */

        @keyframes fadeIn {

            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        /* =========================
           TABLET
        ========================= */

        @media (max-width: 768px) {

            .order-page {
                padding: 35px 18px;
            }

            .box {
                max-width: 520px;

                padding: 42px 30px;
            }

            .success-icon {
                width: 68px;
                height: 68px;

                font-size: 36px;
            }

            .box h1 {
                font-size: 34px;
            }

            .box p {
                font-size: 17px;
            }

        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 600px) {

            .order-page {
                min-height: calc(100vh - 70px);

                padding: 25px 15px;
            }

            .box {
                width: 100%;

                padding: 35px 20px;

                border-radius: 15px;
            }

            .success-icon {
                width: 62px;
                height: 62px;

                margin-bottom: 16px;

                font-size: 32px;

                border-width: 3px;
            }

            .box h1 {
                font-size: 29px;

                line-height: 1.25;

                margin-bottom: 14px;
            }

            .box p {
                font-size: 15px;

                line-height: 1.6;

                margin-bottom: 25px;
            }

            .buttons {
                width: 100%;

                flex-direction: column;

                gap: 10px;
            }

            .btn {
                width: 100%;

                min-height: 48px;

                padding: 12px 18px;

                font-size: 14px;
            }

        }

        /* =========================
           SMALL MOBILE
        ========================= */

        @media (max-width: 400px) {

            .order-page {
                padding: 20px 12px;
            }

            .box {
                padding: 30px 16px;
            }

            .success-icon {
                width: 58px;
                height: 58px;

                font-size: 29px;
            }

            .box h1 {
                font-size: 25px;
            }

            .box p {
                font-size: 14px;
            }

            .btn {
                min-height: 46px;

                font-size: 13px;
            }

        }

        /* =========================
           VERY SMALL MOBILE
        ========================= */

        @media (max-width: 320px) {

            .box {
                padding: 25px 13px;
            }

            .box h1 {
                font-size: 23px;
            }

            .box p {
                font-size: 13px;
            }

        }
    </style>

</head>

<body>

    <!-- =========================
         NAVBAR
    ========================= -->

    <%- include("../../partials/user/navbar") %>


        <!-- =========================
         ORDER SUCCESS
    ========================= -->

        <main class="order-page">

            <div class="box">

                <div class="success-icon">
                    ✓
                </div>

                <h1>
                    Order Successful
                </h1>

                <p>
                    Thank You For Shopping
                </p>

                <div class="buttons">

                    <a href="/" class="btn">
                        Back To Home
                    </a>

                    <a href="/order" class="btn">
                        View Orders
                    </a>

                </div>

            </div>

        </main>


        <!-- =========================
         FOOTER
    ========================= -->

        <%- include("../../partials/user/footer") %>

</body>

</html>