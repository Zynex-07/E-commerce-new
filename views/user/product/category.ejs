<!DOCTYPE html>
<html>

<head>

    <title>Category Product</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            min-height: 100vh;
        }

        /* =========================
           Navbar
        ========================= */

        .navbar {
            width: 100%;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo img {
            width: 150px;
            height: 60px;
            object-fit: contain;
        }

        .menu-toggle {
            display: none;
            width: 45px;
            height: 40px;
            border: 1px solid rgba(255, 255, 255, .4);
            border-radius: 6px;
            background: transparent;
            color: #fff;
            font-size: 26px;
            cursor: pointer;
            justify-content: center;
            align-items: center;
            transition: .3s;
        }

        .menu-toggle:hover {
            background: rgba(255, 255, 255, .1);
        }

        .menu-toggle:active {
            transform: scale(.95);
        }

        .nav-links {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: white;
            font-size: 15px;
            font-weight: 500;
            transition: .3s;
        }

        .nav-links a:hover {
            color: #fbbf24;
        }

        .search-form {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-form input {
            width: 220px;
            padding: 10px;
            border: none;
            border-radius: 8px;
            outline: none;
        }

        .search-form button {
            padding: 10px 15px;
            border: none;
            border-radius: 8px;
            background: #f59e0b;
            color: white;
            cursor: pointer;
            font-weight: 600;
        }

        .search-form button:hover {
            background: #d97706;
        }

        .cart-btn {
            background: linear-gradient(90deg, #10b981, #059669);
            padding: 10px 18px;
            border-radius: 8px;
            color: white !important;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(16, 185, 129, .3);
        }

        .cart-btn:hover {
            transform: translateY(-3px);
        }

        /* =========================
           Container
        ========================= */

        .container {
            width: 92%;
            max-width: 1250px;
            margin: 60px auto;
        }

        /* =========================
           Title
        ========================= */

        .title {
            text-align: center;
            margin-bottom: 25px;
            font-size: 42px;
            font-weight: 700;
            color: #0f172a;
        }

        /* =========================
           Back Button
        ========================= */

        .back-btn {
            display: inline-block;
            background: linear-gradient(90deg, #3b82f6, #2563eb);
            color: white;
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            margin-bottom: 35px;
            transition: .3s;
        }

        .back-btn:hover {
            transform: translateY(-4px);
        }

        /* =========================
           Products
        ========================= */

        .product {
            display: flex;
            flex-wrap: wrap;
            gap: 25px;
            justify-content: center;
        }

        .card {
            width: 280px;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, .1);
            transition: .3s;
        }

        .card:hover {
            transform: translateY(-8px);
        }

        .card img {
            width: 100%;
            height: 260px;
            object-fit: cover;
        }

        .content {
            padding: 18px;
        }

        .content h2 {
            font-size: 24px;
            color: #111827;
            margin-bottom: 12px;
        }

        .price {
            color: #16a34a;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .btn {
            display: inline-block;
            background: linear-gradient(90deg, #f59e0b, #ef4444);
            color: white;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 8px;
            font-weight: 600;
            transition: .3s;
        }

        .btn:hover {
            transform: translateY(-4px);
        }

        /* =========================
           Footer
        ========================= */

        footer {
            margin-top: 70px;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            color: white;
            text-align: center;
            padding: 25px;
        }

        /* =========================
           Responsive
        ========================= */

        @media(max-width:900px) {

            .navbar {
                flex-wrap: wrap;
            }

            .menu-toggle {
                display: flex;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: center;
                gap: 18px;
                margin-top: 20px;
                padding-top: 20px;
                border-top: 1px solid rgba(255, 255, 255, .15);
            }

            .nav-links.active {
                display: flex;
            }

            .search-form {
                width: 100%;
                flex-direction: column;
            }

            .search-form input,
            .search-form button {
                width: 100%;
            }

            .cart-btn {
                width: 100%;
                text-align: center;
            }

            .title {
                font-size: 32px;
            }

            .card {
                width: 100%;
                max-width: 340px;
            }
        }

        @media(max-width:600px) {

            .logo img {
                width: 120px;
                height: 50px;
            }

            .container {
                width: 95%;
                margin: 30px auto;
            }

            .title {
                font-size: 28px;
            }

            .back-btn {
                width: 100%;
                text-align: center;
                margin-bottom: 25px;
            }

            .card {
                width: 100%;
            }

            .card img {
                height: 220px;
            }

            .content h2 {
                font-size: 22px;
            }

            .price {
                font-size: 20px;
            }

            .btn {
                display: block;
                width: 100%;
                text-align: center;
            }
        }
    </style>

</head>

<body>
    <%- include("../../partials/user/navbar") %>
        <div class="container">
            <h1 class="title">
                <%= category.name %> Products
                    (<%= product.length %>)
            </h1>
            <a href="/product" class="back-btn">
                Back To Products
            </a>
            <div class="product">
                <% product.forEach(function(item){ %>
                    <div class="card">
                        <img src="<%= item.images && item.images.length ? item.images[0] : '/images/no-image.png' %>"
                            alt="<%= item.name %>">
                        <div class="content">
                            <h2>
                                <%= item.name %>
                            </h2>
                            <div class="price">
                                ₹ <%= item.price %>
                            </div>
                            <a href="/product/<%= item._id %>" class="btn">
                                View Product
                            </a>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
        <%- include("../../partials/user/footer") %>
</body>

</html>