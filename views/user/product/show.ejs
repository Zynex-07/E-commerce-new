<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= product.name %> — AAK Clothing</title>
    <link rel="stylesheet" href="/style/storefront.css">
</head>
<body>
<%- include('../../partials/user/navbar') %>

<div class="shell breadcrumb">
    <a href="/">Home</a> / <a href="/product">Shop</a> / <strong><%= product.name %></strong>
</div>

<main class="shell detail-grid">
    <section class="detail-gallery">
        <div class="main-photo">
            <img id="mainProductImage" src="<%= product.images && product.images[0] ? product.images[0] : '/images/whiteimg.jpg' %>" alt="<%= product.name %>">
        </div>
        <div class="thumbs">
            <% (product.images || []).filter(Boolean).forEach(function(img, index) { %>
                <button class="thumb <%= index === 0 ? 'active' : '' %>" type="button" onclick="changeImage(this, '<%= img %>')">
                    <img src="<%= img %>" alt="Product image <%= index + 1 %>">
                </button>
            <% }) %>
        </div>
    </section>

    <section class="detail-info">
        <div class="eyebrow">Product details</div>
        <div class="detail-rating">★★★★★ <span style="color:#667085"> New arrival</span></div>
        <h1><%= product.name %></h1>
        <div class="detail-price">₹<%= Number(product.price).toLocaleString('en-IN') %></div>
        <span class="availability <%= Number(product.stock) <= 0 ? 'out' : '' %>">
            <%= Number(product.stock) > 0 ? '✓ In stock — ' + product.stock + ' available' : 'Out of stock' %>
        </span>
        <p class="detail-desc"><%= product.description || 'A quality product selected for our store. Add it to your cart or wishlist and continue shopping.' %></p>

        <% if (Number(product.stock) <= 0) { %>
            <div id="notifiedSuccessBanner" style="display:none;background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;padding:12px 16px;border-radius:8px;font-size:14px;margin-bottom:16px;">
                ✓ <strong>Subscribed!</strong> We will email you immediately when this item is restocked.
            </div>

            <div class="back-in-stock-box" style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;padding:20px;margin-bottom:20px;">
                <div style="font-size:15px;font-weight:700;color:#111827;margin-bottom:6px;">🔔 Notify Me When Back in Stock</div>
                <p style="font-size:13px;color:#6b7280;margin:0 0 14px;line-height:1.4;">Leave your email and we'll alert you the moment this item becomes available.</p>
                <form action="/product/notify-back-in-stock" method="POST" style="display:flex;flex-direction:column;gap:10px;">
                    <input type="hidden" name="productId" value="<%= product._id %>">
                    <input type="text" name="name" placeholder="Your name (optional)" style="padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;">
                    <div style="display:flex;gap:8px;">
                        <input type="email" name="email" required placeholder="Enter your email address" style="flex:1;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;">
                        <button type="submit" style="padding:10px 20px;background:#111827;color:#fff;border:none;border-radius:6px;font-weight:600;font-size:14px;cursor:pointer;">Notify Me</button>
                    </div>
                </form>
            </div>

            <div class="detail-actions">
                <button class="add-btn" type="button" disabled style="opacity:0.5;cursor:not-allowed;">Out of Stock</button>
                <a class="heart-btn" href="/wishlist/add/<%= product._id %>">♡</a>
            </div>
        <% } else { %>
            <div class="qty-row">
                <strong style="font-size:13px">Quantity</strong>
                <div class="qty-control">
                    <button type="button" onclick="qty(-1)">−</button>
                    <input id="qty" type="number" value="1" min="1" max="<%= Math.max(Number(product.stock) || 1, 1) %>" readonly>
                    <button type="button" onclick="qty(1)">+</button>
                </div>
            </div>

            <div class="detail-actions">
                <button id="cartLink" class="add-btn" type="button" onclick="addToCart('<%= product._id %>', Number(document.getElementById('qty').value))">Add to Cart</button>
                <button id="buyLink" class="buy-btn" type="button" onclick="buyNow()">Buy Now</button>
                <a class="heart-btn" href="/wishlist/add/<%= product._id %>">♡</a>
            </div>
        <% } %>

        <div class="service-box">
            <div class="service"><strong>🚚 Fast delivery</strong><span>Quick dispatch on available items.</span></div>
            <div class="service"><strong>🔒 Secure shopping</strong><span>Your account and checkout are protected.</span></div>
            <div class="service"><strong>↩ Easy returns</strong><span>Simple support for eligible returns.</span></div>
            <div class="service"><strong>💬 Need help?</strong><span>Check your orders from your account.</span></div>
        </div>

        <div class="info-tabs">
            <div class="info-row"><strong>Availability</strong><span><%= Number(product.stock) > 0 ? 'Ready to order' : 'Currently unavailable' %></span></div>
            <div class="info-row"><strong>Product ID</strong><span><%= product._id %></span></div>
            <div class="info-row"><strong>Payment</strong><span>Secure checkout</span></div>
        </div>
    </section>
</main>

<section class="section section-soft" id="customer-reviews">
    <div class="shell">
        <div class="section-head">
            <div>
                <div class="eyebrow">Customer feedback</div>
                <h2>Customer Ratings</h2>
                <p>
                    <% if (ratingSummary && ratingSummary.count) { %>
                        <strong><%= ratingSummary.average.toFixed(1) %>/5</strong> from <%= ratingSummary.count %> review(s)
                    <% } else { %>
                        No ratings yet — be the first to review this product.
                    <% } %>
                </p>
            </div>
        </div>
        <div class="review-layout">
            <div class="review-list">
                <% if (reviews && reviews.length) { reviews.forEach(function(review) { %>
                    <article class="review-card">
                        <div class="review-stars"><%= '★'.repeat(Number(review.rating)) %><%= '☆'.repeat(5 - Number(review.rating)) %></div>
                        <p>“<%= review.comment %>”</p>
                        <strong><%= review.userName || 'Customer' %></strong>
                        <small><%= new Date(review.createdAt).toLocaleDateString('en-IN') %></small>
                    </article>
                <% }) } else { %>
                    <div class="empty">No reviews yet.</div>
                <% } %>
            </div>
            <form class="review-form" action="/product/<%= product._id %>/review" method="POST">
                <h3>Leave a rating</h3>
                <label>Rating</label>
                <select name="rating" required>
                    <option value="5">★★★★★ — 5</option>
                    <option value="4">★★★★☆ — 4</option>
                    <option value="3">★★★☆☆ — 3</option>
                    <option value="2">★★☆☆☆ — 2</option>
                    <option value="1">★☆☆☆☆ — 1</option>
                </select>
                <label>Your review</label>
                <textarea name="comment" rows="5" maxlength="500" placeholder="Tell us about the fit, quality or your experience..." required></textarea>
                <button class="primary-btn" type="submit">Submit Review</button>
                <small>Only customers who have received this product can submit one review per product.</small>
            </form>
        </div>
    </div>
</section>

<% if (typeof relatedProducts !== 'undefined' && relatedProducts.length) { %>
<section class="section section-soft">
    <div class="shell">
        <div class="section-head">
            <div>
                <div class="eyebrow">You may also like</div>
                <h2>Related Products</h2>
            </div>
            <a class="text-link" href="/product">View all →</a>
        </div>
        <div class="product-grid">
            <% relatedProducts.forEach(function(item) { %>
                <article class="product-card">
                    <div class="product-media">
                        <img src="<%= item.images && item.images[0] ? item.images[0] : '/images/whiteimg.jpg' %>" alt="<%= item.name %>">
                        <a class="wish" href="/wishlist/add/<%= item._id %>">♡</a>
                    </div>
                    <div class="product-info">
                        <h3><%= item.name %></h3>
                        <div class="rating">★★★★★ <span>(New)</span></div>
                        <div class="price-line">
                            <span class="current-price">₹<%= Number(item.price).toLocaleString('en-IN') %></span>
                        </div>
                        <div class="card-actions">
                            <a class="card-btn" href="/product/<%= item._id %>">View Product</a>
                            <button class="cart-icon-btn" type="button" onclick="addToCart('<%= item._id %>', 1)">🛒</button>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<%- include('../../partials/user/footer') %>

<script>
if (new URLSearchParams(window.location.search).get('notified') === '1') {
    const banner = document.getElementById('notifiedSuccessBanner');
    if (banner) banner.style.display = 'block';
}

function changeImage(btn, src) {
    document.getElementById('mainProductImage').src = src;
    document.querySelectorAll('.thumb').forEach(x => x.classList.remove('active'));
    btn.classList.add('active');
}

function qty(delta) {
    const el = document.getElementById('qty');
    if (!el) return;
    let n = Math.max(1, Math.min(Number(el.max) || 99, Number(el.value) + delta));
    el.value = n;
}
</script>
</body>
</html>
