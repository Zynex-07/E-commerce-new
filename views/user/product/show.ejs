<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= product.name %> — IV Store</title><link rel="stylesheet" href="/style/storefront.css"></head><body><%- include('../../partials/user/navbar') %><div class="shell breadcrumb"><a href="/">Home</a> / <a href="/product">Shop</a> / <strong><%= product.name %></strong></div>
<main class="shell detail-grid"><section class="detail-gallery"><div class="main-photo"><img id="mainProductImage" src="<%= product.images&&product.images[0]?product.images[0]:'/images/whiteimg.jpg' %>" alt="<%= product.name %>"></div><div class="thumbs"><% (product.images||[]).filter(Boolean).forEach(function(img,index){ %><button class="thumb <%= index===0?'active':'' %>" type="button" onclick="changeImage(this,'<%= img %>')"><img src="<%= img %>" alt="Product image <%= index+1 %>"></button><% }) %></div></section>
<section class="detail-info"><div class="eyebrow">Product details</div><div class="detail-rating">★★★★★ <span style="color:#667085"> New arrival</span></div><h1><%= product.name %></h1><div class="detail-price">₹<%= Number(product.price).toLocaleString('en-IN') %></div><span class="availability <%= Number(product.stock)<=0?'out':'' %>"><%= Number(product.stock)>0 ? '✓ In stock — '+product.stock+' available' : 'Out of stock' %></span><p class="detail-desc"><%= product.description || 'A quality product selected for our store. Add it to your cart or wishlist and continue shopping.' %></p>
<div class="qty-row"><strong style="font-size:13px">Quantity</strong><div class="qty-control"><button type="button" onclick="qty(-1)">−</button><input id="qty" type="number" value="1" min="1" max="<%= Math.max(Number(product.stock)||1,1) %>" readonly><button type="button" onclick="qty(1)">+</button></div></div>
<div class="detail-actions"><button id="cartLink" class="add-btn" type="button" onclick="addToCart('<%= product._id %>',Number(document.getElementById('qty').value))">Add to Cart</button><button id="buyLink" class="buy-btn" type="button" onclick="buyNow()">Buy Now</button><a class="heart-btn" href="/wishlist/add/<%= product._id %>">♡</a></div>
<div class="service-box"><div class="service"><strong>🚚 Fast delivery</strong><span>Quick dispatch on available items.</span></div><div class="service"><strong>🔒 Secure shopping</strong><span>Your account and checkout are protected.</span></div><div class="service"><strong>↩ Easy returns</strong><span>Simple support for eligible returns.</span></div><div class="service"><strong>💬 Need help?</strong><span>Check your orders from your account.</span></div></div>
<div class="info-tabs"><div class="info-row"><strong>Availability</strong><span><%= Number(product.stock)>0?'Ready to order':'Currently unavailable' %></span></div><div class="info-row"><strong>Product ID</strong><span><%= product._id %></span></div><div class="info-row"><strong>Payment</strong><span>Secure checkout</span></div></div></section></main>
<% if(typeof relatedProducts!=='undefined' && relatedProducts.length){ %><section class="section section-soft"><div class="shell"><div class="section-head"><div><div class="eyebrow">You may also like</div><h2>Related Products</h2></div><a class="text-link" href="/product">View all →</a></div><div class="product-grid"><% relatedProducts.forEach(function(item){ %><article class="product-card"><div class="product-media"><img src="<%= item.images&&item.images[0]?item.images[0]:'/images/whiteimg.jpg' %>" alt="<%= item.name %>"><a class="wish" href="/wishlist/add/<%= item._id %>">♡</a></div><div class="product-info"><h3><%= item.name %></h3><div class="rating">★★★★★ <span>(New)</span></div><div class="price-line"><span class="current-price">₹<%= Number(item.price).toLocaleString('en-IN') %></span></div><div class="card-actions"><a class="card-btn" href="/product/<%= item._id %>">View Product</a><button class="cart-icon-btn" type="button" onclick="addToCart(\'<%= item._id %>\',1)">🛒</button></div></div></article><% }) %></div></div></section><% } %>
<%- include('../../partials/user/footer') %><script>function changeImage(btn,src){document.getElementById('mainProductImage').src=src;document.querySelectorAll('.thumb').forEach(x=>x.classList.remove('active'));btn.classList.add('active')}function qty(delta){const el=document.getElementById('qty');let n=Math.max(1,Math.min(Number(el.max)||99,Number(el.value)+delta));el.value=n;}</script></body></html>
