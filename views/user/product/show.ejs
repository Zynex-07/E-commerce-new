<!DOCTYPE html>
<html>

<head>
    <title>Product Details</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            min-height: 100vh;
        }

        /*==========================
            NAVBAR
        ==========================*/
        .navbar {
            width: 100%;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo img {
            width: 150px;
            height: 60px;
            object-fit: contain;
        }

        .menu-toggle {
            display: none;
            width: 45px;
            height: 40px;
            border: 1px solid rgba(255, 255, 255, .4);
            border-radius: 6px;
            background: transparent;
            color: #fff;
            font-size: 26px;
            cursor: pointer;
            justify-content: center;
            align-items: center;
        }

        .menu-toggle:hover {
            background: rgba(255, 255, 255, .1);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: .3s;
        }

        .nav-links a:hover {
            color: #fbbf24;
        }

        .search-form {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .search-form input {
            width: 220px;
            padding: 10px;
            border: none;
            border-radius: 8px;
            outline: none;
        }

        .search-form button {
            padding: 10px 15px;
            border: none;
            border-radius: 8px;
            background: #f59e0b;
            color: #fff;
            cursor: pointer;
            font-weight: 600;
        }

        .search-form button:hover {
            background: #d97706;
        }

        .cart-btn {
            background: linear-gradient(90deg, #10b981, #059669);
            padding: 10px 18px;
            border-radius: 8px;
            color: #fff !important;
            text-decoration: none;
            font-weight: 600;
        }

        /*==========================
            BACK BUTTON
        ==========================*/
        .back-btn {
            display: inline-block;
            margin: 30px 0 20px 40px;
            padding: 12px 22px;
            background: linear-gradient(90deg, #2563eb, #1d4ed8);
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: .3s;
        }

        .back-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.4);
        }

        /*==========================
            PRODUCT CONTAINER
        ==========================*/
        .container {
            width: 92%;
            max-width: 1150px;
            margin: 0 auto 50px auto;
            background: #fff;
            border-radius: 20px;
            padding: 35px;
            display: flex;
            gap: 40px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, .12);
            animation: fadeIn .8s ease;
        }

        .images {
            width: 50%;
        }

        .images img {
            width: 100%;
            height: 500px;
            object-fit: cover;
            border-radius: 15px;
            transition: .3s;
        }

        .images img:hover {
            transform: scale(1.02);
        }

        .gallery {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }

        .gallery img {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            object-fit: cover;
            border: 2px solid #ddd;
            cursor: pointer;
            transition: .3s;
        }

        .gallery img:hover {
            border-color: #f59e0b;
            transform: scale(1.05);
        }

        .content {
            width: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .content h1 {
            font-size: 42px;
            color: #111827;
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .price {
            font-size: 34px;
            color: #16a34a;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .desc {
            margin: 20px 0;
            color: #555;
            line-height: 1.6;
            font-size: 17px;
        }

        .qty-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 25px;
        }

        .qty-group label {
            font-size: 18px;
            font-weight: 600;
            color: #111827;
        }

        .qty {
            width: 100px;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 18px;
            text-align: center;
            outline: none;
            transition: border-color 0.3s;
        }

        .qty:focus {
            border-color: #f59e0b;
        }

        /* Flexbox for Buttons to avoid <br> tags */
        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 15px;
            /* Button ke beech space */
        }

        .btn {
            display: block;
            width: 250px;
            text-align: center;
            text-decoration: none;
            background: linear-gradient(90deg, #f59e0b, #ef4444);
            color: white;
            padding: 14px;
            border-radius: 10px;
            font-weight: 600;
            transition: .3s;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        .btn.secondary {
            background: #111827;
            /* Dark button for wishlist */
        }

        .btn.disabled {
            background: #9ca3af;
            /* Grey button for Out of stock */
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important;
        }

        .btn:hover:not(.disabled) {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(239, 68, 68, 0.4);
        }

        .btn.secondary:hover:not(.disabled) {
            box-shadow: 0 5px 15px rgba(17, 24, 39, 0.4);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /*==========================
            RESPONSIVE TABLET
        ==========================*/
        @media(max-width:900px) {
            .navbar {
                flex-wrap: wrap;
            }

            .menu-toggle {
                display: flex;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                gap: 18px;
                margin-top: 20px;
                padding-top: 20px;
                border-top: 1px solid rgba(255, 255, 255, .2);
            }

            .nav-links.active {
                display: flex;
            }

            .search-form {
                width: 100%;
                flex-direction: column;
            }

            .search-form input,
            .search-form button {
                width: 100%;
            }

            .container {
                flex-direction: column;
                padding: 30px;
            }

            .images,
            .content {
                width: 100%;
            }

            .images img {
                height: 400px;
            }

            .back-btn {
                margin: 20px 0 20px 20px;
            }
        }

        /*==========================
            RESPONSIVE MOBILE
        ==========================*/
        @media(max-width:600px) {
            .logo img {
                width: 120px;
                height: 50px;
            }

            .container {
                width: 95%;
                padding: 20px;
                gap: 25px;
            }

            .images img {
                height: 300px;
                /* Reduced for smaller phones */
            }

            .gallery {
                justify-content: center;
            }

            .gallery img {
                width: 60px;
                height: 60px;
            }

            .content h1 {
                font-size: 28px;
                margin-bottom: 12px;
            }

            .price {
                font-size: 26px;
                margin-bottom: 15px;
            }

            .desc {
                font-size: 15px;
            }

            .btn {
                width: 100%;
                /* Full width buttons on mobile */
            }
        }
    </style>
</head>

<body>
    <%- include("../../partials/user/navbar") %>
        <a href="/product" class="back-btn">
            ← Back To Products
        </a>
        <div class="container">
            <div class="images">
                <% if(product.images){ %>
                    <img id="mainImage" src="<%= product.images[0]%>" alt="<%= product.name %>">
                    <% } else { %>
                        <img id="mainImage" src="https://via.placeholder.com/300" alt="No Image">
                        <% } %>
            </div>

            <div class="gallery">
                <% if(product.images && Array.isArray(product.images)){ %>
                    <% product.images.forEach(function(img) { %>
                        <img src="<%= img %>" onclick="changeImage('<%= img %>')">
                        <% }) %>
                            <% } else if(product.image){ %>
                                <img src="<%= product.image %>" onclick="changeImage('<%= product.image %>')">
                                <% } %>
            </div>

            <div class="content">
                <h1>
                    <%= product.name %>
                </h1>

                <div class="price">
                    ₹ <%= product.price %>
                </div>

                <p style="margin-bottom:10px; color: #4b5563;">
                    <strong>Current Stock:</strong>
                    <%= product.stock %>
                </p>

                <div class="desc">
                    <%= product.description %>
                </div>

                <div class="qty-group">
                    <label for="qty">Quantity</label>
                    <input type="number" value="1" min="1" max="<%= product.stock %>" id="qty" class="qty">
                </div>

                <div class="action-buttons">
                    <% if(product.stock> 0){ %>
                        <a href="#" id="cartBtn" class="btn">🛒 Add To Cart</a>
                        <a href="#" id="buyBtn" class="btn">⚡ Buy Now</a>
                        <a href="/wishlist/add/<%= product._id %>" class="btn secondary">❤️ Add To Wishlist</a>
                        <% } else { %>
                            <button class="btn disabled" disabled>❌ Out Of Stock</button>
                            <% } %>
                </div>

            </div>
        </div>
        <%- include("../../partials/user/footer") %>

            <script>
                console.log("SHOW PAGE JS LOADED");

                function changeImage(img) {
                    document.getElementById("mainImage").src = img;
                }

                const productStock = <%= product.stock %>;
                console.log("Product ID:", "<%= product._id %>");
                console.log("Stock:", productStock);

                const cartBtn = document.getElementById("cartBtn");
                if (cartBtn) {
                    cartBtn.addEventListener("click", function (e) {
                        e.preventDefault();
                        const qty = Number(document.getElementById("qty").value);
                        if (qty < 1) {
                            alert("Invalid Quantity");
                            return;
                        }
                        if (qty > productStock) {
                            alert("Only " + productStock + " items available");
                            return;
                        }
                        const url = "/cart/add/<%= product._id %>?qty=" + qty;
                        console.log(url);
                        window.location.href = url;
                    });
                }

                const buyBtn = document.getElementById("buyBtn");
                if (buyBtn) {
                    buyBtn.addEventListener("click", function (e) {
                        e.preventDefault();
                        const qty = Number(document.getElementById("qty").value);
                        if (qty < 1) {
                            alert("Invalid Quantity");
                            return;
                        }
                        if (qty > productStock) {
                            alert("Only " + productStock + " items available");
                            return;
                        }
                        window.location.href = "/cart/add/<%= product._id %>?qty=" + qty;
                    });
                }
            </script>
</body>

</html>