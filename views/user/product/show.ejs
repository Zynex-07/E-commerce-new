<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Product Details</title>


    <style>
        /* =========================================
           GLOBAL
        ========================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
        }

        body {
            min-height: 100vh;

            background:
                linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);

            color: #111827;

            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }


        /* =========================================
           BACK BUTTON
        ========================================= */

        .back-wrapper {
            width: 92%;
            max-width: 1250px;

            margin: 25px auto 15px;
        }

        .back-btn {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-height: 42px;

            padding: 10px 18px;

            background: #111827;

            color: #fff;

            text-decoration: none;

            border-radius: 8px;

            font-size: 14px;
            font-weight: 600;

            transition: 0.3s;
        }

        .back-btn:hover {
            background: #2563eb;

            transform: translateY(-2px);
        }


        /* =========================================
           MAIN PRODUCT CONTAINER
        ========================================= */

        .container {
            width: 92%;
            max-width: 1250px;

            margin: 0 auto 60px;

            padding: 30px;

            display: grid;

            grid-template-columns:
                minmax(0, 1fr) minmax(0, 1fr);

            gap: 45px;

            align-items: start;

            background: #ffffff;

            border-radius: 18px;

            box-shadow:
                0 12px 35px rgba(0, 0, 0, 0.10);
        }


        /* =========================================
           IMAGE SECTION
        ========================================= */

        .images {
            width: 100%;
            min-width: 0;
        }


        /* =========================================
           MAIN IMAGE
        ========================================= */

        .main-image-wrapper {
            width: 100%;

            height: 480px;

            display: flex;

            align-items: center;
            justify-content: center;

            overflow: hidden;

            background: #f8fafc;

            border: 1px solid #e5e7eb;

            border-radius: 14px;
        }

        .main-image {
            width: 100%;
            height: 100%;

            display: block;

            object-fit: contain;

            padding: 15px;

            border-radius: 14px;

            transition: transform 0.3s ease;
        }

        .main-image:hover {
            transform: scale(1.03);
        }


        /* =========================================
           GALLERY
        ========================================= */

        .gallery {
            width: 100%;

            margin-top: 15px;

            display: flex;

            align-items: center;

            justify-content: flex-start;

            gap: 10px;

            overflow-x: auto;

            overflow-y: hidden;

            padding: 3px 2px 8px;

            scrollbar-width: thin;
        }

        .gallery::-webkit-scrollbar {
            height: 5px;
        }

        .gallery::-webkit-scrollbar-thumb {
            background: #94a3b8;

            border-radius: 10px;
        }

        .gallery-item {
            flex: 0 0 75px;

            width: 75px;
            height: 75px;

            overflow: hidden;

            border: 2px solid transparent;

            border-radius: 9px;

            background: #f8fafc;

            cursor: pointer;

            transition: 0.3s;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;

            display: block;

            object-fit: cover;
        }

        .gallery-item:hover {
            transform: translateY(-2px);

            border-color: #94a3b8;
        }

        .gallery-item.active {
            border-color: #2563eb;

            box-shadow:
                0 0 0 2px rgba(37, 99, 235, 0.15);
        }


        /* =========================================
           PRODUCT CONTENT
        ========================================= */

        .content {
            width: 100%;
            min-width: 0;

            padding: 5px 0;
        }

        .content h1 {
            color: #0f172a;

            font-size: 38px;

            line-height: 1.2;

            margin-bottom: 15px;

            overflow-wrap: anywhere;
        }


        /* =========================================
           PRICE
        ========================================= */

        .price {
            color: #16a34a;

            font-size: 30px;

            font-weight: 700;

            line-height: 1.2;

            margin-bottom: 14px;
        }


        /* =========================================
           STOCK
        ========================================= */

        .stock {
            color: #475569;

            font-size: 15px;

            line-height: 1.5;

            margin-bottom: 15px;
        }

        .stock strong {
            color: #111827;
        }


        /* =========================================
           DESCRIPTION
        ========================================= */

        .desc {
            color: #475569;

            font-size: 15px;

            line-height: 1.7;

            margin: 15px 0 25px;

            overflow-wrap: anywhere;

            white-space: pre-line;
        }


        /* =========================================
           QUANTITY
        ========================================= */

        .qty-group {
            width: 100%;

            margin-bottom: 25px;

            display: flex;

            flex-direction: column;

            align-items: flex-start;

            gap: 8px;
        }

        .qty-group label {
            color: #111827;

            font-size: 15px;

            font-weight: 600;
        }

        .quantity-control {
            width: 145px;
            height: 45px;

            display: flex;

            align-items: center;

            overflow: hidden;

            border: 1px solid #cbd5e1;

            border-radius: 8px;

            background: #fff;
        }

        .qty-btn {
            width: 45px;
            height: 45px;

            flex-shrink: 0;

            border: none;

            background: #e2e8f0;

            color: #111827;

            font-size: 22px;

            cursor: pointer;

            transition: 0.2s;
        }

        .qty-btn:hover:not(:disabled) {
            background: #cbd5e1;
        }

        .qty-btn:disabled {
            opacity: 0.45;

            cursor: not-allowed;
        }

        .qty {
            width: 55px;
            height: 45px;

            flex: 1;

            border: none;

            outline: none;

            background: #fff;

            color: #111827;

            text-align: center;

            font-size: 17px;
        }

        /* Hide number input arrows */

        .qty::-webkit-inner-spin-button,
        .qty::-webkit-outer-spin-button {
            -webkit-appearance: none;

            margin: 0;
        }

        .qty {
            appearance: textfield;
            -moz-appearance: textfield;
        }


        /* =========================================
           ACTION BUTTONS
        ========================================= */

        .action-buttons {
            width: 100%;

            display: flex;

            flex-direction: column;

            gap: 10px;
        }

        .btn {
            width: 100%;

            min-height: 46px;

            display: flex;

            align-items: center;
            justify-content: center;

            padding: 11px 15px;

            border: none;

            border-radius: 8px;

            background:
                linear-gradient(90deg,
                    #f59e0b,
                    #ef4444);

            color: #fff;

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;

            text-align: center;

            cursor: pointer;

            transition: 0.3s;
        }

        .btn:hover:not(.disabled) {
            transform: translateY(-2px);

            box-shadow:
                0 7px 15px rgba(239, 68, 68, 0.30);
        }

        .btn.secondary {
            background: #111827;
        }

        .btn.secondary:hover:not(.disabled) {
            box-shadow:
                0 7px 15px rgba(17, 24, 39, 0.30);
        }

        .btn.disabled,
        .btn:disabled {
            background: #94a3b8;

            cursor: not-allowed;

            opacity: 0.8;
        }


        /* =========================================
           TABLET
        ========================================= */

        @media (max-width: 1000px) {

            .container {
                width: 94%;

                grid-template-columns: 1fr;

                max-width: 750px;

                gap: 30px;

                padding: 25px;
            }

            .main-image-wrapper {
                height: 430px;
            }

            .content h1 {
                font-size: 34px;
            }

            .price {
                font-size: 28px;
            }
        }


        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 600px) {

            .back-wrapper {
                width: calc(100% - 24px);

                margin: 15px auto;
            }

            .back-btn {
                width: 100%;

                min-height: 42px;

                padding: 10px 12px;

                font-size: 13px;
            }


            .container {
                width: calc(100% - 24px);

                padding: 14px;

                margin: 0 auto 35px;

                gap: 22px;

                border-radius: 14px;

                box-shadow:
                    0 8px 22px rgba(0, 0, 0, 0.09);
            }


            /* MAIN IMAGE */

            .main-image-wrapper {
                width: 100%;

                height: 300px;

                min-height: 0;

                border-radius: 10px;
            }

            .main-image {
                width: 100%;
                height: 100%;

                padding: 10px;

                object-fit: contain;

                border-radius: 10px;
            }

            .main-image:hover {
                transform: none;
            }


            /* GALLERY */

            .gallery {
                margin-top: 10px;

                gap: 7px;

                flex-wrap: nowrap;

                justify-content: flex-start;

                overflow-x: auto;

                scrollbar-width: none;

                -webkit-overflow-scrolling: touch;
            }

            .gallery::-webkit-scrollbar {
                display: none;
            }

            .gallery-item {
                flex: 0 0 60px;

                width: 60px;
                height: 60px;

                border-radius: 8px;
            }


            /* CONTENT */

            .content {
                width: 100%;
            }

            .content h1 {
                font-size: 25px;

                line-height: 1.25;

                margin-bottom: 10px;
            }

            .price {
                font-size: 23px;

                margin-bottom: 10px;
            }

            .stock {
                font-size: 13px;

                margin-bottom: 10px;
            }

            .desc {
                font-size: 14px;

                line-height: 1.6;

                margin: 14px 0 20px;
            }


            /* QUANTITY */

            .qty-group {
                margin-bottom: 20px;

                gap: 7px;
            }

            .qty-group label {
                font-size: 14px;
            }

            .quantity-control {
                width: 135px;

                height: 44px;
            }

            .qty-btn {
                width: 43px;
                height: 44px;

                font-size: 21px;
            }

            .qty {
                width: 49px;
                height: 44px;

                font-size: 17px;
            }


            /* BUTTONS */

            .action-buttons {
                width: 100%;

                gap: 8px;
            }

            .btn {
                width: 100%;

                min-height: 42px;

                padding: 10px;

                font-size: 13px;

                border-radius: 8px;
            }

            .btn:hover:not(.disabled) {
                transform: none;

                box-shadow: none;
            }
        }


        /* =========================================
           SMALL MOBILE
        ========================================= */

        @media (max-width: 400px) {

            .back-wrapper {
                width: calc(100% - 18px);

                margin-top: 12px;
                margin-bottom: 12px;
            }

            .back-btn {
                min-height: 40px;

                padding: 9px 10px;

                font-size: 12px;
            }


            .container {
                width: calc(100% - 18px);

                padding: 11px;

                gap: 18px;

                border-radius: 12px;
            }


            .main-image-wrapper {
                height: 260px;

                border-radius: 9px;
            }


            .gallery {
                gap: 6px;
            }

            .gallery-item {
                flex: 0 0 54px;

                width: 54px;
                height: 54px;

                border-radius: 7px;
            }


            .content h1 {
                font-size: 22px;

                margin-bottom: 8px;
            }

            .price {
                font-size: 21px;
            }

            .stock {
                font-size: 12px;
            }

            .desc {
                font-size: 13px;

                line-height: 1.55;
            }


            .quantity-control {
                width: 128px;

                height: 42px;
            }

            .qty-btn {
                width: 40px;
                height: 42px;
            }

            .qty {
                width: 46px;
                height: 42px;
            }


            .btn {
                min-height: 40px;

                padding: 9px;

                font-size: 12px;
            }
        }


        /* =========================================
           VERY SMALL PHONE
        ========================================= */

        @media (max-width: 330px) {

            .container {
                width: calc(100% - 12px);

                padding: 9px;

                gap: 16px;
            }

            .main-image-wrapper {
                height: 225px;
            }

            .gallery-item {
                flex-basis: 48px;

                width: 48px;
                height: 48px;
            }

            .content h1 {
                font-size: 20px;
            }

            .price {
                font-size: 19px;
            }

            .desc {
                font-size: 12px;
            }

            .quantity-control {
                width: 122px;

                height: 40px;
            }

            .qty-btn {
                width: 38px;
                height: 40px;

                font-size: 19px;
            }

            .qty {
                width: 44px;
                height: 40px;

                font-size: 16px;
            }

            .btn {
                min-height: 38px;

                font-size: 11px;
            }
        }


        /* =========================================
           TOUCH DEVICES
        ========================================= */

        @media (hover: none) {

            .gallery-item:hover {
                transform: none;

                box-shadow: none;
            }

            .btn:hover:not(.disabled) {
                transform: none;

                box-shadow: none;
            }
        }
    </style>

</head>


<body>


    <!-- =========================
         NAVBAR
    ========================= -->

    <%- include("../../partials/user/navbar") %>


        <!-- =========================
         BACK BUTTON
    ========================= -->

        <div class="back-wrapper">

            <a href="/product" class="back-btn">
                ← Back To Products
            </a>

        </div>


        <!-- =========================
         PRODUCT
    ========================= -->

        <div class="container">


            <!-- =========================
             IMAGES
        ========================= -->

            <div class="images">

                <% if(product.images && Array.isArray(product.images) && product.images.length> 0){ %>


                    <!-- MAIN IMAGE -->

                    <div class="main-image-wrapper">

                        <img id="mainImage" class="main-image" src="<%= product.images[0] %>" alt="<%= product.name %>">

                    </div>


                    <!-- THUMBNAILS -->

                    <div class="gallery">

                        <% product.images.slice(0, 4).forEach(function(img, index) { %>

                            <div class="gallery-item <%= index === 0 ? 'active' : '' %>"
                                onclick="changeImage('<%= img %>', this)">

                                <img src="<%= img %>" alt="<%= product.name %>">

                            </div>

                            <% }) %>

                    </div>


                    <% } else if(product.image){ %>


                        <!-- SINGLE IMAGE -->

                        <div class="main-image-wrapper">

                            <img id="mainImage" class="main-image" src="<%= product.image %>" alt="<%= product.name %>">

                        </div>


                        <div class="gallery">

                            <div class="gallery-item active" onclick="changeImage('<%= product.image %>', this)">

                                <img src="<%= product.image %>" alt="<%= product.name %>">

                            </div>

                        </div>


                        <% } else { %>


                            <!-- NO IMAGE -->

                            <div class="main-image-wrapper">

                                <img id="mainImage" class="main-image" src="https://via.placeholder.com/500"
                                    alt="No Image">

                            </div>


                            <% } %>

            </div>


            <!-- =========================
             PRODUCT INFORMATION
        ========================= -->

            <div class="content">


                <h1>
                    <%= product.name %>
                </h1>


                <div class="price">
                    ₹ <%= product.price %>
                </div>


                <p class="stock">

                    <strong>Current Stock:</strong>

                    <%= product.stock %>

                </p>


                <div class="desc">

                    <%= product.description %>

                </div>


                <!-- =========================
                 QUANTITY
            ========================= -->

                <div class="qty-group">

                    <label for="qty">
                        Quantity
                    </label>


                    <div class="quantity-control">


                        <button type="button" class="qty-btn" id="minusBtn" aria-label="Decrease quantity">

                            −

                        </button>


                        <input type="number" value="1" min="1" max="<%= product.stock %>" id="qty" class="qty"
                            inputmode="numeric" aria-label="Quantity">


                        <button type="button" class="qty-btn" id="plusBtn" aria-label="Increase quantity">

                            +

                        </button>


                    </div>

                </div>


                <!-- =========================
                 ACTION BUTTONS
            ========================= -->

                <div class="action-buttons">


                    <% if(product.stock> 0){ %>


                        <a href="#" id="cartBtn" class="btn">

                            🛒 Add To Cart

                        </a>


                        <a href="#" id="buyBtn" class="btn">

                            ⚡ Buy Now

                        </a>


                        <a href="/wishlist/add/<%= product._id %>" class="btn secondary">

                            ❤️ Add To Wishlist

                        </a>


                        <% } else { %>


                            <button class="btn disabled" disabled>

                                ❌ Out Of Stock

                            </button>


                            <% } %>


                </div>


            </div>

        </div>


        <!-- =========================
         FOOTER
    ========================= -->

        <%- include("../../partials/user/footer") %>


            <!-- =========================
         JAVASCRIPT
    ========================= -->

            <script>

                console.log("SHOW PAGE JS LOADED");


                /* =========================
                   CHANGE MAIN IMAGE
                ========================= */

                function changeImage(img, element) {

                    const mainImage =
                        document.getElementById("mainImage");


                    if (mainImage) {

                        mainImage.src = img;

                    }


                    document
                        .querySelectorAll(".gallery-item")
                        .forEach(function (item) {

                            item.classList.remove("active");

                        });


                    if (element) {

                        element.classList.add("active");

                    }

                }


                /* =========================
                   PRODUCT STOCK
                ========================= */

                const productStock =
            <%= product.stock %>;


                console.log(
                    "Product ID:",
                    "<%= product._id %>"
                );


                console.log(
                    "Stock:",
                    productStock
                );


                /* =========================
                   QUANTITY ELEMENTS
                ========================= */

                const qtyInput =
                    document.getElementById("qty");


                const minusBtn =
                    document.getElementById("minusBtn");


                const plusBtn =
                    document.getElementById("plusBtn");


                /* =========================
                   NORMALIZE QUANTITY
                ========================= */

                function normalizeQuantity() {

                    let qty =
                        parseInt(qtyInput.value, 10);


                    if (isNaN(qty)) {

                        qty = 1;

                    }


                    if (qty < 1) {

                        qty = 1;

                    }


                    if (qty > productStock) {

                        qty = productStock;

                    }


                    qtyInput.value = qty;


                    updateQuantityButtons();

                }


                /* =========================
                   BUTTON STATE
                ========================= */

                function updateQuantityButtons() {

                    const qty =
                        Number(qtyInput.value);


                    if (minusBtn) {

                        minusBtn.disabled =
                            qty <= 1;

                    }


                    if (plusBtn) {

                        plusBtn.disabled =
                            qty >= productStock;

                    }

                }


                /* =========================
                   MINUS
                ========================= */

                if (minusBtn) {

                    minusBtn.addEventListener(
                        "click",
                        function () {

                            let qty =
                                Number(qtyInput.value);


                            if (qty > 1) {

                                qty--;

                            }


                            qtyInput.value = qty;

                            updateQuantityButtons();

                        }
                    );

                }


                /* =========================
                   PLUS
                ========================= */

                if (plusBtn) {

                    plusBtn.addEventListener(
                        "click",
                        function () {

                            let qty =
                                Number(qtyInput.value);


                            if (qty < productStock) {

                                qty++;

                            }


                            qtyInput.value = qty;

                            updateQuantityButtons();

                        }
                    );

                }


                /* =========================
                   MANUAL INPUT
                ========================= */

                if (qtyInput) {

                    qtyInput.addEventListener(
                        "input",
                        function () {

                            normalizeQuantity();

                        }
                    );


                    qtyInput.addEventListener(
                        "blur",
                        function () {

                            normalizeQuantity();

                        }
                    );

                }


                updateQuantityButtons();


                /* =========================
                   GET QUANTITY
                ========================= */

                function getQuantity() {

                    normalizeQuantity();

                    return Number(
                        qtyInput.value
                    );

                }


                /* =========================
                   CART BUTTON
                ========================= */

                const cartBtn =
                    document.getElementById("cartBtn");


                if (cartBtn) {

                    cartBtn.addEventListener(
                        "click",
                        function (e) {

                            e.preventDefault();


                            const qty =
                                getQuantity();


                            if (qty < 1) {

                                alert(
                                    "Invalid Quantity"
                                );

                                return;

                            }


                            if (qty > productStock) {

                                alert(
                                    "Only " +
                                    productStock +
                                    " items available"
                                );

                                return;

                            }


                            const url =
                                "/cart/add/<%= product._id %>?qty=" +
                                qty;


                            console.log(url);


                            window.location.href =
                                url;

                        }
                    );

                }


                /* =========================
                   BUY NOW BUTTON
                ========================= */

                const buyBtn =
                    document.getElementById("buyBtn");


                if (buyBtn) {

                    buyBtn.addEventListener(
                        "click",
                        function (e) {

                            e.preventDefault();


                            const qty =
                                getQuantity();


                            if (qty < 1) {

                                alert(
                                    "Invalid Quantity"
                                );

                                return;

                            }


                            if (qty > productStock) {

                                alert(
                                    "Only " +
                                    productStock +
                                    " items available"
                                );

                                return;

                            }


                            window.location.href =
                                "/cart/add/<%= product._id %>?qty=" +
                                qty;

                        }
                    );

                }

            </script>


</body>

</html>