<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Shop All Products — AAK Clothing</title>
<link rel="stylesheet" href="/style/storefront.css">
<style>
.shop-layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:22px;align-items:start}.shop-filters{background:#fff;border:1px solid #e8ebef;border-radius:16px;padding:18px;position:sticky;top:90px}.shop-filters h3{font-size:17px;margin-bottom:16px;color:#101828}.filter-title{font-size:11px;text-transform:uppercase;color:#667085;font-weight:800;margin:18px 0 9px}.filter-check{display:flex;gap:9px;align-items:center;margin:9px 0;font-size:13px;color:#344054}.filter-check input{accent-color:#ff6b3d}.price-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px}.price-fields input{width:100%;height:38px;border:1px solid #d0d5dd;border-radius:8px;padding:0 9px;font-size:13px}.filter-reset{width:100%;margin-top:16px;height:38px;border:1px solid #ff6b3d;background:#fff7f4;color:#ff5a36;border-radius:9px;font-weight:800;cursor:pointer}.listing-toolbar{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:18px}.listing-tools{display:flex;gap:10px;flex:1;min-width:260px}.listing-search{height:44px;flex:1;border:1px solid #d0d5dd;border-radius:10px;padding:0 14px;font-size:14px;outline:none}.listing-sort{height:44px;border:1px solid #d0d5dd;border-radius:10px;padding:0 12px;background:#fff;font-size:13px}.result-count{color:#667085;font-size:13px;white-space:nowrap}.product-grid{min-width:0}.product-card.is-hidden{display:none!important}.filter-empty{display:none;text-align:center;padding:60px 20px;color:#667085;background:#fff;border:1px dashed #d0d5dd;border-radius:14px}.filter-empty.show{display:block}.rating-stars{color:#f59e0b;letter-spacing:1px}.rating-stars span{color:#98a2b3;letter-spacing:0}.best-tag{position:absolute;left:10px;top:10px;background:#ff6b3d;color:#fff;padding:5px 8px;border-radius:7px;font-size:9px;font-weight:900;z-index:2}.new-stock-tag{top:42px!important}.stock-tag{z-index:2}.wish{z-index:3}
@media(max-width:900px){.shop-layout{grid-template-columns:1fr}.shop-filters{position:static}.filter-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 20px}.filter-title{margin-top:8px}.listing-tools{min-width:100%}}
@media(max-width:600px){.filter-groups{grid-template-columns:1fr}.listing-toolbar{align-items:stretch}.listing-tools{flex-direction:column}.listing-sort{width:100%}}
</style>
</head>
<body>
<%- include('../../partials/user/navbar') %>
<section class="page-hero"><div class="shell"><div class="eyebrow">AAK Clothing collection</div><h1>Shop All Products</h1><p>Browse <%= product.length %> products across our latest categories.</p></div></section>
<main class="section"><div class="shell">
<div class="shop-layout">
<aside class="shop-filters">
<h3>Filters</h3>
<div class="filter-groups">
<div><div class="filter-title">Categories</div>
<% category.forEach(function(cat){ %><label class="filter-check"><input class="category-filter" type="checkbox" value="<%= String(cat.name||'').toLowerCase() %>"><span><%= cat.name %></span></label><% }) %>
</div>
<div><div class="filter-title">Stock</div>
<label class="filter-check"><input class="stock-filter" type="checkbox" value="in"> <span>In Stock</span></label>
<label class="filter-check"><input class="stock-filter" type="checkbox" value="low"> <span>Low Stock</span></label>
<label class="filter-check"><input class="stock-filter" type="checkbox" value="out"> <span>Out of Stock</span></label>
<div class="filter-title">Product</div>
<label class="filter-check"><input id="bestSellerFilter" type="checkbox"> <span>Best Seller</span></label>
<label class="filter-check"><input id="newStockFilter" type="checkbox"> <span>New Stock</span></label>
</div>
<div><div class="filter-title">Rating</div>
<label class="filter-check"><input class="rating-filter" type="checkbox" value="4"> <span>★★★★☆ & Up</span></label>
<label class="filter-check"><input class="rating-filter" type="checkbox" value="3"> <span>★★★☆☆ & Up</span></label>
<div class="filter-title">Price Range</div>
<div class="price-fields"><input id="minPrice" type="number" min="0" placeholder="Min ₹"><input id="maxPrice" type="number" min="0" placeholder="Max ₹"></div>
</div></div>
<button id="resetFilters" class="filter-reset" type="button">Reset Filters</button>
</aside>
<section>
<div class="listing-toolbar">
<div class="listing-tools"><input id="productSearch" class="listing-search" type="search" placeholder="Search products..."><select id="productSort" class="listing-sort"><option value="newest">Newest</option><option value="name">Name A-Z</option><option value="priceLow">Price Low</option><option value="priceHigh">Price High</option><option value="stockLow">Stock Low</option><option value="rating">Top Rated</option></select></div>
<span id="resultCount" class="result-count"><%= product.length %> items</span>
</div>
<div class="product-grid" id="productGrid">
<% product.forEach(function(item){ const cat = category.find(c => String(c._id) === String(item.categoryId)); const rating = Number(item.ratingAverage||0); const stock = Number(item.stock||0); const stockClass = stock<=0?'out':(stock<=5?'low':'in'); const isNewStock = item.newUntil && new Date(item.newUntil)>new Date(); %>
<article class="product-card" data-name="<%= String(item.name||'').toLowerCase() %>" data-category="<%= String(cat?.name||'').toLowerCase() %>" data-price="<%= Number(item.price||0) %>" data-stock="<%= stock %>" data-stock-status="<%= stock<=0?'out':stock<=5?'low':'in' %>" data-rating="<%= rating %>" data-bestseller="<%= item.bestSeller?'true':'false' %>" data-new="<%= isNewStock?'true':'false' %>">
<div class="product-media"><img src="<%= item.images&&item.images[0]?item.images[0]:'/images/whiteimg.jpg' %>" alt="<%= item.name %>" loading="lazy"><div class="product-badges"><% if(item.bestSeller){ %><span class="best-tag">BEST SELLER</span><% } %><span class="stock-tag <%= stockClass %>"><%= stock>0?'In stock':'Sold out' %></span><% if(isNewStock){ %><span class="new-stock-tag">NEW</span><% } %></div><a class="wish" href="/wishlist/add/<%= item._id %>">♡</a></div>
<div class="product-info"><h3><%= item.name %></h3><div class="rating-stars"><%= rating ? '★'.repeat(Math.round(rating)) + '☆'.repeat(5-Math.round(rating)) : '☆☆☆☆☆' %> <span>(<%= Number(item.ratingCount||0) %>)</span></div><div class="price-line"><span class="current-price">₹<%= Number(item.price||0).toLocaleString('en-IN') %></span></div><div class="card-actions"><a class="card-btn" href="/product/<%= item._id %>">View Product</a><button class="cart-icon-btn" type="button" onclick="addToCart('<%= item._id %>',1)">🛒</button></div></div>
</article>
<% }) %>
</div><div id="filterEmpty" class="filter-empty">No products match your selected filters.</div>
</section></div></div></main>
<%- include('../../partials/user/footer') %>
<script>
(function(){
const grid=document.getElementById('productGrid'),cards=[...grid.querySelectorAll('.product-card')],search=document.getElementById('productSearch'),sort=document.getElementById('productSort'),count=document.getElementById('resultCount'),empty=document.getElementById('filterEmpty');
const cats=[...document.querySelectorAll('.category-filter')],stocks=[...document.querySelectorAll('.stock-filter')],ratings=[...document.querySelectorAll('.rating-filter')],best=document.getElementById('bestSellerFilter'),fresh=document.getElementById('newStockFilter'),min=document.getElementById('minPrice'),max=document.getElementById('maxPrice');
function apply(){
 const q=(search.value||'').trim().toLowerCase();
 const selectedCats=cats.filter(x=>x.checked).map(x=>x.value);
 const selectedStocks=stocks.filter(x=>x.checked).map(x=>x.value);
 const selectedRatings=ratings.filter(x=>x.checked).map(x=>Number(x.value));
 const minV=min.value===''?0:Number(min.value);
 const maxV=max.value===''?Infinity:Number(max.value);
 let visible=0;
 cards.forEach(c=>{
   const stockStatus=c.dataset.stockStatus;
   const match=(c.dataset.name.includes(q)||c.dataset.category.includes(q))
     &&(!selectedCats.length||selectedCats.includes(c.dataset.category))
     &&(!selectedStocks.length||selectedStocks.includes(stockStatus))
     &&(!selectedRatings.length||selectedRatings.some(r=>Number(c.dataset.rating)>=r))
     &&(!best.checked||c.dataset.bestseller==='true')
     &&(!fresh.checked||c.dataset.new==='true')
     &&Number(c.dataset.price)>=minV&&Number(c.dataset.price)<=maxV;
   c.classList.toggle('is-hidden',!match); if(match)visible++;
 });
 const mode=sort.value;
 const sorted=[...cards].sort((a,b)=>mode==='name'?a.dataset.name.localeCompare(b.dataset.name):mode==='priceLow'?Number(a.dataset.price)-Number(b.dataset.price):mode==='priceHigh'?Number(b.dataset.price)-Number(a.dataset.price):mode==='stockLow'?Number(a.dataset.stock)-Number(b.dataset.stock):mode==='rating'?Number(b.dataset.rating)-Number(a.dataset.rating):0);
 sorted.forEach(c=>grid.appendChild(c));
 count.textContent=visible+' item'+(visible===1?'':'s');
 empty.classList.toggle('show',visible===0);
}
[search,min,max].forEach(el=>el.addEventListener('input',apply));
[sort,best,fresh,...cats,...stocks,...ratings].forEach(el=>el.addEventListener('change',apply));
document.getElementById('resetFilters').addEventListener('click',()=>{[...cats,...stocks,...ratings].forEach(x=>x.checked=false);best.checked=false;fresh.checked=false;min.value='';max.value='';search.value='';sort.value='newest';apply()});
apply();
})();
</script>
</body></html>
