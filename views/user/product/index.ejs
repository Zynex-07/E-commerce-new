<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Shop All Products — IV Store</title><link rel="stylesheet" href="/style/storefront.css"></head><body><%- include('../../partials/user/navbar') %>
<section class="page-hero"><div class="shell"><div class="eyebrow">IV Store collection</div><h1>Shop All Products</h1><p>Browse <%= product.length %> products across our latest categories.</p></div></section>
<main class="section"><div class="shell"><div class="listing-toolbar"><div class="chips"><a class="chip" href="/product">All</a><% category.forEach(function(cat){ %><a class="chip" href="/product/category/<%= cat._id %>"><%= cat.name %></a><% }) %></div><span style="color:#667085;font-size:12px"><%= product.length %> items</span></div><div class="product-grid"><% if(product.length){ product.forEach(function(item){ %><article class="product-card"><div class="product-media"><img src="<%= item.images&&item.images[0]?item.images[0]:'/images/whiteimg.jpg' %>" alt="<%= item.name %>" loading="lazy"><span class="stock-tag <%= Number(item.stock)<=0?'out':'' %>"><%= Number(item.stock)>0?'In stock':'Sold out' %></span><a class="wish" href="/wishlist/add/<%= item._id %>">♡</a></div><div class="product-info"><h3><%= item.name %></h3><div class="rating">★★★★★ <span>(New)</span></div><div class="price-line"><span class="current-price">₹<%= Number(item.price).toLocaleString('en-IN') %></span></div><div class="card-actions"><a class="card-btn" href="/product/<%= item._id %>">View Product</a><button class="cart-icon-btn" type="button" onclick="addToCart(\'<%= item._id %>\',1)">🛒</button></div></div></article><% }) } else { %><div class="empty">No products available yet.</div><% } %></div></div></main><%- include('../../partials/user/footer') %></body></html>
