<!DOCTYPE html>
<html>

<head>
    <title>All product</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f1f5f9;
        }

        /* =========================
           Navbar
        ========================= */
        .navbar {
            width: 100%;
            background: #111827;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo img {
            width: 150px;
            height: 60px;
            object-fit: contain;
        }

        .menu-toggle {
            display: none;
            width: 45px;
            height: 40px;
            border: 1px solid rgba(255, 255, 255, .4);
            border-radius: 6px;
            background: transparent;
            color: #fff;
            font-size: 26px;
            cursor: pointer;
            justify-content: center;
            align-items: center;
            transition: .3s;
        }

        .menu-toggle:hover {
            background: rgba(255, 255, 255, .1);
        }

        .menu-toggle:active {
            transform: scale(.95);
        }

        .nav-links {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 16px;
            transition: .3s;
        }

        .nav-links a:hover {
            color: #f59e0b;
        }

        .search-form {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-form input {
            width: 220px;
            padding: 10px;
            border: none;
            border-radius: 8px;
            outline: none;
        }

        .search-form button {
            padding: 10px 15px;
            border: none;
            border-radius: 8px;
            background: #f59e0b;
            color: white;
            cursor: pointer;
            font-weight: 600;
        }

        .search-form button:hover {
            background: #d97706;
        }

        .cart-btn {
            background: linear-gradient(90deg, #10b981, #059669);
            color: white !important;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(16, 185, 129, .3);
        }

        .cart-btn:hover {
            transform: translateY(-3px);
        }

        /* =========================
           Container
        ========================= */
        .container {
            width: 90%;
            max-width: 1300px;
            margin: 40px auto;
        }

        .title {
            text-align: center;
            font-size: 42px;
            margin-bottom: 35px;
            color: #111827;
        }

        /* =========================
           Products Grid (Desktop: 3 per row)
        ========================= */
        .product {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            align-items: stretch;
        }

        .card {
            width: 100%;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
        }

        .card img {
            width: 100%;
            height: 260px;
            object-fit: cover;
        }

        .content {
            padding: 22px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .content h2 {
            font-size: 22px;
            color: #111827;
            margin-bottom: 12px;
            line-height: 1.3;
        }

        .price {
            color: #16a34a;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        /* Grouping buttons to push them to the bottom together */
        .btn-group {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .wishlist-btn {
            display: block;
            text-align: center;
            text-decoration: none;
            background: linear-gradient(90deg, #f59e0b, #ef4444);
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            transition: .3s;
        }

        /* Second button secondary style for contrast (optional) */
        .wishlist-btn.secondary {
            background: #111827;
        }

        .wishlist-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(239, 68, 68, 0.4);
        }

        .wishlist-btn.secondary:hover {
            box-shadow: 0 6px 15px rgba(17, 24, 39, 0.4);
        }

        /* =========================
           Footer
        ========================= */
        footer {
            margin-top: 70px;
            background: #111827;
            color: white;
            text-align: center;
            padding: 25px;
        }

        /* =========================
           Responsive (Tablet)
        ========================= */
        @media (max-width:992px) {
            .product {
                grid-template-columns: repeat(2, 1fr);
                gap: 25px;
            }

            .navbar {
                flex-wrap: wrap;
            }

            .menu-toggle {
                display: flex;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: center;
                gap: 18px;
                margin-top: 20px;
                padding-top: 20px;
                border-top: 1px solid rgba(255, 255, 255, .15);
            }

            .nav-links.active {
                display: flex;
            }

            .search-form {
                width: 100%;
                flex-direction: column;
            }

            .search-form input,
            .search-form button {
                width: 100%;
            }

            .cart-btn {
                width: 100%;
                text-align: center;
            }
        }

        /* =========================
           Responsive (Mobile Phone)
        ========================= */
        @media (max-width:600px) {
            .container {
                width: 96%;
                margin: 30px auto;
            }

            .logo img {
                width: 100px;
                height: 40px;
            }

            .title {
                font-size: 24px;
                margin-bottom: 25px;
            }

            .product {
                grid-template-columns: repeat(3, 1fr);
                /* 3 Products per line */
                gap: 8px;
            }

            .card {
                border-radius: 8px;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
            }

            .card img {
                height: 100px;
            }

            .content {
                padding: 8px;
            }

            .content h2 {
                font-size: 11px;
                margin-bottom: 4px;
                line-height: 1.2;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .price {
                font-size: 13px;
                margin-bottom: 8px;
            }

            .btn-group {
                gap: 5px;
                /* Kam gap mobile ke liye */
            }

            .wishlist-btn {
                padding: 5px 2px;
                font-size: 8px;
                /* Chota font taaki dono buttons fit ho jayein */
                border-radius: 4px;
                letter-spacing: 0.5px;
            }
        }
    </style>
</head>

<body>
    <%- include("../../partials/user/navbar") %>
        <div class="container">
            <h1 class="title">
                All Products
            </h1>
            <div class="product">
                <% product.forEach(function(item) { %>
                    <div class="card">
                        <img src="<%= item.images && item.images.length ? item.images[0] : '/images/no-image.png' %>"
                            alt="<%= item.name %>">
                        <div class="content">
                            <h2>
                                <%= item.name %>
                            </h2>
                            <div class="price">
                                ₹ <%= item.price %>
                            </div>

                            <div class="btn-group">
                                <a href="/product/<%= item._id %>" class="wishlist-btn">
                                    View Product
                                </a>
                                <a href="/wishlist/add/<%= item._id %>" class="wishlist-btn secondary">
                                    Add To Wishlist
                                </a>
                            </div>

                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
        <%- include("../../partials/user/footer") %>
</body>

</html>