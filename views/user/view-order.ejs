<!DOCTYPE html>
<html>

<head>
    <title>Order Details</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f4f6f9;
            padding: 40px;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .heading {
            text-align: center;
            margin-bottom: 30px;
            color: #111827;
        }

        .card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .05);
        }

        /* --- PRODUCT LIST --- */
        .product {
            display: flex;
            gap: 20px;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #eee;
        }

        .product:last-child {
            border-bottom: none;
        }

        .product img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
        }

        .details {
            flex: 1;
        }

        .name {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #111827;
        }

        .price {
            color: #16a34a;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .qty {
            color: #4b5563;
            font-size: 15px;
            margin-bottom: 5px;
        }

        /* --- SUMMARY SECTION --- */
        .summary {
            margin-top: 20px;
            padding-top: 25px;
            border-top: 2px dashed #e5e7eb;
        }

        .summary h2 {
            margin-bottom: 15px;
            color: #16a34a;
            font-size: 24px;
        }

        .status-row {
            margin: 10px 0;
            font-size: 16px;
            color: #374151;
        }

        .pending {
            color: #f59e0b;
            font-weight: 600;
        }

        .cancelled {
            color: #ef4444;
            font-weight: 600;
        }

        .delivered {
            color: #22c55e;
            font-weight: 600;
        }

        .summary hr {
            border: 0;
            border-top: 1px solid #eee;
            margin: 20px 0;
        }

        /* --- ADDRESS SECTION --- */
        .summary h3 {
            margin-bottom: 15px;
            color: #111827;
            font-size: 18px;
        }

        .address-box p {
            font-size: 15px;
            color: #4b5563;
            margin-bottom: 8px;
        }

        .address-box strong {
            color: #111827;
        }

        /* --- BUTTONS --- */
        .action-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .btn-action {
            padding: 12px 22px;
            background: linear-gradient(90deg, #f59e0b, #ef4444);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: .3s;
            text-align: center;
            border: none;
            cursor: pointer;
            font-size: 15px;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(239, 68, 68, 0.3);
        }

        .btn-dark {
            background: #111827;
        }

        .btn-dark:hover {
            box-shadow: 0 5px 15px rgba(17, 24, 39, 0.3);
        }

        .empty {
            text-align: center;
            padding: 40px;
            font-size: 18px;
            color: #6b7280;
        }

        /* --- RESPONSIVE MOBILE --- */
        @media (max-width: 600px) {
            body {
                padding: 15px;
                /* Reduced body padding for mobile */
            }

            .card {
                padding: 20px;
            }

            .heading {
                font-size: 26px;
                margin-bottom: 20px;
            }

            .product {
                gap: 15px;
                padding: 15px 0;
            }

            .product img {
                width: 85px;
                height: 85px;
            }

            .name {
                font-size: 16px;
                margin-bottom: 5px;
            }

            .price {
                font-size: 15px;
            }

            .qty {
                font-size: 13px;
            }

            .summary h2 {
                font-size: 20px;
            }

            .action-buttons {
                flex-direction: column;
                /* Stack buttons on mobile */
                gap: 10px;
            }

            .btn-action {
                width: 100%;
                /* Full width buttons */
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <h1 class="heading">Order Details</h1>

        <div class="card">
            <% if(order && order.products && order.products.length> 0){ %>
                <% order.products.forEach(product=> { %>
                    <div class="product">
                        <% if(product.images){ %>
                            <img src="<%= product.images %>" alt="<%= product.name %>">
                            <% } %>
                                <div class="details">
                                    <div class="name">
                                        <%= product.name %>
                                    </div>
                                    <div class="price">
                                        Price : ₹ <%= product.price %>
                                    </div>
                                    <div class="qty">
                                        Quantity : <%= product.qty %>
                                    </div>
                                    <div class="qty" style="font-weight: 600; color: #111827;">
                                        Total : ₹ <%= product.total %>
                                    </div>
                                </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="empty">
                                No Products Found in this Order
                            </div>
                            <% } %>

                                <div class="summary">
                                    <h2>
                                        Grand Total : ₹ <%= order.total %>
                                    </h2>
                                    <div class="status-row">
                                        <strong>Status :</strong>
                                        <span class="<%= order.status.toLowerCase() %>">
                                            <%= order.status %>
                                        </span>
                                    </div>
                                    <div class="status-row">
                                        <strong>Order Date :</strong>
                                        <%= new Date(order.createdAt).toDateString() %>
                                    </div>

                                    <hr>

                                    <h3>Shipping Address</h3>
                                    <div class="address-box">
                                        <p><strong>Mobile :</strong>
                                            <%= order.shippingAddress?.mobile || "N/A" %>
                                        </p>
                                        <p><strong>Address :</strong>
                                            <%= order.shippingAddress?.address || "N/A" %>
                                        </p>
                                        <p><strong>City :</strong>
                                            <%= order.shippingAddress?.city || "N/A" %>
                                        </p>
                                        <p><strong>State :</strong>
                                            <%= order.shippingAddress?.state || "N/A" %>
                                        </p>
                                        <p><strong>Pincode :</strong>
                                            <%= order.shippingAddress?.pincode || "N/A" %>
                                        </p>
                                    </div>

                                    <div class="action-buttons">
                                        <% if(order.status==="Pending" ){ %>
                                            <a href="/order/cancel/<%= order._id %>" class="btn-action"
                                                onclick="return confirm('Are you sure you want to cancel this order?')">
                                                Cancel Order
                                            </a>
                                            <% } %>
                                                <a href="/address/edit?orderId=<%= order._id %>" class="btn-action">
                                                    Change Address
                                                </a>
                                                <a href="/order" class="btn-action btn-dark">
                                                    Back To Orders
                                                </a>
                                    </div>
                                </div>
        </div>
    </div>
</body>

</html>