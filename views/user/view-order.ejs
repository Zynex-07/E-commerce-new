<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Order details"><title>Order Details — IV Store</title>
  <link rel="stylesheet" href="/style/storefront.css">
  <style>
    .detail-page{min-height:calc(100vh - 130px);background:#f8fafc;padding:38px 0 70px}.detail-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:22px}.detail-head h1{font-size:34px;margin:5px 0}.detail-head p{color:#667085}.detail-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.75fr);gap:20px;align-items:start}.detail-card{background:#fff;border:1px solid #e4e7ec;border-radius:18px;box-shadow:0 8px 25px rgba(16,24,40,.05)}.products{padding:4px 20px}.product-row{display:grid;grid-template-columns:82px minmax(0,1fr) auto;gap:15px;align-items:center;padding:17px 0;border-bottom:1px solid #eaecf0}.product-row:last-child{border-bottom:0}.product-row img{width:82px;height:82px;border-radius:12px;object-fit:cover;background:#f2f4f7}.product-name{font-size:15px;font-weight:800;color:#101828;overflow-wrap:anywhere}.product-meta{font-size:12px;color:#667085;margin-top:5px;line-height:1.6}.product-total{font-size:15px;font-weight:800;white-space:nowrap}.summary{padding:22px;position:sticky;top:92px}.summary h2{font-size:18px;margin-bottom:15px}.summary-row{display:flex;justify-content:space-between;gap:15px;padding:9px 0;font-size:13px;color:#667085}.summary-row strong{color:#101828}.grand-total{border-top:1px solid #eaecf0;margin-top:8px;padding-top:16px;font-size:21px;font-weight:800;color:#101828}.status{display:inline-flex;padding:7px 11px;border-radius:999px;font-size:11px;font-weight:800}.status.pending{background:#fffaeb;color:#b54708}.status.paid{background:#eff8ff;color:#175cd3}.status.delivered{background:#ecfdf3;color:#027a48}.status.cancelled{background:#fef3f2;color:#b42318}.address-box{margin-top:18px;padding:15px;border:1px solid #eaecf0;border-radius:12px;background:#fcfcfd}.address-box h3{font-size:14px;margin-bottom:8px}.address-box p{font-size:12px;color:#475467;line-height:1.65}.actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:18px}.btn{min-height:43px;border:1px solid #d0d5dd;border-radius:9px;background:#fff;color:#344054;text-decoration:none;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;cursor:pointer}.btn.primary{background:#101828;border-color:#101828;color:#fff}.btn.danger{color:#b42318;border-color:#fecdca}
    @media(max-width:850px){.detail-layout{grid-template-columns:1fr}.summary{position:static}.detail-head{align-items:flex-start;flex-direction:column}}
    @media(max-width:560px){.detail-page{padding:25px 0 55px}.detail-head h1{font-size:28px}.products{padding:4px 14px}.product-row{grid-template-columns:65px minmax(0,1fr);gap:11px}.product-row img{width:65px;height:65px}.product-total{grid-column:2}.summary{padding:17px}.actions{grid-template-columns:1fr}.detail-card{border-radius:14px}}
  </style>
</head>
<body>
<%- include('../partials/user/navbar') %>
<main class="detail-page"><div class="shell">
  <div class="detail-head"><div><div class="eyebrow">Order</div><h1>Order Details</h1><p>Order placed <%= order.createdAt ? new Date(order.createdAt).toLocaleString('en-IN',{dateStyle:'medium',timeStyle:'short'}) : '—' %></p></div><a class="text-link" href="/order">← Back to orders</a></div>
  <div class="detail-layout">
    <section class="detail-card products">
      <% if(order.products?.length){ order.products.forEach(product=>{ %>
        <article class="product-row"><img src="<%= product.images||'/images/whiteimg.jpg' %>" alt="<%= product.name %>" loading="lazy"><div><div class="product-name"><%= product.name %></div><div class="product-meta">₹<%= Number(product.price||0).toLocaleString('en-IN') %> each • Quantity: <%= Number(product.qty||0) %><% if(product.category){ %> • <%= product.category %><% } %></div></div><div class="product-total">₹<%= Number(product.total||0).toLocaleString('en-IN') %></div></article>
      <% }) }else{ %><div style="padding:35px;text-align:center;color:#667085">No products found in this order.</div><% } %>
    </section>
    <aside class="detail-card summary">
      <h2>Order Summary</h2>
      <div class="summary-row"><span>Status</span><span class="status <%= String(order.status||'Pending').toLowerCase() %>"><%= order.status||'Pending' %></span></div>
      <div class="summary-row"><span>Payment</span><strong><%= order.paymentMethod||'—' %></strong></div>
      <% if(order.paymentId){ %><div class="summary-row"><span>Payment ID</span><strong style="font-size:10px;overflow-wrap:anywhere;text-align:right"><%= order.paymentId %></strong></div><% } %>
      <div class="summary-row grand-total"><span>Total</span><span>₹<%= Number(order.total||0).toLocaleString('en-IN') %></span></div>
      <div class="address-box"><h3>Delivery Address</h3><p><strong><%= order.shippingAddress?.mobile||'N/A' %></strong><br><%= order.shippingAddress?.address||'N/A' %><br><%= order.shippingAddress?.city||'' %><%= order.shippingAddress?.city&&order.shippingAddress?.state?', ':'' %><%= order.shippingAddress?.state||'' %> - <%= order.shippingAddress?.pincode||'N/A' %></p></div>
      <div class="actions">
        <% if(['Pending','Paid'].includes(order.status)){ %><form action="/order/cancel/<%= order._id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this order?')"><button class="btn danger" type="submit">Cancel Order</button></form><% } %>
        <a class="btn primary" href="/address/edit">Edit Address</a><a class="btn" href="/order">All Orders</a>
      </div>
    </aside>
  </div>
</div></main>
<%- include('../partials/user/footer') %>
</body></html>
