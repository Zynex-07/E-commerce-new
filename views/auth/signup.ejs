<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup | AAK Clothing</title>
    <link rel="stylesheet" href="/style/auth.css">
</head>
<body>
    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-logo">
                <img src="/images/logo.png" alt="AAK Clothing Logo">
            </div>
            <div class="auth-kicker">Join AAK Clothing</div>
            <h1>Create Account</h1>
            <p class="auth-subtitle">Create your account and start exploring our collection.</p>

            <form class="auth-form" action="/auth/signup" method="POST">
                <div class="field">
                    <label for="name">Name</label>
                    <input id="name" type="text" name="name" placeholder="Enter your name" autocomplete="name" required>
                </div>

                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" type="email" name="email" placeholder="Enter your email" autocomplete="email" required>
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <input id="password" type="password" name="password" placeholder="Create a password" autocomplete="new-password" required>
                </div>

                <button class="auth-button" type="submit">Create Account</button>
            </form>

            <div class="auth-link">
                Already have an account?
                <a href="/auth/login">Login</a>
            </div>
            <div class="auth-footer">AAK Clothing • Style that fits your everyday.</div>
        </section>
    </main>
</body>
</html>
