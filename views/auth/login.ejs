<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | AAK Clothing</title>
    <link rel="stylesheet" href="/style/auth.css">
</head>
<body>
    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-logo">
                <img src="/images/logo.png" alt="AAK Clothing Logo">
            </div>
            <div class="auth-kicker">Welcome back</div>
            <h1>Login</h1>
            <p class="auth-subtitle">Sign in to continue shopping with AAK Clothing.</p>

            <form class="auth-form" action="/auth/login" method="POST">
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" type="email" name="email" placeholder="Enter your email" autocomplete="email" required>
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <input id="password" type="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
                </div>

                <button class="auth-button" type="submit">Login</button>
            </form>

            <div class="auth-link">
                Don't have an account?
                <a href="/auth/signup">Create an account</a>
            </div>
            <div class="auth-footer">AAK Clothing • Style that fits your everyday.</div>
        </section>
    </main>
</body>
</html>
