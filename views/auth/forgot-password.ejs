<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | AAK Clothing</title>
    <link rel="stylesheet" href="/style/auth.css">
</head>
<body>
<main class="auth-shell">
    <section class="auth-card">
        <div class="auth-logo"><img src="/images/logo.png" alt="AAK Clothing Logo"></div>
        <div class="auth-kicker">Account Recovery</div>
        <h1>Forgot Password?</h1>
        <p class="auth-subtitle">Enter your registered phone number to create a new password.</p>

        <% if (error) { %><div class="auth-alert error"><%= error %></div><% } %>
        <% if (message) { %><div class="auth-alert success"><%= message %></div><% } %>

        <form class="auth-form" action="/auth/forgot-password" method="POST">
            <div class="field">
                <label for="phone">Phone Number</label>
                <input id="phone" type="tel" name="phone" value="<%= phone || '' %>"
                       inputmode="numeric" maxlength="14" placeholder="Enter 10-digit phone number"
                       autocomplete="tel" required>
            </div>
            <button class="auth-button" type="submit">Continue</button>
        </form>

        <div class="auth-link"><a href="/auth/login">← Back to Login</a></div>
        <div class="auth-footer">Your phone number must be registered with your account.</div>
    </section>
</main>
</body>
</html>
