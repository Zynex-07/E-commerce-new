<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="View order details">

    <title>Order Details</title>


    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');


        /* =====================================================
           GLOBAL
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }


        html,
        body {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
        }


        body {
            min-height: 100vh;

            background:
                linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);

            color: #111827;

            padding:
                35px 20px 80px;
        }


        /* =====================================================
           MAIN CONTAINER
        ===================================================== */

        .container {
            width: 100%;
            max-width: 1100px;

            margin: 0 auto;
        }


        /* =====================================================
           HEADING
        ===================================================== */

        .heading {
            text-align: center;

            margin-bottom: 30px;

            color: #111827;

            font-size: 42px;

            font-weight: 700;

            line-height: 1.2;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           MAIN CARD
        ===================================================== */

        .card {
            width: 100%;

            background: #fff;

            border-radius: 16px;

            padding: 30px;

            box-shadow:
                0 10px 25px rgba(0, 0, 0, .07);

            overflow: hidden;
        }


        /* =====================================================
           PRODUCT
        ===================================================== */

        .product {
            width: 100%;

            display: flex;

            align-items: center;

            gap: 20px;

            padding:
                20px 0;

            border-bottom:
                1px solid #eee;
        }


        .product:last-child {
            border-bottom: none;
        }


        .product img {
            width: 120px;

            height: 120px;

            flex: 0 0 120px;

            object-fit: cover;

            border-radius: 10px;

            border:
                1px solid #ddd;

            background: #f8fafc;
        }


        /* =====================================================
           PRODUCT DETAILS
        ===================================================== */

        .details {
            flex: 1;

            min-width: 0;
        }


        .name {
            font-size: 20px;

            font-weight: 600;

            margin-bottom: 8px;

            color: #111827;

            line-height: 1.4;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        .price {
            color: #16a34a;

            font-size: 18px;

            font-weight: 600;

            margin-bottom: 5px;

            line-height: 1.5;

            overflow-wrap: anywhere;
        }


        .qty {
            color: #4b5563;

            font-size: 15px;

            margin-bottom: 5px;

            line-height: 1.5;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        .total-price {
            color: #111827;

            font-weight: 600;
        }


        /* =====================================================
           SUMMARY
        ===================================================== */

        .summary {
            margin-top: 20px;

            padding-top: 25px;

            border-top:
                2px dashed #e5e7eb;
        }


        .summary h2 {
            margin-bottom: 15px;

            color: #16a34a;

            font-size: 26px;

            line-height: 1.35;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        /* =====================================================
           STATUS / DATE
        ===================================================== */

        .status-row {
            margin:
                10px 0;

            font-size: 16px;

            color: #374151;

            line-height: 1.6;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        .status-row strong {
            color: #111827;
        }


        .pending {
            color: #f59e0b;

            font-weight: 600;
        }


        .cancelled {
            color: #ef4444;

            font-weight: 600;
        }


        .delivered {
            color: #22c55e;

            font-weight: 600;
        }


        /* =====================================================
           HR
        ===================================================== */

        .summary hr {
            border: 0;

            border-top:
                1px solid #eee;

            margin:
                25px 0;
        }


        /* =====================================================
           SHIPPING ADDRESS
        ===================================================== */

        .summary h3 {
            margin-bottom: 15px;

            color: #111827;

            font-size: 20px;

            line-height: 1.4;
        }


        .address-box {
            width: 100%;

            background: #f8fafc;

            border:
                1px solid #e5e7eb;

            border-radius: 10px;

            padding: 18px;
        }


        .address-box p {
            font-size: 15px;

            color: #4b5563;

            margin-bottom: 9px;

            line-height: 1.6;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        .address-box p:last-child {
            margin-bottom: 0;
        }


        .address-box strong {
            color: #111827;

            font-weight: 600;
        }


        /* =====================================================
           BUTTONS
        ===================================================== */

        .action-buttons {
            width: 100%;

            display: flex;

            gap: 12px;

            flex-wrap: wrap;

            margin-top: 30px;
        }


        .btn-action {
            flex: 1;

            min-width: 180px;

            min-height: 48px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding:
                12px 20px;

            background:
                linear-gradient(90deg,
                    #f59e0b,
                    #ef4444);

            color: white;

            text-decoration: none;

            border-radius: 8px;

            font-weight: 600;

            transition:
                transform .25s ease,
                box-shadow .25s ease;

            text-align: center;

            border: none;

            cursor: pointer;

            font-size: 14px;

            line-height: 1.3;

            overflow-wrap: anywhere;
        }


        .btn-action:hover {
            transform: translateY(-2px);

            box-shadow:
                0 5px 15px rgba(239, 68, 68, .3);
        }


        .btn-dark {
            background: #111827;
        }


        .btn-dark:hover {
            box-shadow:
                0 5px 15px rgba(17, 24, 39, .3);
        }


        /* =====================================================
           EMPTY
        ===================================================== */

        .empty {
            width: 100%;

            text-align: center;

            padding:
                45px 20px;

            font-size: 19px;

            color: #6b7280;

            line-height: 1.5;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 900px) {

            body {
                padding:
                    25px 16px 60px;
            }


            .heading {
                font-size: 36px;

                margin-bottom: 25px;
            }


            .card {
                padding: 25px;
            }


            .product {
                gap: 16px;
            }


            .product img {
                width: 105px;

                height: 105px;

                flex-basis: 105px;
            }


            .name {
                font-size: 18px;
            }


            .price {
                font-size: 17px;
            }


            .summary h2 {
                font-size: 24px;
            }

        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            body {
                padding:
                    18px 10px 50px;
            }


            .heading {
                font-size: 28px;

                margin-bottom: 20px;
            }


            .card {
                padding:
                    18px 15px;

                border-radius: 12px;
            }


            .product {
                align-items: flex-start;

                gap: 12px;

                padding:
                    15px 0;
            }


            .product img {
                width: 85px;

                height: 85px;

                flex-basis: 85px;

                border-radius: 8px;
            }


            .details {
                padding-top: 1px;
            }


            .name {
                font-size: 16px;

                margin-bottom: 5px;
            }


            .price {
                font-size: 15px;

                margin-bottom: 4px;
            }


            .qty {
                font-size: 13px;

                margin-bottom: 4px;
            }


            .summary {
                margin-top: 15px;

                padding-top: 20px;
            }


            .summary h2 {
                font-size: 21px;

                margin-bottom: 13px;
            }


            .status-row {
                font-size: 13px;

                margin: 8px 0;

                line-height: 1.55;
            }


            .summary hr {
                margin:
                    20px 0;
            }


            .summary h3 {
                font-size: 18px;

                margin-bottom: 12px;
            }


            .address-box {
                padding:
                    14px;

                border-radius: 8px;
            }


            .address-box p {
                font-size: 13px;

                margin-bottom: 7px;

                line-height: 1.55;
            }


            .action-buttons {
                flex-direction: column;

                gap: 9px;

                margin-top: 22px;
            }


            .btn-action {
                width: 100%;

                min-width: 0;

                flex: none;

                min-height: 45px;

                padding:
                    10px 12px;

                font-size: 13px;

                border-radius: 7px;
            }


            .empty {
                padding:
                    35px 10px;

                font-size: 17px;
            }


            .btn-action:hover,
            .btn-dark:hover {
                transform: none;

                box-shadow: none;
            }

        }


        /* =====================================================
           SMALL MOBILE
        ===================================================== */

        @media (max-width: 400px) {

            body {
                padding:
                    14px 7px 40px;
            }


            .heading {
                font-size: 24px;

                margin-bottom: 16px;
            }


            .card {
                padding:
                    14px 11px;

                border-radius: 10px;
            }


            .product {
                gap: 9px;

                padding:
                    13px 0;
            }


            .product img {
                width: 70px;

                height: 70px;

                flex-basis: 70px;

                border-radius: 7px;
            }


            .name {
                font-size: 14px;

                line-height: 1.35;
            }


            .price {
                font-size: 13px;

                line-height: 1.4;
            }


            .qty {
                font-size: 11px;

                line-height: 1.4;
            }


            .summary {
                margin-top: 12px;

                padding-top: 17px;
            }


            .summary h2 {
                font-size: 18px;
            }


            .status-row {
                font-size: 11px;

                line-height: 1.5;
            }


            .summary h3 {
                font-size: 16px;
            }


            .address-box {
                padding: 11px;
            }


            .address-box p {
                font-size: 11px;

                line-height: 1.5;
            }


            .btn-action {
                min-height: 42px;

                padding:
                    9px 8px;

                font-size: 11px;
            }


            .empty {
                font-size: 15px;

                padding:
                    28px 6px;
            }

        }


        /* =====================================================
           VERY SMALL PHONES
        ===================================================== */

        @media (max-width: 330px) {

            body {
                padding:
                    10px 5px 35px;
            }


            .heading {
                font-size: 21px;
            }


            .card {
                padding:
                    11px 9px;
            }


            .product {
                gap: 8px;
            }


            .product img {
                width: 62px;

                height: 62px;

                flex-basis: 62px;
            }


            .name {
                font-size: 13px;
            }


            .price {
                font-size: 12px;
            }


            .qty {
                font-size: 10px;
            }


            .summary h2 {
                font-size: 16px;
            }


            .status-row {
                font-size: 10px;
            }


            .address-box p {
                font-size: 10px;
            }


            .btn-action {
                min-height: 40px;

                font-size: 10px;
            }

        }


        /* =====================================================
           TOUCH DEVICES
        ===================================================== */

        @media (hover: none) {

            .btn-action:hover,
            .btn-dark:hover {
                transform: none;

                box-shadow: none;
            }

        }
    </style>

</head>


<body>


    <div class="container">


        <!-- =================================================
             HEADING
        ================================================= -->

        <h1 class="heading">
            Order Details
        </h1>


        <!-- =================================================
             ORDER CARD
        ================================================= -->

        <div class="card">


            <% if(order && order.products && order.products.length> 0){ %>


                <!-- =============================================
                     PRODUCTS
                ============================================== -->

                <% order.products.forEach(product=> { %>


                    <div class="product">


                        <% if(product.images){ %>

                            <img src="<%= product.images %>" alt="<%= product.name %>" loading="lazy">

                            <% } %>


                                <div class="details">


                                    <div class="name">

                                        <%= product.name %>

                                    </div>


                                    <div class="price">

                                        Price : ₹ <%= product.price %>

                                    </div>


                                    <div class="qty">

                                        Quantity : <%= product.qty %>

                                    </div>


                                    <div class="qty total-price">

                                        Total : ₹ <%= product.total %>

                                    </div>


                                </div>


                    </div>


                    <% }) %>


                        <% } else { %>


                            <!-- =============================================
                     NO PRODUCTS
                ============================================== -->

                            <div class="empty">

                                No Products Found in this Order

                            </div>


                            <% } %>


                                <!-- =================================================
                 SUMMARY
            ================================================= -->

                                <div class="summary">


                                    <!-- GRAND TOTAL -->

                                    <h2>

                                        Grand Total : ₹ <%= order.total %>

                                    </h2>


                                    <!-- STATUS -->

                                    <div class="status-row">

                                        <strong>
                                            Status :
                                        </strong>

                                        <span class="<%= order.status.toLowerCase() %>">

                                            <%= order.status %>

                                        </span>

                                    </div>


                                    <!-- ORDER DATE -->

                                    <div class="status-row">

                                        <strong>
                                            Order Date :
                                        </strong>

                                        <%= new Date(order.createdAt).toDateString() %>

                                    </div>


                                    <hr>


                                    <!-- =================================================
                     SHIPPING ADDRESS
                ================================================= -->

                                    <h3>
                                        Shipping Address
                                    </h3>


                                    <div class="address-box">


                                        <p>

                                            <strong>
                                                Mobile :
                                            </strong>

                                            <%= order.shippingAddress?.mobile || "N/A" %>

                                        </p>


                                        <p>

                                            <strong>
                                                Address :
                                            </strong>

                                            <%= order.shippingAddress?.address || "N/A" %>

                                        </p>


                                        <p>

                                            <strong>
                                                City :
                                            </strong>

                                            <%= order.shippingAddress?.city || "N/A" %>

                                        </p>


                                        <p>

                                            <strong>
                                                State :
                                            </strong>

                                            <%= order.shippingAddress?.state || "N/A" %>

                                        </p>


                                        <p>

                                            <strong>
                                                Pincode :
                                            </strong>

                                            <%= order.shippingAddress?.pincode || "N/A" %>

                                        </p>


                                    </div>


                                    <!-- =================================================
                     ACTION BUTTONS
                ================================================= -->

                                    <div class="action-buttons">


                                        <% if(order.status==="Pending" ){ %>


                                            <a href="/order/cancel/<%= order._id %>" class="btn-action"
                                                onclick="return confirm('Are you sure you want to cancel this order?')">

                                                Cancel Order

                                            </a>


                                            <% } %>


                                                <a href="/address/edit?orderId=<%= order._id %>" class="btn-action">

                                                    Change Address

                                                </a>


                                                <a href="/order" class="btn-action btn-dark">

                                                    Back To Orders

                                                </a>


                                    </div>


                                </div>


        </div>


    </div>


</body>

</html>