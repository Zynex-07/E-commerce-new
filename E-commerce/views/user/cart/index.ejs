<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cart</title>


    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');


        /* ===========================
           GLOBAL
        =========================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
        }

        body {
            min-height: 100vh;

            background:
                linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);

            padding-bottom: 80px;

            color: #111827;
        }


        /* ===========================
           CONTAINER
        =========================== */

        .container {
            width: 92%;
            max-width: 1000px;

            margin: 20px auto 40px;
        }


        /* ===========================
           TITLE
        =========================== */

        .title {
            text-align: center;

            font-size: 42px;

            font-weight: 700;

            color: #0f172a;

            margin-bottom: 35px;

            line-height: 1.2;
        }


        /* ===========================
           BACK BUTTON
        =========================== */

        .back-btn {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            margin: 30px 0 20px 40px;

            padding: 12px 22px;

            background:
                linear-gradient(90deg,
                    #2563eb,
                    #1d4ed8);

            color: #fff;

            text-decoration: none;

            border-radius: 8px;

            font-weight: 600;

            font-size: 14px;

            transition: 0.3s;
        }

        .back-btn:hover {
            transform: translateY(-3px);

            box-shadow:
                0 5px 15px rgba(37, 99, 235, 0.4);
        }


        /* ===========================
           CART ITEMS
        =========================== */

        .cart-items {
            width: 100%;

            display: flex;

            flex-direction: column;

            gap: 20px;
        }


        /* ===========================
           CART CARD
        =========================== */

        .card {
            width: 100%;
            min-width: 0;

            background: #fff;

            border-radius: 15px;

            padding: 20px;

            display: flex;

            align-items: center;

            gap: 25px;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, .06);

            transition: .3s;
        }

        .card:hover {
            transform: translateY(-3px);

            box-shadow:
                0 12px 25px rgba(0, 0, 0, .12);
        }


        /* ===========================
           PRODUCT IMAGE
        =========================== */

        .card img {
            width: 120px;
            height: 120px;

            flex: 0 0 120px;

            object-fit: cover;

            border-radius: 10px;

            border: 1px solid #f1f5f9;

            background: #f8fafc;
        }


        /* ===========================
           PRODUCT DETAILS
        =========================== */

        .details {
            flex: 1;

            min-width: 0;
        }

        .details h3 {
            font-size: 24px;

            margin-bottom: 8px;

            color: #111827;

            line-height: 1.3;

            overflow-wrap: anywhere;
        }

        .details p {
            margin-bottom: 6px;

            color: #4b5563;

            font-size: 15px;

            line-height: 1.5;

            overflow-wrap: anywhere;
        }

        .details p strong {
            color: #111827;
        }

        .price {
            color: #16a34a !important;

            font-weight: 700;

            font-size: 18px;

            margin-top: 8px;
        }


        /* ===========================
           REMOVE BUTTON
        =========================== */

        .remove-btn {
            flex: 0 0 auto;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-width: 105px;

            min-height: 42px;

            padding: 10px 20px;

            border-radius: 8px;

            color: #fff;

            text-decoration: none;

            font-weight: 600;

            font-size: 14px;

            background: #ef4444;

            text-align: center;

            transition: .3s;
        }

        .remove-btn:hover {
            background: #dc2626;

            box-shadow:
                0 5px 15px rgba(220, 38, 38, .3);

            transform: translateY(-2px);
        }


        /* ===========================
           SUMMARY
        =========================== */

        .summary {
            width: 100%;

            margin-top: 35px;

            background: #fff;

            padding: 30px;

            border-radius: 15px;

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 20px;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, .08);
        }

        .summary h2 {
            color: #16a34a;

            font-size: 28px;

            line-height: 1.3;

            overflow-wrap: anywhere;
        }


        /* ===========================
           ORDER BUTTON
        =========================== */

        .order-btn {
            flex: 0 0 auto;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-height: 46px;

            padding: 14px 28px;

            border-radius: 8px;

            color: #fff;

            text-decoration: none;

            font-weight: 600;

            font-size: 16px;

            background:
                linear-gradient(90deg,
                    #f59e0b,
                    #ef4444);

            text-align: center;

            transition: .3s;
        }

        .order-btn:hover {
            transform: translateY(-3px);

            box-shadow:
                0 8px 20px rgba(239, 68, 68, .35);
        }


        /* ===========================
           EMPTY CART
        =========================== */

        .empty {
            width: 100%;

            text-align: center;

            background: #fff;

            padding: 60px 20px;

            border-radius: 15px;

            font-size: 26px;

            font-weight: 600;

            color: #64748b;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, .06);

            margin-top: 20px;
        }


        /* ===========================
           TABLET
        =========================== */

        @media (max-width: 992px) {

            .container {
                width: 94%;

                max-width: 850px;
            }

            .title {
                font-size: 38px;
            }

            .back-btn {
                margin-left: 20px;
            }

            .card {
                gap: 20px;
            }

            .card img {
                width: 105px;
                height: 105px;

                flex-basis: 105px;
            }

            .details h3 {
                font-size: 21px;
            }

            .summary {
                padding: 25px;
            }

            .summary h2 {
                font-size: 25px;
            }
        }


        /* ===========================
           MOBILE
        =========================== */

        @media (max-width: 600px) {

            .container {
                width: calc(100% - 24px);

                margin:
                    10px auto 30px;
            }


            /* TITLE */

            .title {
                font-size: 30px;

                margin-bottom: 20px;
            }


            /* BACK BUTTON */

            .back-btn {
                width: calc(100% - 24px);

                margin:
                    15px 12px 10px;

                padding: 10px 18px;

                font-size: 14px;
            }


            /* CARD */

            .card {
                width: 100%;

                padding: 15px;

                gap: 15px;

                align-items: flex-start;

                flex-wrap: wrap;

                border-radius: 12px;
            }

            .card:hover {
                transform: none;

                box-shadow:
                    0 8px 20px rgba(0, 0, 0, .06);
            }


            /* IMAGE */

            .card img {
                width: 90px;
                height: 90px;

                flex: 0 0 90px;

                border-radius: 8px;
            }


            /* DETAILS */

            .details {
                flex:
                    1 1 calc(100% - 105px);

                min-width: 0;
            }

            .details h3 {
                font-size: 18px;

                margin-bottom: 5px;

                line-height: 1.3;
            }

            .details p {
                font-size: 13px;

                margin-bottom: 4px;
            }

            .price {
                font-size: 15px;

                margin-top: 5px;
            }


            /* REMOVE */

            .remove-btn {
                width: 100%;

                flex: 0 0 100%;

                min-height: 40px;

                margin-top: 5px;

                padding: 10px;

                font-size: 13px;
            }

            .remove-btn:hover {
                transform: none;

                box-shadow: none;
            }


            /* SUMMARY */

            .summary {
                flex-direction: column;

                gap: 20px;

                padding: 25px 20px;

                text-align: center;

                border-radius: 12px;
            }

            .summary h2 {
                font-size: 22px;

                line-height: 1.4;
            }


            /* ORDER */

            .order-btn {
                width: 100%;

                min-height: 44px;

                padding: 11px;

                font-size: 14px;
            }

            .order-btn:hover {
                transform: none;

                box-shadow: none;
            }


            /* EMPTY */

            .empty {
                font-size: 20px;

                padding: 40px 15px;

                border-radius: 12px;
            }

        }


        /* ===========================
           SMALL MOBILE
        =========================== */

        @media (max-width: 400px) {

            .container {
                width: calc(100% - 18px);
            }

            .title {
                font-size: 26px;

                margin-bottom: 18px;
            }

            .back-btn {
                width: calc(100% - 18px);

                margin-left: 9px;
                margin-right: 9px;

                min-height: 40px;

                padding: 9px 12px;

                font-size: 13px;
            }

            .card {
                padding: 12px;

                gap: 12px;

                border-radius: 10px;
            }

            .card img {
                width: 78px;
                height: 78px;

                flex-basis: 78px;
            }

            .details {
                flex-basis:
                    calc(100% - 90px);
            }

            .details h3 {
                font-size: 16px;
            }

            .details p {
                font-size: 12px;
            }

            .price {
                font-size: 14px;
            }

            .remove-btn {
                min-height: 38px;

                font-size: 12px;

                padding: 9px;
            }

            .summary {
                padding: 20px 14px;

                gap: 16px;
            }

            .summary h2 {
                font-size: 20px;
            }

            .order-btn {
                min-height: 42px;

                font-size: 13px;
            }

            .empty {
                font-size: 18px;

                padding: 35px 12px;
            }

        }


        /* ===========================
           VERY SMALL PHONE
        =========================== */

        @media (max-width: 330px) {

            .container {
                width: calc(100% - 14px);
            }

            .title {
                font-size: 23px;
            }

            .back-btn {
                width: calc(100% - 14px);

                margin-left: 7px;
                margin-right: 7px;

                font-size: 12px;
            }

            .card {
                padding: 10px;

                gap: 10px;
            }

            .card img {
                width: 70px;
                height: 70px;

                flex-basis: 70px;
            }

            .details {
                flex-basis:
                    calc(100% - 80px);
            }

            .details h3 {
                font-size: 14px;
            }

            .details p {
                font-size: 11px;
            }

            .price {
                font-size: 13px;
            }

            .remove-btn {
                min-height: 36px;

                font-size: 11px;
            }

            .summary h2 {
                font-size: 18px;
            }

            .order-btn {
                min-height: 40px;

                font-size: 12px;
            }

            .empty {
                font-size: 16px;

                padding: 30px 10px;
            }

        }


        /* ===========================
           TOUCH DEVICES
        =========================== */

        @media (hover: none) {

            .card:hover {
                transform: none;
            }

            .remove-btn:hover,
            .order-btn:hover,
            .back-btn:hover {
                transform: none;

                box-shadow: none;
            }

        }
    </style>

</head>


<body>


    <!-- ===========================
         NAVBAR
    =========================== -->

    <%- include("../../partials/user/navbar") %>


        <!-- ===========================
         BACK BUTTON
    =========================== -->

        <a href="/product" class="back-btn">
            ← Back To Products
        </a>


        <!-- ===========================
         MAIN CONTAINER
    =========================== -->

        <div class="container">


            <h1 class="title">
                My Cart
            </h1>


            <% if(cart.length> 0){ %>


                <!-- ===========================
                 CART ITEMS
            =========================== -->

                <div class="cart-items">


                    <% cart.forEach(item=> { %>


                        <div class="card">


                            <!-- PRODUCT IMAGE -->

                            <img src="<%= item.images || '/images/no-image.png' %>" alt="<%= item.name %>">


                            <!-- PRODUCT DETAILS -->

                            <div class="details">


                                <h3>
                                    <%= item.name %>
                                </h3>


                                <p>
                                    <strong>Qty:</strong>
                                    <%= item.qty %>
                                </p>


                                <p>
                                    <strong>Price:</strong>
                                    ₹ <%= item.price %>
                                </p>


                                <p class="price">
                                    Total:
                                    ₹ <%= item.total %>
                                </p>


                            </div>


                            <!-- REMOVE BUTTON -->

                            <a href="/cart/clear" class="remove-btn">

                                Remove

                            </a>


                        </div>


                        <% }) %>


                </div>


                <!-- ===========================
                 SUMMARY
            =========================== -->

                <div class="summary">


                    <h2>
                        Grand Total:
                        ₹ <%= grandTotal %>
                    </h2>


                    <a href="/order/place" class="order-btn">

                        Place Order

                    </a>


                </div>


                <% } else { %>


                    <!-- ===========================
                 EMPTY CART
            =========================== -->

                    <div class="empty">

                        🛒 Your Cart Is Empty

                    </div>


                    <% } %>


        </div>


        <!-- ===========================
         FOOTER
    =========================== -->

        <%- include("../../partials/user/footer") %>


</body>

</html>