<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="My Wishlist">

    <title>My Wishlist</title>


    <style>
        /* =====================================================
           GLOBAL
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
        }

        body {
            min-height: 100vh;

            background:
                linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);

            color: #111827;

            font-family:
                'Poppins',
                Arial,
                Helvetica,
                sans-serif;
        }


        /* =====================================================
           PAGE WRAPPER
        ===================================================== */

        .wishlist-page {
            width: 100%;
            min-height: calc(100vh - 100px);

            padding: 0 0 50px;
        }


        /* =====================================================
           BACK BUTTON
        ===================================================== */

        .back-wrapper {
            width: 92%;
            max-width: 1100px;

            margin: 25px auto 20px;
        }

        .back-btn {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-height: 44px;

            padding: 11px 20px;

            background:
                linear-gradient(90deg,
                    #2563eb,
                    #1d4ed8);

            color: #fff;

            text-decoration: none;

            border-radius: 9px;

            font-size: 14px;

            font-weight: 600;

            transition:
                transform .25s ease,
                box-shadow .25s ease,
                background .25s ease;
        }

        .back-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 7px 18px rgba(37, 99, 235, .30);
        }


        /* =====================================================
           MAIN CONTAINER
        ===================================================== */

        .container {
            width: 92%;
            max-width: 1100px;

            margin: 0 auto;
        }


        /* =====================================================
           PAGE TITLE
        ===================================================== */

        .page-title {
            text-align: center;

            color: #0f172a;

            font-size: 42px;

            font-weight: 700;

            line-height: 1.2;

            margin:
                10px 0 35px;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           WISHLIST LIST
        ===================================================== */

        .wishlist-list {
            width: 100%;

            display: flex;

            flex-direction: column;

            gap: 20px;
        }


        /* =====================================================
           WISHLIST CARD
        ===================================================== */

        .card {
            width: 100%;
            min-width: 0;

            background: #fff;

            border-radius: 16px;

            padding: 20px;

            box-shadow:
                0 8px 22px rgba(0, 0, 0, .07);

            transition:
                transform .25s ease,
                box-shadow .25s ease;
        }

        .card:hover {
            transform: translateY(-4px);

            box-shadow:
                0 14px 30px rgba(0, 0, 0, .12);
        }


        /* =====================================================
           PRODUCT ROW
        ===================================================== */

        .product {
            width: 100%;

            min-width: 0;

            display: flex;

            align-items: center;

            gap: 25px;
        }


        /* =====================================================
           PRODUCT IMAGE
        ===================================================== */

        .product-image-wrapper {
            width: 160px;
            height: 160px;

            flex: 0 0 160px;

            display: flex;

            align-items: center;
            justify-content: center;

            overflow: hidden;

            background: #f8fafc;

            border:
                1px solid #e5e7eb;

            border-radius: 12px;
        }

        .product-image {
            width: 100%;
            height: 100%;

            display: block;

            object-fit: cover;

            transition:
                transform .3s ease;
        }

        .card:hover .product-image {
            transform: scale(1.04);
        }


        /* =====================================================
           PRODUCT DETAILS
        ===================================================== */

        .details {
            flex: 1;

            min-width: 0;
        }


        /* PRODUCT NAME */

        .name {
            color: #111827;

            font-size: 26px;

            font-weight: 700;

            line-height: 1.3;

            margin-bottom: 9px;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        /* PRODUCT PRICE */

        .price {
            color: #16a34a;

            font-size: 22px;

            font-weight: 700;

            line-height: 1.3;

            margin-bottom: 18px;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           ACTION BUTTONS
        ===================================================== */

        .action-buttons {
            width: 100%;

            display: flex;

            align-items: center;

            gap: 12px;

            flex-wrap: wrap;
        }


        /* BUTTON */

        .btn {
            min-height: 44px;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            padding: 11px 20px;

            border: none;

            border-radius: 8px;

            color: #fff;

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;

            text-align: center;

            cursor: pointer;

            transition:
                transform .25s ease,
                box-shadow .25s ease;
        }


        /* VIEW */

        .view {
            background:
                linear-gradient(90deg,
                    #2563eb,
                    #1d4ed8);
        }

        .view:hover {
            transform: translateY(-2px);

            box-shadow:
                0 7px 18px rgba(37, 99, 235, .30);
        }


        /* REMOVE */

        .remove {
            background:
                linear-gradient(90deg,
                    #ef4444,
                    #dc2626);
        }

        .remove:hover {
            transform: translateY(-2px);

            box-shadow:
                0 7px 18px rgba(220, 38, 38, .30);
        }


        /* =====================================================
           EMPTY WISHLIST
        ===================================================== */

        .empty {
            width: 100%;

            padding: 65px 25px;

            background: #fff;

            border-radius: 16px;

            text-align: center;

            color: #64748b;

            font-size: 26px;

            font-weight: 600;

            line-height: 1.4;

            box-shadow:
                0 8px 22px rgba(0, 0, 0, .07);
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 992px) {

            .back-wrapper {
                width: 94%;
            }

            .container {
                width: 94%;
            }

            .page-title {
                font-size: 38px;

                margin-bottom: 30px;
            }

            .card {
                padding: 18px;
            }

            .product {
                gap: 20px;
            }

            .product-image-wrapper {
                width: 135px;
                height: 135px;

                flex-basis: 135px;
            }

            .name {
                font-size: 23px;
            }

            .price {
                font-size: 20px;
            }

        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            .wishlist-page {
                padding-bottom: 35px;
            }


            /* BACK */

            .back-wrapper {
                width: calc(100% - 24px);

                margin:
                    15px auto;
            }

            .back-btn {
                width: 100%;

                min-height: 42px;

                padding: 10px 15px;

                font-size: 13px;
            }

            .back-btn:hover {
                transform: none;

                box-shadow: none;
            }


            /* CONTAINER */

            .container {
                width: calc(100% - 24px);
            }


            /* TITLE */

            .page-title {
                font-size: 30px;

                margin:
                    10px 0 22px;
            }


            /* CARD */

            .wishlist-list {
                gap: 15px;
            }

            .card {
                padding: 15px;

                border-radius: 12px;
            }

            .card:hover {
                transform: none;

                box-shadow:
                    0 8px 22px rgba(0, 0, 0, .07);
            }


            /* PRODUCT */

            .product {
                flex-direction: column;

                align-items: center;

                text-align: center;

                gap: 15px;
            }


            /* IMAGE */

            .product-image-wrapper {
                width: 125px;
                height: 125px;

                flex: 0 0 125px;

                border-radius: 10px;
            }

            .card:hover .product-image {
                transform: none;
            }


            /* DETAILS */

            .details {
                width: 100%;

                min-width: 0;
            }

            .name {
                font-size: 20px;

                line-height: 1.35;

                margin-bottom: 7px;
            }

            .price {
                font-size: 18px;

                margin-bottom: 15px;
            }


            /* BUTTONS */

            .action-buttons {
                width: 100%;

                flex-direction: column;

                gap: 9px;
            }

            .btn {
                width: 100%;

                min-height: 43px;

                padding: 10px 14px;

                font-size: 13px;
            }

            .btn:hover {
                transform: none;

                box-shadow: none;
            }


            /* EMPTY */

            .empty {
                padding:
                    45px 15px;

                font-size: 20px;

                border-radius: 12px;
            }

        }


        /* =====================================================
           SMALL MOBILE
        ===================================================== */

        @media (max-width: 400px) {

            .back-wrapper {
                width: calc(100% - 18px);

                margin:
                    12px auto;
            }

            .container {
                width: calc(100% - 18px);
            }

            .page-title {
                font-size: 26px;

                margin-bottom: 18px;
            }

            .card {
                padding: 12px;
            }

            .product {
                gap: 12px;
            }

            .product-image-wrapper {
                width: 105px;
                height: 105px;

                flex-basis: 105px;
            }

            .name {
                font-size: 17px;
            }

            .price {
                font-size: 16px;

                margin-bottom: 12px;
            }

            .btn {
                min-height: 40px;

                padding: 9px 12px;

                font-size: 12px;
            }

            .empty {
                padding:
                    35px 12px;

                font-size: 18px;
            }

        }


        /* =====================================================
           VERY SMALL PHONES
        ===================================================== */

        @media (max-width: 330px) {

            .back-wrapper {
                width: calc(100% - 14px);
            }

            .container {
                width: calc(100% - 14px);
            }

            .page-title {
                font-size: 23px;
            }

            .card {
                padding: 10px;

                border-radius: 10px;
            }

            .product {
                gap: 10px;
            }

            .product-image-wrapper {
                width: 90px;
                height: 90px;

                flex-basis: 90px;
            }

            .name {
                font-size: 15px;
            }

            .price {
                font-size: 14px;
            }

            .btn {
                min-height: 38px;

                font-size: 11px;

                padding: 8px 10px;
            }

            .empty {
                padding:
                    30px 10px;

                font-size: 16px;
            }

        }


        /* =====================================================
           TOUCH DEVICES
        ===================================================== */

        @media (hover: none) {

            .card:hover {
                transform: none;
            }

            .card:hover .product-image {
                transform: none;
            }

            .back-btn:hover,
            .btn:hover {
                transform: none;

                box-shadow: none;
            }

        }
    </style>

</head>


<body>


    <!-- =====================================================
         NAVBAR
    ===================================================== -->

    <%- include("../partials/user/navbar") %>


        <main class="wishlist-page">


            <!-- =================================================
             BACK BUTTON
        ================================================= -->

            <div class="back-wrapper">

                <a href="/product" class="back-btn">

                    ← Back To Products

                </a>

            </div>


            <!-- =================================================
             CONTENT
        ================================================= -->

            <div class="container">


                <h1 class="page-title">
                    My Wishlist
                </h1>


                <% if(wishlist.length===0){ %>


                    <!-- =========================================
                     EMPTY WISHLIST
                ========================================== -->

                    <div class="empty">

                        Wishlist is empty

                    </div>


                    <% } else { %>


                        <!-- =========================================
                     WISHLIST PRODUCTS
                ========================================== -->

                        <div class="wishlist-list">


                            <% wishlist.forEach(function(product){ %>


                                <div class="card">


                                    <div class="product">


                                        <!-- PRODUCT IMAGE -->

                                        <div class="product-image-wrapper">

                                            <img class="product-image"
                                                src="<%= product.images && product.images.length ? product.images[0] : '/images/no-image.png' %>"
                                                alt="<%= product.name %>" loading="lazy">

                                        </div>


                                        <!-- PRODUCT DETAILS -->

                                        <div class="details">


                                            <div class="name">

                                                <%= product.name %>

                                            </div>


                                            <div class="price">

                                                Price: ₹ <%= product.price %>

                                            </div>


                                            <!-- ACTION BUTTONS -->

                                            <div class="action-buttons">


                                                <a href="/product/<%= product._id %>" class="btn view">

                                                    View Product

                                                </a>


                                                <a href="/wishlist/remove/<%= product._id %>" class="btn remove">

                                                    Remove

                                                </a>


                                            </div>


                                        </div>


                                    </div>


                                </div>


                                <% }) %>


                        </div>


                        <% } %>


            </div>


        </main>


        <!-- =====================================================
         FOOTER
    ===================================================== -->

        <%- include("../partials/user/footer") %>


</body>

</html>