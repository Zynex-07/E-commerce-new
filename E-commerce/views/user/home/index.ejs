<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IV Store — Modern Shopping</title><link rel="stylesheet" href="/style/storefront.css"></head><body>
<%- include('../../partials/user/navbar') %>
<section class="hero-new"><div class="shell"><div class="hero-grid"><div class="hero-copy"><div class="eyebrow">Fresh picks • Better shopping</div><h1>Style that fits your <span>everyday.</span></h1><p>Discover our latest collection across fashion, essentials and more. A faster, cleaner shopping experience built around the products you love.</p><div class="hero-actions"><a class="primary-btn" href="/product">Shop Collection →</a><a class="outline-btn" href="#categories">Browse Categories</a></div></div><div class="hero-visual"><img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=1200&auto=format&fit=crop" alt="Modern shopping collection"><div class="hero-badge"><strong>New season</strong>Explore the latest arrivals</div></div></div>
<div class="trust-row"><div class="trust-item"><div class="trust-icon">🚚</div><div><strong>Fast Delivery</strong><small>Quick order dispatch</small></div></div><div class="trust-item"><div class="trust-icon">🔒</div><div><strong>Secure Checkout</strong><small>Protected shopping</small></div></div><div class="trust-item"><div class="trust-icon">↩</div><div><strong>Easy Returns</strong><small>Simple return process</small></div></div><div class="trust-item"><div class="trust-icon">💬</div><div><strong>Customer Support</strong><small>Here when you need us</small></div></div></div></div></section>
<section class="section" id="categories"><div class="shell"><div class="section-head"><div><div class="eyebrow">Shop your way</div><h2>Popular Categories</h2><p>Jump straight into what you're looking for.</p></div><a class="text-link" href="/product">View all products →</a></div><div class="category-grid">
<% if(category && category.length){ category.slice(0,8).forEach(function(cat,index){ const match=product.find(p=>String(p.categoryId)===String(cat._id)); const fallback=['/images/women.jpg','/images/shoes_1.webp','/images/baby.1.png','/images/whiteimg.jpg'][index%4]; %><a class="category-card" href="/product/category/<%= cat._id %>"><img src="<%= match && match.images && match.images[0] ? match.images[0] : fallback %>" alt="<%= cat.name %>"><div class="category-label"><strong><%= cat.name %></strong><small>Explore collection →</small></div></a><% }) } %>
</div></div></section>
<section class="section section-soft" id="new-arrivals"><div class="shell"><div class="section-head"><div><div class="eyebrow"><%= search ? 'Search results' : 'Just landed' %></div><h2><%= search ? 'Results for “'+search+'”' : 'New & Featured' %></h2><p><%= search ? product.length+' product(s) found' : 'Fresh products selected for you.' %></p></div><a class="text-link" href="/product">Shop all →</a></div><div class="product-grid">
<% if(product && product.length){ product.slice(0,8).forEach(function(item){ %><article class="product-card"><div class="product-media"><img src="<%= item.images && item.images[0] ? item.images[0] : '/images/whiteimg.jpg' %>" alt="<%= item.name %>" loading="lazy"><span class="stock-tag <%= Number(item.stock)<=0?'out':'' %>"><%= Number(item.stock)>0?'In stock':'Sold out' %></span><a class="wish" href="/wishlist/add/<%= item._id %>" title="Add to wishlist">♡</a></div><div class="product-info"><h3><%= item.name %></h3><div class="rating">★★★★★ <span>(New)</span></div><div class="price-line"><span class="current-price">₹<%= Number(item.price).toLocaleString('en-IN') %></span></div><div class="card-actions"><a class="card-btn" href="/product/<%= item._id %>">View Product</a><a class="cart-icon-btn" href="/cart/add/<%= item._id %>?qty=1" title="Add to cart">🛒</a></div></div></article><% }) } else { %><div class="empty">No products found. Try another search.</div><% } %>
</div></div></section>
<section class="section"><div class="shell"><div class="promo"><div><div class="eyebrow">Made for easy shopping</div><h2>Find your next favourite.</h2><p>Browse the complete collection, save products to your wishlist and check out in just a few steps.</p></div><a class="primary-btn" href="/product">Explore the Store →</a></div></div></section>
<%- include('../../partials/user/footer') %></body></html>
