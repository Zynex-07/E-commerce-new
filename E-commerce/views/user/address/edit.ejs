<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Address</title>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ===========================
           NAVBAR
        =========================== */

        .navbar {
            width: 100%;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            padding: 14px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo img {
            width: 130px;
            height: 55px;
            max-width: 100%;
            object-fit: contain;
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, .4);
            color: #fff;
            width: 45px;
            height: 40px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 26px;
            justify-content: center;
            align-items: center;
        }

        .nav-links {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            padding: 10px 13px;
            border-radius: 8px;
            transition: .3s;
            white-space: nowrap;
        }

        .nav-links a:hover {
            color: #fbbf24;
        }

        .search-form {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-form input {
            width: 220px;
            padding: 10px;
            border: none;
            outline: none;
            border-radius: 8px;
        }

        .search-form button {
            padding: 10px 16px;
            border: none;
            border-radius: 8px;
            background: #f59e0b;
            color: #fff;
            cursor: pointer;
            font-weight: 600;
        }

        .cart-btn-nav {
            background: linear-gradient(90deg, #10b981, #059669);
            padding: 10px 16px !important;
            border-radius: 8px;
            color: #fff !important;
            font-weight: 600;
        }

        /* ===========================
           LAYOUT & CONTAINER
        =========================== */

        .container {
            width: 94%;
            max-width: 1200px;
            margin: 35px auto;
        }

        .card {
            width: 100%;
            background: #fff;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);
        }

        h1 {
            text-align: center;
            color: #0f172a;
            margin-bottom: 30px;
            font-size: clamp(26px, 4vw, 36px);
            line-height: 1.3;
        }

        .grid-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 35px;
            align-items: start;
        }

        .map-section,
        .form-section {
            width: 100%;
            min-width: 0;
        }

        /* ===========================
           FORM ELEMENTS
        =========================== */

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #1e293b;
            font-size: 15px;
        }

        input,
        textarea {
            width: 100%;
            max-width: 100%;
            padding: 13px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            outline: none;
            font-size: 15px;
            transition: border-color 0.3s;
            background: #f9fafb;
        }

        textarea {
            resize: vertical;
            min-height: 110px;
            height: 110px;
        }

        input:focus,
        textarea:focus {
            border-color: #2563eb;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        /* ===========================
           MAP & SEARCH
        =========================== */

        #searchLocation {
            margin-bottom: 10px;
        }

        #map {
            width: 100%;
            height: 430px;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        /* ===========================
           BUTTONS
        =========================== */

        .btn-group,
        .form-btn-group {
            display: flex;
            gap: 12px;
        }

        .btn-group {
            margin-top: 15px;
        }

        .form-btn-group {
            margin-top: 25px;
        }

        .btn {
            flex: 1;
            min-width: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            text-decoration: none;
            border: none;
            padding: 13px 12px;
            color: white;
            border-radius: 8px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            line-height: 1.4;
            transition: .3s;
        }

        .save-btn {
            background: linear-gradient(90deg, #2563eb, #1d4ed8);
        }

        .save-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.4);
        }

        .location-btn {
            width: 100%;
            background: linear-gradient(90deg, #f59e0b, #d97706);
            margin-bottom: 20px;
        }

        .location-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245, 158, 11, 0.4);
        }

        .cart-btn {
            background: linear-gradient(90deg, #10b981, #059669);
        }

        .cart-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(16, 185, 129, 0.4);
        }

        /* ===========================
           TABLET
        =========================== */

        @media (max-width: 992px) {
            .navbar {
                flex-wrap: wrap;
            }

            .menu-toggle {
                display: flex;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
                margin-top: 15px;
                padding-top: 15px;
                border-top: 1px solid rgba(255, 255, 255, .15);
            }

            .nav-links.active {
                display: flex;
            }

            .nav-links a {
                width: 100%;
                text-align: center;
            }

            .search-form {
                width: 100%;
                flex-direction: column;
            }

            .search-form input,
            .search-form button {
                width: 100%;
            }

            .grid-layout {
                grid-template-columns: 1fr;
                gap: 25px;
            }

            #map {
                height: 360px;
            }

            .container {
                margin: 25px auto;
            }
        }

        /* ===========================
           MOBILE
        =========================== */

        @media (max-width: 768px) {
            .navbar {
                padding: 12px 15px;
            }

            .logo img {
                width: 115px;
                height: 50px;
            }

            .menu-toggle {
                width: 42px;
                height: 38px;
                font-size: 24px;
            }

            .container {
                width: 94%;
                margin: 20px auto;
            }

            .card {
                padding: 24px 18px;
                border-radius: 13px;
            }

            h1 {
                font-size: 28px;
                margin-bottom: 22px;
            }

            .form-group {
                margin-bottom: 17px;
            }

            label {
                font-size: 14px;
            }

            input,
            textarea {
                padding: 12px;
                font-size: 14px;
            }

            #map {
                height: 300px;
            }

            .btn-group,
            .form-btn-group {
                flex-direction: column;
                gap: 10px;
            }

            .btn {
                width: 100%;
                flex: none;
                font-size: 14px;
                padding: 12px;
            }

            .location-btn {
                margin-bottom: 10px;
            }

            footer {
                margin-top: 35px;
            }
        }

        /* ===========================
           SMALL MOBILE
        =========================== */

        @media (max-width: 480px) {
            .navbar {
                padding: 10px 12px;
            }

            .logo img {
                width: 100px;
                height: 45px;
            }

            .container {
                width: 95%;
                margin: 15px auto;
            }

            .card {
                padding: 20px 14px;
            }

            h1 {
                font-size: 24px;
                margin-bottom: 20px;
            }

            #map {
                height: 260px;
            }

            input,
            textarea {
                font-size: 13px;
            }

            .btn {
                font-size: 13px;
                padding: 11px;
            }
        }

        /* ===========================
           VERY SMALL MOBILE
        =========================== */

        @media (max-width: 360px) {
            h1 {
                font-size: 22px;
            }

            #map {
                height: 240px;
            }

            .card {
                padding: 18px 12px;
            }
        }
    </style>
</head>

<body>

    <%- include("../../partials/user/navbar") %>

        <div class="container">
            <div class="card">

                <h1>Edit Address</h1>

                <form action="/address/save" method="POST" onsubmit="return checkForm()">

                    <div class="grid-layout">

                        <div class="map-section">

                            <div class="form-group">
                                <label for="searchLocation">Search Location</label>

                                <input type="text" id="searchLocation" placeholder="Search your address">
                            </div>

                            <div id="map"></div>

                            <input type="hidden" name="latitude" id="latitude"
                                value="<%= user.address?.latitude || '' %>">

                            <input type="hidden" name="longitude" id="longitude"
                                value="<%= user.address?.longitude || '' %>">

                            <div class="btn-group">
                                <button type="button" id="currentLocation" class="btn location-btn">
                                    📍 Use Current Location
                                </button>
                            </div>

                        </div>

                        <div class="form-section">

                            <div class="form-group">
                                <label for="mobile">Mobile Number</label>

                                <input type="text" id="mobile" name="mobile" value="<%= user.address?.mobile || '' %>"
                                    required placeholder="Enter 10 digit number">
                            </div>

                            <div class="form-group">
                                <label for="address">Full Address</label>

                                <textarea id="address" name="address" required
                                    placeholder="House No, Building, Street Area"><%= user.address?.address || '' %></textarea>
                            </div>

                            <div class="form-group">
                                <label for="city">City</label>

                                <input type="text" id="city" name="city" value="<%= user.address?.city || '' %>"
                                    required>
                            </div>

                            <div class="form-group">
                                <label for="state">State</label>

                                <input type="text" id="state" name="state" value="<%= user.address?.state || '' %>"
                                    required>
                            </div>

                            <div class="form-group">
                                <label for="pincode">Pincode</label>

                                <input type="text" id="pincode" name="pincode"
                                    value="<%= user.address?.pincode || '' %>" required>
                            </div>

                            <div class="form-btn-group">
                                <button type="submit" class="btn save-btn">
                                    Update Address
                                </button>

                                <a href="/cart" class="btn cart-btn">
                                    Back To Cart
                                </a>
                            </div>

                        </div>

                    </div>

                </form>

            </div>
        </div>

        <%- include("../../partials/user/footer") %>

            <script>
                let map;
                let marker;
                let geocoder;
                let autocomplete;

                function initMap() {
                    geocoder = new google.maps.Geocoder();

                    const lat = Number(
                        "<%= user.address && user.address.latitude ? user.address.latitude : 21.1702 %>"
                    );

                    const lng = Number(
                        "<%= user.address && user.address.longitude ? user.address.longitude : 72.8311 %>"
                    );

                    const location = {
                        lat,
                        lng
                    };

                    map = new google.maps.Map(document.getElementById("map"), {
                        center: location,
                        zoom: 15
                    });

                    marker = new google.maps.Marker({
                        position: location,
                        map: map,
                        draggable: true
                    });

                    document.getElementById("latitude").value = lat;
                    document.getElementById("longitude").value = lng;

                    autocomplete = new google.maps.places.Autocomplete(
                        document.getElementById("searchLocation")
                    );

                    autocomplete.bindTo("bounds", map);

                    autocomplete.addListener("place_changed", function () {
                        const place = autocomplete.getPlace();

                        if (!place.geometry) {
                            return;
                        }

                        const newLocation = place.geometry.location;

                        map.setCenter(newLocation);
                        map.setZoom(16);
                        marker.setPosition(newLocation);

                        document.getElementById("latitude").value = newLocation.lat();
                        document.getElementById("longitude").value = newLocation.lng();

                        fillAddress(
                            newLocation.lat(),
                            newLocation.lng()
                        );
                    });

                    marker.addListener("dragend", function (event) {
                        const lat = event.latLng.lat();
                        const lng = event.latLng.lng();

                        document.getElementById("latitude").value = lat;
                        document.getElementById("longitude").value = lng;

                        fillAddress(lat, lng);
                    });

                    document.getElementById("currentLocation").addEventListener(
                        "click",
                        function () {
                            if (!navigator.geolocation) {
                                alert("Geolocation is not supported.");
                                return;
                            }

                            navigator.geolocation.getCurrentPosition(
                                function (position) {
                                    const lat = position.coords.latitude;
                                    const lng = position.coords.longitude;

                                    const current = {
                                        lat,
                                        lng
                                    };

                                    map.setCenter(current);
                                    map.setZoom(16);
                                    marker.setPosition(current);

                                    document.getElementById("latitude").value = lat;
                                    document.getElementById("longitude").value = lng;

                                    fillAddress(lat, lng);
                                },
                                function (error) {
                                    alert("Unable to get current location.");
                                    console.log(error);
                                }
                            );
                        }
                    );
                }

                function fillAddress(lat, lng) {
                    geocoder.geocode(
                        {
                            location: {
                                lat,
                                lng
                            }
                        },
                        function (results, status) {
                            if (status === "OK" && results.length > 0) {
                                document.getElementById("address").value =
                                    results[0].formatted_address;

                                let city = "";
                                let state = "";
                                let pincode = "";

                                results[0].address_components.forEach(function (component) {
                                    if (component.types.includes("locality")) {
                                        city = component.long_name;
                                    }

                                    if (
                                        component.types.includes(
                                            "administrative_area_level_1"
                                        )
                                    ) {
                                        state = component.long_name;
                                    }

                                    if (component.types.includes("postal_code")) {
                                        pincode = component.long_name;
                                    }
                                });

                                document.getElementById("city").value = city;
                                document.getElementById("state").value = state;
                                document.getElementById("pincode").value = pincode;
                            }
                        }
                    );
                }

                function checkForm() {
                    return true;
                }
            </script>

            <script async defer
                src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCvqqyj13jPKSK6Npx6Kko1q_OPJHkcDGg&libraries=places&callback=initMap">
                </script>

</body>

</html>