<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Address</title>


    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');


        /* =====================================================
           GLOBAL
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
        }

        body {
            min-height: 100vh;

            background:
                linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);

            color: #111827;

            padding-bottom: 80px;
        }


        /* =====================================================
           ADDRESS CONTAINER
        ===================================================== */

        .container {
            width: 92%;
            max-width: 900px;

            margin: 40px auto;
        }


        /* =====================================================
           CARD
        ===================================================== */

        .card {
            width: 100%;

            background: #fff;

            border-radius: 16px;

            padding: 40px;

            box-shadow:
                0 10px 25px rgba(0, 0, 0, .08);

            overflow: hidden;
        }


        /* =====================================================
           TITLE
        ===================================================== */

        h1 {
            text-align: center;

            color: #0f172a;

            margin-bottom: 30px;

            font-size: 38px;

            line-height: 1.2;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           ADDRESS INFO
        ===================================================== */

        .info {
            width: 100%;

            display: flex;

            align-items: flex-start;

            gap: 15px;

            margin-bottom: 18px;

            font-size: 18px;

            color: #4b5563;

            line-height: 1.6;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        .label {
            flex: 0 0 100px;

            font-weight: 600;

            color: #111827;
        }


        .info-value {
            flex: 1;

            min-width: 0;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        /* =====================================================
           LOCATION TITLE
        ===================================================== */

        .location-title {
            margin-top: 35px;

            margin-bottom: 0;

            padding-bottom: 10px;

            border-bottom:
                2px dashed #e2e8f0;

            color: #0f172a;

            font-size: 24px;

            line-height: 1.3;
        }


        /* =====================================================
           GOOGLE MAP
        ===================================================== */

        #map {
            width: 100%;

            height: 400px;

            margin-top: 20px;

            border:
                2px solid #e2e8f0;

            border-radius: 12px;

            box-shadow:
                0 4px 10px rgba(0, 0, 0, .05);

            overflow: hidden;
        }


        /* =====================================================
           BUTTON GROUP
        ===================================================== */

        .btn-group {
            width: 100%;

            margin-top: 30px;

            display: flex;

            gap: 15px;
        }


        .btn {
            flex: 1;

            min-height: 48px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding: 13px 20px;

            border: none;

            border-radius: 8px;

            color: #fff;

            text-decoration: none;

            font-weight: 600;

            text-align: center;

            font-size: 15px;

            line-height: 1.3;

            transition:
                transform .25s ease,
                box-shadow .25s ease;

            cursor: pointer;
        }


        /* =====================================================
           EDIT BUTTON
        ===================================================== */

        .edit-btn {
            background:
                linear-gradient(90deg,
                    #2563eb,
                    #1d4ed8);
        }

        .edit-btn:hover {
            transform: translateY(-3px);

            box-shadow:
                0 5px 15px rgba(37, 99, 235, .4);
        }


        /* =====================================================
           CART BUTTON
        ===================================================== */

        .cart-btn-address {
            background:
                linear-gradient(90deg,
                    #f59e0b,
                    #ef4444);
        }

        .cart-btn-address:hover {
            transform: translateY(-3px);

            box-shadow:
                0 5px 15px rgba(239, 68, 68, .4);
        }


        /* =====================================================
           EMPTY ADDRESS
        ===================================================== */

        .empty {
            width: 100%;

            text-align: center;

            font-size: 22px;

            color: #64748b;

            line-height: 1.5;

            margin: 30px 0;

            padding: 20px;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           LARGE TABLET
        ===================================================== */

        @media (max-width: 992px) {

            .container {
                width: 94%;

                margin:
                    30px auto;
            }

            .card {
                padding: 32px;
            }

            h1 {
                font-size: 34px;
            }

            .info {
                font-size: 17px;
            }

            #map {
                height: 360px;
            }

        }


        /* =====================================================
           TABLET / MOBILE
        ===================================================== */

        @media (max-width: 768px) {

            body {
                padding-bottom: 60px;
            }


            .container {
                width: calc(100% - 24px);

                margin:
                    20px auto 30px;
            }


            .card {
                padding: 25px 20px;

                border-radius: 13px;
            }


            h1 {
                font-size: 30px;

                margin-bottom: 25px;
            }


            .info {
                gap: 10px;

                font-size: 16px;

                margin-bottom: 16px;
            }


            .label {
                flex-basis: 82px;
            }


            .location-title {
                font-size: 20px;

                margin-top: 30px;
            }


            #map {
                height: 300px;

                margin-top: 16px;

                border-radius: 10px;
            }


            .btn-group {
                flex-direction: column;

                gap: 12px;

                margin-top: 25px;
            }


            .btn {
                width: 100%;

                min-height: 46px;

                font-size: 14px;
            }


            .empty {
                font-size: 19px;

                padding:
                    15px 5px;

                margin:
                    25px 0;
            }

        }


        /* =====================================================
           SMALL MOBILE
        ===================================================== */

        @media (max-width: 480px) {

            .container {
                width: calc(100% - 18px);

                margin:
                    15px auto 25px;
            }


            .card {
                padding: 20px 15px;

                border-radius: 11px;
            }


            h1 {
                font-size: 26px;

                margin-bottom: 22px;
            }


            .info {
                display: block;

                font-size: 14px;

                line-height: 1.55;

                margin-bottom: 15px;
            }


            .label {
                display: block;

                width: 100%;

                margin-bottom: 3px;
            }


            .info-value {
                display: block;

                width: 100%;
            }


            .location-title {
                font-size: 18px;

                margin-top: 25px;

                padding-bottom: 8px;
            }


            #map {
                height: 260px;

                margin-top: 14px;

                border-width: 1px;

                border-radius: 9px;
            }


            .btn-group {
                gap: 10px;

                margin-top: 22px;
            }


            .btn {
                min-height: 44px;

                padding:
                    10px 14px;

                font-size: 13px;

                border-radius: 7px;
            }


            .empty {
                font-size: 17px;

                padding:
                    12px 2px;
            }

        }


        /* =====================================================
           VERY SMALL PHONES
        ===================================================== */

        @media (max-width: 330px) {

            .container {
                width: calc(100% - 14px);
            }


            .card {
                padding: 17px 11px;

                border-radius: 9px;
            }


            h1 {
                font-size: 23px;

                margin-bottom: 20px;
            }


            .info {
                font-size: 13px;

                margin-bottom: 13px;
            }


            .label {
                margin-bottom: 2px;
            }


            .location-title {
                font-size: 17px;

                margin-top: 22px;
            }


            #map {
                height: 220px;

                margin-top: 12px;
            }


            .btn {
                min-height: 42px;

                font-size: 12px;

                padding:
                    9px 10px;
            }


            .empty {
                font-size: 15px;

                line-height: 1.5;
            }

        }


        /* =====================================================
           TOUCH DEVICES
        ===================================================== */

        @media (hover: none) {

            .edit-btn:hover,
            .cart-btn-address:hover {
                transform: none;

                box-shadow: none;
            }

        }
    </style>

</head>


<body>


    <!-- =====================================================
         NAVBAR
    ===================================================== -->

    <%- include("../../partials/user/navbar") %>


        <!-- =====================================================
         MAIN CONTENT
    ===================================================== -->

        <div class="container">


            <div class="card">


                <!-- =================================================
                 TITLE
            ================================================= -->

                <h1>
                    My Address
                </h1>


                <% if(user && user.address){ %>


                    <!-- =============================================
                     MOBILE
                ============================================== -->

                    <div class="info">

                        <span class="label">
                            Mobile:
                        </span>

                        <span class="info-value">
                            <%= user.address.mobile %>
                        </span>

                    </div>


                    <!-- =============================================
                     ADDRESS
                ============================================== -->

                    <div class="info">

                        <span class="label">
                            Address:
                        </span>

                        <span class="info-value">
                            <%= user.address.address %>
                        </span>

                    </div>


                    <!-- =============================================
                     CITY
                ============================================== -->

                    <div class="info">

                        <span class="label">
                            City:
                        </span>

                        <span class="info-value">
                            <%= user.address.city %>
                        </span>

                    </div>


                    <!-- =============================================
                     STATE
                ============================================== -->

                    <div class="info">

                        <span class="label">
                            State:
                        </span>

                        <span class="info-value">
                            <%= user.address.state %>
                        </span>

                    </div>


                    <!-- =============================================
                     PINCODE
                ============================================== -->

                    <div class="info">

                        <span class="label">
                            Pincode:
                        </span>

                        <span class="info-value">
                            <%= user.address.pincode %>
                        </span>

                    </div>


                    <!-- =============================================
                     SAVED LOCATION
                ============================================== -->

                    <h2 class="location-title">
                        Saved Location
                    </h2>


                    <div id="map"></div>


                    <!-- =============================================
                     BUTTONS
                ============================================== -->

                    <div class="btn-group">

                        <a href="/address/edit" class="btn edit-btn">

                            Edit Address

                        </a>


                        <a href="/cart" class="btn cart-btn-address">

                            Back To Cart

                        </a>

                    </div>


                    <% } else { %>


                        <!-- =============================================
                     EMPTY ADDRESS
                ============================================== -->

                        <div class="empty">

                            No Address Found.
                            Please add one to continue.

                        </div>


                        <!-- =============================================
                     EMPTY ADDRESS BUTTONS
                ============================================== -->

                        <div class="btn-group">

                            <a href="/address/edit" class="btn edit-btn">

                                Add Address

                            </a>


                            <a href="/cart" class="btn cart-btn-address">

                                Back To Cart

                            </a>

                        </div>


                        <% } %>


            </div>

        </div>


        <!-- =====================================================
         FOOTER
    ===================================================== -->

        <%- include("../../partials/user/footer") %>


            <% if(user && user.address){ %>


                <!-- =================================================
             GOOGLE MAP
        ================================================= -->

                <script>

                    function initMap() {

                        const lat =
                            Number(
                                "<%= user.address.latitude || 21.1702 %>"
                            );

                        const lng =
                            Number(
                                "<%= user.address.longitude || 72.8311 %>"
                            );


                        const location = {
                            lat: lat,
                            lng: lng
                        };


                        const map =
                            new google.maps.Map(
                                document.getElementById("map"),
                                {
                                    zoom: 15,
                                    center: location
                                }
                            );


                        new google.maps.Marker({

                            position: location,

                            map: map

                        });

                    }

                </script>


                <script async defer
                    src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCvqqyj13jPKSK6Npx6Kko1q_OPJHkcDGg&libraries=places&callback=initMap">
                    </script>


                <% } %>


</body>

</html>