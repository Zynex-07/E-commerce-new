<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="View your orders">

    <title>My Orders</title>


    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');


        /* =====================================================
           GLOBAL
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
        }

        body {
            min-height: 100vh;

            background:
                linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);

            color: #111827;

            padding-bottom: 80px;
        }


        /* =====================================================
           PAGE
        ===================================================== */

        .orders-page {
            width: 100%;

            padding:
                0 0 30px;
        }


        /* =====================================================
           BACK BUTTON
        ===================================================== */

        .back-wrapper {
            width: 92%;
            max-width: 1250px;

            margin:
                25px auto 10px;
        }


        .back-btn {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-height: 44px;

            padding:
                11px 20px;

            background:
                linear-gradient(90deg,
                    #2563eb,
                    #1d4ed8);

            color: #fff;

            text-decoration: none;

            border-radius: 8px;

            font-size: 14px;

            font-weight: 600;

            transition:
                transform .25s ease,
                box-shadow .25s ease;
        }


        .back-btn:hover {
            transform: translateY(-3px);

            box-shadow:
                0 5px 15px rgba(37, 99, 235, .35);
        }


        /* =====================================================
           MAIN CONTAINER
        ===================================================== */

        .container {
            width: 92%;
            max-width: 1250px;

            margin:
                20px auto 40px;
        }


        /* =====================================================
           TITLE
        ===================================================== */

        .title {
            width: 100%;

            text-align: center;

            font-size: 42px;

            font-weight: 700;

            line-height: 1.2;

            color: #0f172a;

            margin-bottom: 25px;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           PENDING BOX
        ===================================================== */

        .pending-box {
            width: fit-content;
            max-width: 100%;

            margin:
                0 auto 40px;

            background: #fff;

            padding:
                14px 28px;

            border-radius: 12px;

            font-size: 19px;

            font-weight: 600;

            color: #ef4444;

            text-align: center;

            line-height: 1.4;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, .08);

            overflow-wrap: anywhere;
        }


        /* =====================================================
           ORDERS GRID
        ===================================================== */

        .orders {
            width: 100%;

            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            gap: 25px;

            align-items: stretch;
        }


        /* =====================================================
           ORDER CARD
        ===================================================== */

        .card {
            width: 100%;
            min-width: 0;

            display: flex;

            flex-direction: column;

            background: #fff;

            border-radius: 16px;

            padding: 25px;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, .06);

            transition:
                transform .25s ease,
                box-shadow .25s ease;
        }


        .card:hover {
            transform: translateY(-5px);

            box-shadow:
                0 12px 30px rgba(0, 0, 0, .12);
        }


        /* =====================================================
           STATUS
        ===================================================== */

        .status {
            align-self: flex-start;

            max-width: 100%;

            padding:
                7px 14px;

            border-radius: 20px;

            font-size: 13px;

            font-weight: 600;

            line-height: 1.4;

            margin-bottom: 15px;

            overflow-wrap: anywhere;
        }


        .pending {
            background: #fef3c7;

            color: #d97706;
        }


        .cancelled {
            background: #fee2e2;

            color: #dc2626;
        }


        .delivered {
            background: #dcfce7;

            color: #16a34a;
        }


        /* =====================================================
           TOTAL
        ===================================================== */

        .total {
            font-size: 26px;

            font-weight: 700;

            color: #16a34a;

            line-height: 1.3;

            margin-bottom: 12px;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        /* =====================================================
           DATE
        ===================================================== */

        .date {
            color: #64748b;

            font-size: 14px;

            line-height: 1.6;

            margin-bottom: 25px;

            flex-grow: 1;

            overflow-wrap: anywhere;

            word-break: break-word;
        }


        .date strong {
            color: #334155;

            font-weight: 600;
        }


        /* =====================================================
           ACTION BUTTONS
        ===================================================== */

        .action-buttons {
            width: 100%;

            display: flex;

            gap: 10px;

            flex-wrap: wrap;
        }


        .btn {
            flex: 1;

            min-width: 0;

            min-height: 45px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            text-decoration: none;

            background:
                linear-gradient(90deg,
                    #f59e0b,
                    #ef4444);

            color: #fff;

            padding:
                11px 10px;

            border-radius: 8px;

            font-weight: 600;

            font-size: 13px;

            line-height: 1.3;

            transition:
                transform .25s ease,
                box-shadow .25s ease;

            overflow-wrap: anywhere;
        }


        .btn-dark {
            background: #111827;
        }


        .btn:hover {
            transform: translateY(-3px);

            box-shadow:
                0 5px 15px rgba(239, 68, 68, .30);
        }


        .btn-dark:hover {
            box-shadow:
                0 5px 15px rgba(17, 24, 39, .30);
        }


        /* =====================================================
           EMPTY ORDERS
        ===================================================== */

        .empty {
            width: 100%;

            background: #fff;

            padding:
                55px 20px;

            border-radius: 15px;

            font-size: 23px;

            font-weight: 600;

            line-height: 1.5;

            text-align: center;

            color: #64748b;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, .06);

            margin-top: 20px;

            overflow-wrap: anywhere;
        }


        /* =====================================================
           LARGE TABLET
        ===================================================== */

        @media (max-width: 1100px) {

            .orders {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));

                gap: 20px;
            }


            .container,
            .back-wrapper {
                width: 94%;
            }


            .card {
                padding: 22px;
            }

        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 768px) {

            body {
                padding-bottom: 60px;
            }


            .orders-page {
                padding-bottom: 20px;
            }


            .back-wrapper {
                width:
                    calc(100% - 24px);

                margin:
                    15px auto 8px;
            }


            .back-btn {
                width: 100%;

                min-height: 43px;

                padding:
                    10px 15px;

                font-size: 13px;
            }


            .back-btn:hover {
                transform: none;

                box-shadow: none;
            }


            .container {
                width:
                    calc(100% - 24px);

                margin:
                    15px auto 30px;
            }


            .title {
                font-size: 32px;

                margin-bottom: 20px;
            }


            .pending-box {
                width: 100%;

                padding:
                    12px 15px;

                font-size: 16px;

                margin-bottom: 25px;

                border-radius: 10px;
            }


            .orders {
                grid-template-columns: 1fr;

                gap: 17px;
            }


            .card {
                padding: 20px;

                border-radius: 13px;
            }


            .card:hover {
                transform: none;

                box-shadow:
                    0 8px 20px rgba(0, 0, 0, .06);
            }


            .status {
                font-size: 12px;

                padding:
                    6px 12px;

                margin-bottom: 12px;
            }


            .total {
                font-size: 24px;

                margin-bottom: 10px;
            }


            .date {
                font-size: 13px;

                margin-bottom: 20px;
            }


            .action-buttons {
                flex-direction: column;

                gap: 9px;
            }


            .btn {
                width: 100%;

                flex: none;

                min-height: 44px;

                padding:
                    10px 12px;

                font-size: 13px;
            }


            .btn:hover,
            .btn-dark:hover {
                transform: none;

                box-shadow: none;
            }


            .empty {
                font-size: 20px;

                padding:
                    35px 15px;

                border-radius: 12px;
            }

        }


        /* =====================================================
           SMALL MOBILE
        ===================================================== */

        @media (max-width: 480px) {

            .back-wrapper {
                width:
                    calc(100% - 18px);

                margin:
                    12px auto 7px;
            }


            .container {
                width:
                    calc(100% - 18px);

                margin:
                    12px auto 25px;
            }


            .title {
                font-size: 27px;

                margin-bottom: 17px;
            }


            .pending-box {
                padding:
                    11px 10px;

                font-size: 14px;

                margin-bottom: 18px;
            }


            .orders {
                gap: 13px;
            }


            .card {
                padding: 16px;

                border-radius: 11px;
            }


            .status {
                font-size: 11px;

                padding:
                    5px 10px;

                margin-bottom: 10px;
            }


            .total {
                font-size: 21px;

                margin-bottom: 8px;
            }


            .date {
                font-size: 12px;

                line-height: 1.55;

                margin-bottom: 17px;
            }


            .action-buttons {
                gap: 8px;
            }


            .btn {
                min-height: 42px;

                padding:
                    9px 10px;

                font-size: 12px;

                border-radius: 7px;
            }


            .empty {
                font-size: 18px;

                padding:
                    30px 12px;
            }

        }


        /* =====================================================
           VERY SMALL PHONES
        ===================================================== */

        @media (max-width: 330px) {

            .back-wrapper {
                width:
                    calc(100% - 14px);
            }


            .container {
                width:
                    calc(100% - 14px);
            }


            .back-btn {
                min-height: 40px;

                font-size: 12px;

                padding:
                    9px 10px;
            }


            .title {
                font-size: 23px;

                margin-bottom: 15px;
            }


            .pending-box {
                font-size: 12px;

                padding:
                    10px 8px;

                margin-bottom: 15px;
            }


            .orders {
                gap: 10px;
            }


            .card {
                padding: 12px;

                border-radius: 9px;
            }


            .status {
                font-size: 10px;

                padding:
                    5px 8px;
            }


            .total {
                font-size: 18px;
            }


            .date {
                font-size: 11px;

                margin-bottom: 14px;
            }


            .action-buttons {
                gap: 7px;
            }


            .btn {
                min-height: 39px;

                font-size: 11px;

                padding:
                    8px 8px;

                border-radius: 6px;
            }


            .empty {
                font-size: 16px;

                padding:
                    25px 8px;
            }

        }


        /* =====================================================
           TOUCH DEVICES
        ===================================================== */

        @media (hover: none) {

            .card:hover {
                transform: none;
            }


            .back-btn:hover,
            .btn:hover,
            .btn-dark:hover {
                transform: none;

                box-shadow: none;
            }

        }
    </style>

</head>


<body>


    <!-- =====================================================
         NAVBAR
    ===================================================== -->

    <%- include("../../partials/user/navbar") %>


        <main class="orders-page">


            <!-- =================================================
             BACK BUTTON
        ================================================= -->

            <div class="back-wrapper">

                <a href="/product" class="back-btn">

                    ← Back To Products

                </a>

            </div>


            <!-- =================================================
             MAIN CONTAINER
        ================================================= -->

            <div class="container">


                <h1 class="title">
                    My Orders
                </h1>


                <!-- =================================================
                 PENDING ORDERS
            ================================================= -->

                <div class="pending-box">

                    Pending Orders :
                    <%= orders.filter(order=> order.status === "Pending").length %>

                </div>


                <% if(orders.length> 0){ %>


                    <!-- =============================================
                     ORDERS
                ============================================== -->

                    <div class="orders">


                        <% orders.forEach(order=> { %>


                            <div class="card">


                                <!-- STATUS -->

                                <div class="status <%= order.status.toLowerCase() %>">

                                    <%= order.status %>

                                </div>


                                <!-- TOTAL -->

                                <div class="total">

                                    ₹ <%= order.total %>

                                </div>


                                <!-- DATE -->

                                <div class="date">

                                    Ordered On:<br>

                                    <strong>

                                        <%= new Date(order.createdAt).toDateString() %>

                                    </strong>

                                </div>


                                <!-- ACTIONS -->

                                <div class="action-buttons">


                                    <a href="/order/view/<%= order._id %>" class="btn">

                                        View Order

                                    </a>


                                    <a href="/address" class="btn btn-dark">

                                        View Address

                                    </a>


                                </div>


                            </div>


                            <% }) %>


                    </div>


                    <% } else { %>


                        <!-- =============================================
                     EMPTY ORDERS
                ============================================== -->

                        <div class="empty">

                            No Orders Found

                        </div>


                        <% } %>


            </div>


        </main>


        <!-- =====================================================
         FOOTER
    ===================================================== -->

        <%- include("../../partials/user/footer") %>


</body>

</html>