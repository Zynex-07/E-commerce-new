<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Shoe Factory</title>

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #f8fafc;
            color: #0f172a;
            font-family: Inter, Arial, sans-serif;
            overflow-x: hidden;
        }

        .main-content {
            margin-left: 260px;
            padding: 96px 30px 30px;
            min-height: 100vh;
        }

        .page-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 25px;
        }

        .page-head h1 { font-size: 31px; margin-bottom: 6px; }
        .page-head p { color: #64748b; font-size: 14px; }

        .logout {
            text-decoration: none;
            border: 1px solid #fecaca;
            color: #b91c1c;
            background: #fff;
            padding: 10px 15px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 17px;
            margin-bottom: 25px;
        }

        .stat {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            padding: 21px;
            box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
        }

        .stat-label {
            color: #64748b;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .stat-value { font-size: 30px; font-weight: 800; }
        .stat small { display: block; margin-top: 7px; color: #94a3b8; }

        .quick {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            padding: 21px;
            margin-bottom: 25px;
        }

        .section-title { font-size: 18px; margin-bottom: 15px; }

        .quick-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 11px;
        }

        .quick a {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 48px;
            border-radius: 10px;
            background: #eff6ff;
            color: #1d4ed8;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
            border: 1px solid #dbeafe;
        }

        .quick a:hover { background: #dbeafe; }

        .grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 25px;
        }

        .panel {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            padding: 21px;
            overflow: hidden;
        }

        .panel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 15px;
        }

        .panel-head a {
            color: #2563eb;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
        }

        .table-wrap { overflow-x: auto; }

        table { width: 100%; border-collapse: collapse; min-width: 680px; }

        th, td {
            text-align: left;
            padding: 13px 10px;
            border-bottom: 1px solid #eef2f7;
            font-size: 13px;
        }

        th {
            color: #64748b;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .status {
            display: inline-flex;
            padding: 5px 9px;
            border-radius: 999px;
            background: #f1f5f9;
            font-weight: 700;
            font-size: 11px;
        }

        .empty { padding: 25px 5px; color: #64748b; text-align: center; }

        @media (max-width: 1100px) {
            .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .quick-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }

        @media (max-width: 900px) {
            .main-content {
                margin-left: 0;
                padding: 90px 20px 25px;
            }
        }

        @media (max-width: 600px) {
            .main-content { padding: 82px 14px 20px; }
            .page-head { flex-direction: column; }
            .page-head h1 { font-size: 25px; }
            .stats { grid-template-columns: 1fr 1fr; gap: 10px; }
            .stat { padding: 16px; }
            .stat-value { font-size: 24px; }
            .quick-grid { grid-template-columns: 1fr 1fr; }
        }

        @media (max-width: 390px) {
            .stats, .quick-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>

    <%- include("../../partials/admin/navbar") %>
    <%- include("../../partials/admin/sidebar") %>

    <main class="main-content">
        <div class="page-head">
            <div>
                <h1>Dashboard</h1>
                <p>Manage your entire store from one admin control center.</p>
            </div>
            <a class="logout" href="/admin/logout">Logout</a>
        </div>

        <section class="stats">
            <div class="stat">
                <div class="stat-label">Total Orders</div>
                <div class="stat-value"><%= totalOrders %></div>
                <small><%= pendingOrders %> pending</small>
            </div>

            <div class="stat">
                <div class="stat-label">Products</div>
                <div class="stat-value"><%= totalProducts %></div>
                <small><%= lowStockProducts %> low stock</small>
            </div>

            <div class="stat">
                <div class="stat-label">Customers</div>
                <div class="stat-value"><%= totalUsers %></div>
                <small>Registered users</small>
            </div>

            <div class="stat">
                <div class="stat-label">Revenue</div>
                <div class="stat-value">₹<%= Number(totalRevenue).toLocaleString("en-IN") %></div>
                <small>Delivered orders</small>
            </div>
        </section>

        <section class="quick">
            <h2 class="section-title">Quick Management</h2>

            <div class="quick-grid">
                <a href="/admin/product">📦 Products</a>
                <a href="/admin/product/add">＋ Add Product</a>
                <a href="/admin/category">🗂 Categories</a>
                <a href="/admin/order">🛒 Orders</a>
                <a href="/admin/user">👥 Users</a>
            </div>
        </section>

        <section class="grid">
            <div class="panel">
                <div class="panel-head">
                    <h2 class="section-title">Recent Orders</h2>
                    <a href="/admin/order">View all orders →</a>
                </div>

                <% if (!recentOrders.length) { %>
                    <div class="empty">No orders found.</div>
                <% } else { %>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Customer</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentOrders.forEach(order => { %>
                                    <tr>
                                        <td>#<%= String(order._id).slice(-6).toUpperCase() %></td>
                                        <td><%= order.userName || order.name || order.email || "Customer" %></td>
                                        <td>₹<%= Number(order.total || 0).toLocaleString("en-IN") %></td>
                                        <td><span class="status"><%= order.status || "Pending" %></span></td>
                                        <td><a href="/admin/order/view/<%= order._id %>">View / Update</a></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

</body>
</html>
