<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category Product</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #edf2f7, #dbeafe);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* =========================
           MAIN CONTENT
        ========================= */

        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            width: 100%;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        }

        .logo {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        .logo img {
            width: 145px;
            height: 60px;
            max-width: 100%;
            object-fit: contain;
            cursor: pointer;
            transition: 0.3s;
        }

        .logo img:hover {
            transform: scale(1.05);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(90deg, #f59e0b, #ef4444);
            color: white;
            text-decoration: none;
            padding: 12px 22px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            transition: 0.3s;
            box-shadow: 0 5px 15px rgba(239, 68, 68, 0.3);
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.5);
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            width: 100%;
            min-height: 280px;
            padding: 30px 20px;
            background:
                linear-gradient(rgba(0, 0, 0, 0.6),
                    rgba(0, 0, 0, 0.6)),
                url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=1600');

            background-size: cover;
            background-position: center;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .hero h1 {
            color: white;
            font-size: clamp(28px, 5vw, 56px);
            line-height: 1.2;
            letter-spacing: 2px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        /* =========================
           CONTAINER
        ========================= */

        .container {
            width: 92%;
            max-width: 1250px;
            margin: 45px auto;
        }

        /* =========================
           TOP BAR
        ========================= */

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .top-bar h2 {
            font-size: clamp(24px, 3vw, 38px);
            color: #111827;
            font-weight: 700;
        }

        /* =========================
           PRODUCTS
        ========================= */

        .product {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 25px;
            align-items: stretch;
        }

        /* =========================
           CARD
        ========================= */

        .card {
            width: 100%;
            min-width: 0;
            background: white;
            border-radius: 18px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.18);
        }

        /* =========================
           IMAGE
        ========================= */

        .card img {
            width: 100%;
            height: 240px;
            display: block;
            object-fit: cover;
            background: #f1f5f9;
        }

        /* =========================
           CONTENT
        ========================= */

        .content {
            padding: 18px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .content h2 {
            color: #111827;
            font-size: 21px;
            line-height: 1.4;
            margin-bottom: 12px;
            overflow-wrap: anywhere;
        }

        /* =========================
           PRICE
        ========================= */

        .price {
            color: #16a34a;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        /* =========================
           STOCK
        ========================= */

        .stock {
            color: #2563eb;
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 14px;
        }

        /* =========================
           DESCRIPTION
        ========================= */

        .desc {
            color: #4b5563;
            line-height: 1.7;
            font-size: 14px;
            margin-bottom: 20px;
            overflow-wrap: anywhere;
        }

        /* =========================
           ACTIONS
        ========================= */

        .actions {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-top: auto;
        }

        .edit,
        .delete {
            flex: 1;
            min-width: 0;
            color: white;
            text-align: center;
            padding: 11px 8px;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            transition: 0.3s;
        }

        /* =========================
           EDIT BUTTON
        ========================= */

        .edit {
            background: linear-gradient(90deg, #f59e0b, #f97316);
        }

        .edit:hover {
            transform: translateY(-3px);
        }

        /* =========================
           DELETE BUTTON
        ========================= */

        .delete {
            background: linear-gradient(90deg, #dc2626, #ef4444);
        }

        .delete:hover {
            transform: translateY(-3px);
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            margin-top: 70px;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            color: white;
            text-align: center;
            padding: 25px 15px;
            font-size: 15px;
            letter-spacing: 1px;
            line-height: 1.6;
            box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.15);
        }

        /* =========================
           RESPONSIVE - LAPTOP
        ========================= */

        @media (max-width: 1200px) {
            .product {
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 22px;
            }

            .card img {
                height: 230px;
            }
        }

        /* =========================
           RESPONSIVE - TABLET
        ========================= */

        @media (max-width: 1024px) {
            .main-content {
                margin-left: 220px;
                width: calc(100% - 220px);
            }

            .navbar {
                padding: 14px 4%;
            }

            .product {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 20px;
            }

            .hero {
                min-height: 240px;
            }

            .card img {
                height: 250px;
            }
        }

        /* =========================
           RESPONSIVE - MOBILE
        ========================= */

        @media (max-width: 768px) {
            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .navbar {
                padding: 12px 18px;
            }

            .logo img {
                width: 120px;
                height: 50px;
            }

            .btn {
                padding: 10px 14px;
                font-size: 12px;
            }

            .hero {
                min-height: 210px;
                padding: 25px 15px;
            }

            .hero h1 {
                font-size: clamp(25px, 7vw, 40px);
                letter-spacing: 1px;
            }

            .container {
                width: 92%;
                margin: 35px auto;
            }

            .top-bar {
                margin-bottom: 25px;
            }

            .product {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 16px;
            }

            .card {
                border-radius: 14px;
            }

            .card img {
                height: 210px;
            }

            .content {
                padding: 14px;
            }

            .content h2 {
                font-size: 18px;
            }

            .price {
                font-size: 19px;
            }

            .stock {
                font-size: 14px;
            }

            .desc {
                font-size: 13px;
                line-height: 1.5;
            }

            .actions {
                flex-direction: column;
                gap: 8px;
            }

            .edit,
            .delete {
                width: 100%;
                padding: 10px;
            }

            footer {
                margin-top: 45px;
                font-size: 13px;
            }
        }

        /* =========================
           RESPONSIVE - SMALL MOBILE
        ========================= */

        @media (max-width: 480px) {
            .navbar {
                padding: 10px 12px;
                gap: 10px;
            }

            .logo img {
                width: 100px;
                height: 45px;
            }

            .btn {
                padding: 9px 10px;
                font-size: 11px;
                border-radius: 8px;
            }

            .hero {
                min-height: 180px;
            }

            .container {
                width: 94%;
                margin: 28px auto;
            }

            .product {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .card img {
                height: 250px;
            }

            .content h2 {
                font-size: 20px;
            }

            .price {
                font-size: 22px;
            }

            .desc {
                font-size: 14px;
            }

            .actions {
                flex-direction: row;
            }

            .edit,
            .delete {
                font-size: 14px;
            }
        }

        /* =========================
           VERY SMALL MOBILE
        ========================= */

        @media (max-width: 360px) {
            .navbar {
                align-items: center;
            }

            .logo img {
                width: 90px;
            }

            .btn {
                padding: 8px;
                font-size: 10px;
            }

            .hero h1 {
                font-size: 24px;
            }

            .card img {
                height: 220px;
            }

            .actions {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <%- include("../../partials/admin/navbar") %>
        <%- include("../../partials/admin/sidebar") %>

            <div class="main-content">

                <div class="navbar">
                    <div class="logo">
                        <img src="/images/logo.png" alt="Logo">
                    </div>

                    <a href="/admin/product/add" class="btn">
                        + ADD PRODUCT
                    </a>
                </div>

                <div class="hero">
                    <h1>
                        <%= category.name %> PRODUCTS
                    </h1>
                </div>

                <div class="container">

                    <div class="top-bar">
                        <h2>All Products</h2>
                    </div>

                    <div class="product">

                        <% product.forEach(function(product) { %>

                            <div class="card">

                                <img src="<%= product.images %>" alt="<%= product.name %>">

                                <div class="content">

                                    <h2>
                                        <%= product.name %>
                                    </h2>

                                    <div class="price">
                                        ₹ <%= product.price %>
                                    </div>

                                    <div class="desc">
                                        <%= product.description %>
                                    </div>

                                    <div class="stock">
                                        Stock: <%= product.stock %>
                                    </div>

                                    <div class="actions">

                                        <a href="/admin/product/edit/<%= product._id %>" class="edit">
                                            Edit
                                        </a>

                                        <a href="/admin/product/delete/<%= product._id %>" class="delete">
                                            Delete
                                        </a>

                                    </div>

                                </div>
                            </div>

                            <% }) %>

                    </div>
                </div>
            </div>

            <%- include("../../partials/admin/footer") %>

</body>

</html>