<aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
        <h2>Store Admin</h2>
        <p>Management Center</p>
    </div>

    <ul>
        <li><a href="/admin/dashboard"><i class="fa-solid fa-gauge-high"></i><span>Dashboard</span></a></li>
        <li><a href="/admin/product"><i class="fa-solid fa-box"></i><span>Products</span></a></li>
        <li><a href="/admin/category"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a></li>
        <li><a href="/admin/order"><i class="fa-solid fa-cart-shopping"></i><span>Orders</span></a></li>
        <li><a href="/admin/user"><i class="fa-solid fa-users"></i><span>Users</span></a></li>
        <li class="logout-item"><a href="/admin/logout"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></a></li>
    </ul>
</aside>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<style>
    .sidebar {
        position: fixed;
        top: 70px;
        left: 0;
        width: 260px;
        height: calc(100vh - 70px);
        background: #0f172a;
        overflow-y: auto;
        z-index: 999;
        transition: left .25s ease;
    }

    .sidebar-logo {
        padding: 25px 22px 18px;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .sidebar-logo h2 { color: #fff; font-size: 21px; margin-bottom: 4px; }
    .sidebar-logo p { color: #94a3b8; font-size: 12px; }

    .sidebar ul { list-style: none; padding: 16px 12px; }
    .sidebar li { margin-bottom: 6px; }

    .sidebar a {
        display: flex;
        align-items: center;
        gap: 13px;
        min-height: 47px;
        padding: 11px 14px;
        border-radius: 10px;
        color: #cbd5e1;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: .2s;
    }

    .sidebar a i { width: 21px; text-align: center; }
    .sidebar a:hover, .sidebar a.active { background: #2563eb; color: #fff; }
    .logout-item { margin-top: 18px !important; border-top: 1px solid rgba(255,255,255,.08); padding-top: 14px; }
    .logout-item a:hover { background: #dc2626; }

    .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.45);
        z-index: 998;
    }

    @media (max-width: 900px) {
        .sidebar { top: 68px; height: calc(100vh - 68px); left: -270px; box-shadow: 8px 0 25px rgba(0,0,0,.2); }
        .sidebar.active { left: 0; }
        .sidebar-overlay.active { display: block; }
    }

    @media (max-width: 600px) {
        .sidebar { top: 65px; height: calc(100vh - 65px); width: min(280px,82vw); left: calc(-1 * min(280px,82vw)); }
        .sidebar.active { left: 0; }
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const menuBtn = document.getElementById("menuBtn");
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("sidebarOverlay");

    const closeMenu = () => {
        sidebar?.classList.remove("active");
        overlay?.classList.remove("active");
        menuBtn?.setAttribute("aria-expanded", "false");
    };

    menuBtn?.addEventListener("click", () => {
        const open = sidebar?.classList.toggle("active");
        overlay?.classList.toggle("active", !!open);
        menuBtn?.setAttribute("aria-expanded", open ? "true" : "false");
    });

    overlay?.addEventListener("click", closeMenu);

    sidebar?.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
            if (window.innerWidth <= 900) closeMenu();
        });
    });

    const currentPath = window.location.pathname;
    sidebar?.querySelectorAll("a").forEach(link => {
        if (link.getAttribute("href") !== "/admin/logout" &&
            currentPath.startsWith(link.getAttribute("href"))) {
            link.classList.add("active");
        }
    });
});
</script>
