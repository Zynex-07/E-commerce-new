<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Signup</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;

            background:
                linear-gradient(135deg,
                    #edf2f7,
                    #dbeafe);

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 24px;
        }

        /* ==========================
           SIGNUP CONTAINER
        ========================== */

        .container {
            width: 100%;
            max-width: 450px;

            background: #ffffff;

            padding: 40px;

            border-radius: 20px;

            box-shadow:
                0 15px 35px rgba(0, 0, 0, 0.12);

            animation: fadeIn 0.8s ease;
        }

        /* ==========================
           HEADING
        ========================== */

        .container h1 {
            text-align: center;

            margin-bottom: 30px;

            color: #111827;

            font-size: clamp(28px, 5vw, 38px);

            font-weight: 700;

            line-height: 1.2;
        }

        /* ==========================
           FORM
        ========================== */

        form {
            width: 100%;
        }

        /* ==========================
           INPUT
        ========================== */

        input {
            display: block;

            width: 100%;

            min-width: 0;

            padding: 14px;

            margin-bottom: 18px;

            border: 1px solid #d1d5db;

            border-radius: 10px;

            outline: none;

            background: #f9fafb;

            color: #111827;

            font-size: 15px;

            transition: 0.3s;
        }

        input::placeholder {
            color: #9ca3af;
        }

        input:focus {
            border-color: #f59e0b;

            background: #ffffff;

            box-shadow:
                0 0 8px rgba(245, 158, 11, 0.35);
        }

        /* ==========================
           BUTTON
        ========================== */

        button {
            display: block;

            width: 100%;

            min-height: 48px;

            padding: 14px;

            border: none;

            border-radius: 10px;

            background:
                linear-gradient(90deg,
                    #f59e0b,
                    #ef4444);

            color: white;

            font-size: 16px;

            font-weight: 600;

            cursor: pointer;

            transition: 0.3s;

            box-shadow:
                0 5px 15px rgba(239, 68, 68, 0.3);
        }

        button:hover {
            transform: translateY(-3px);

            box-shadow:
                0 10px 20px rgba(239, 68, 68, 0.5);
        }

        button:active {
            transform: translateY(0);
        }

        /* ==========================
           LINK
        ========================== */

        .link {
            text-align: center;

            margin-top: 20px;

            font-size: 15px;

            line-height: 1.6;

            color: #4b5563;

            word-wrap: break-word;
        }

        .link a {
            color: #ef4444;

            text-decoration: none;

            font-weight: 600;

            margin-left: 4px;
        }

        .link a:hover {
            text-decoration: underline;
        }

        /* ==========================
           TABLET
        ========================== */

        @media (max-width: 768px) {

            body {
                padding: 20px;
            }

            .container {
                max-width: 450px;

                padding: 35px 30px;

                border-radius: 18px;
            }

            .container h1 {
                margin-bottom: 25px;
            }
        }

        /* ==========================
           MOBILE
        ========================== */

        @media (max-width: 480px) {

            body {
                padding: 16px;
            }

            .container {
                width: 100%;

                padding: 30px 22px;

                border-radius: 16px;
            }

            .container h1 {
                font-size: 30px;

                margin-bottom: 24px;
            }

            input {
                padding: 13px;

                margin-bottom: 15px;

                font-size: 14px;

                border-radius: 9px;
            }

            .link {
                font-size: 14px;

                margin-top: 18px;
            }

            button {
                min-height: 46px;

                padding: 13px;

                font-size: 15px;

                border-radius: 9px;
            }

            button:hover {
                transform: none;
            }
        }

        /* ==========================
           SMALL MOBILE
        ========================== */

        @media (max-width: 360px) {

            body {
                padding: 12px;
            }

            .container {
                padding: 25px 18px;

                border-radius: 14px;
            }

            .container h1 {
                font-size: 27px;

                margin-bottom: 21px;
            }

            input {
                padding: 12px;

                font-size: 14px;
            }

            .link {
                font-size: 13px;
            }

            button {
                font-size: 14px;
            }
        }

        /* ==========================
           VERY SHORT SCREEN
        ========================== */

        @media (max-height: 600px) {

            body {
                align-items: flex-start;

                padding-top: 20px;
                padding-bottom: 20px;
            }

            .container {
                margin: 0 auto;
            }
        }

        /* ==========================
           ANIMATION
        ========================== */

        @keyframes fadeIn {

            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ==========================
           REDUCE MOTION
        ========================== */

        @media (prefers-reduced-motion: reduce) {

            .container,
            button,
            input {
                animation: none;
                transition: none;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Signup</h1>
        <form action="/auth/signup" method="POST">
            <input type="text" name="name" placeholder="Name" autocomplete="name" required>
            <input type="email" name="email" placeholder="Email" autocomplete="email" required>
            <input type="password" name="password" placeholder="Password" autocomplete="new-password" required>
            <button type="submit">
                Signup
            </button>
        </form>

    </div>

</body>

</html>